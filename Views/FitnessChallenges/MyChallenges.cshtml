@model IEnumerable<DUT_Campus_FIT_Gym.Models.FitnessChallenge>

@{
    ViewData["Title"] = "My Fitness Challenges";
}

<div class="fitness-challenges-page">

    <div class="challenges-header">
        <div>
            <h1>My Fitness Challenges</h1>
            <p>View your challenges and track your progress.</p>
        </div>

        <a asp-controller="FitnessChallenges"
           asp-action="Create"
           class="create-challenge-btn">
            + Create New Challenge
        </a>
    </div>

    @if (TempData["ChallengeError"] != null)
    {
        <div class="challenge-alert error">
            @TempData["ChallengeError"]
        </div>
    }

    @if (TempData["ChallengeSuccess"] != null)
    {
        <div class="challenge-alert success">
            @TempData["ChallengeSuccess"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="no-challenges">
            <h3>No challenges yet</h3>
            <p>Create your first fitness challenge to get started.</p>

            <a asp-controller="FitnessChallenges"
               asp-action="Create"
               class="create-challenge-btn">
                Create Challenge
            </a>
        </div>
    }
    else
    {
        <div class="challenge-grid">

            @foreach (var challenge in Model)
            {
                <div class="challenge-card">

                    <!-- HEADER -->
                    <div class="challenge-card-header">

                        <div>
                            <h2>@challenge.Title</h2>

                            <p class="challenge-exercise">
                                @challenge.ExerciseType Challenge
                            </p>
                        </div>

                        <span class="challenge-status @challenge.Status.ToLower()">
                            @challenge.Status
                        </span>

                    </div>


                    <!-- CHALLENGE DETAILS -->
                    <div class="challenge-details">

                        <div class="detail-item">
                            <strong>Fitness Level</strong>
                            <span>@challenge.FitnessLevel</span>
                        </div>

                        <div class="detail-item">
                            <strong>Exercise</strong>
                            <span>@challenge.ExerciseType</span>
                        </div>

                        <div class="detail-item">
                            <strong>Duration</strong>
                            <span>@challenge.DurationDays days</span>
                        </div>

                        <div class="detail-item">
                            <strong>Created</strong>
                            <span>
                                @challenge.CreatedDate.ToString("dd MMM yyyy")
                            </span>
                        </div>

                    </div>


                    <hr />


                    <!-- DAILY TARGETS -->
                    <h3 class="daily-target-title">
                        Daily Targets
                    </h3>

                    @foreach (var day in challenge.Days.OrderBy(d => d.DayNumber))
                    {
                        <div class="challenge-day">

                            <div class="day-info">

                                <strong>
                                    Day @day.DayNumber
                                </strong>

                                <span>
                                    @day.Exercise
                                </span>

                            </div>

                            <div class="progress-info">

                                <span>
                                    @day.Completed / @day.Target
                                </span>

                                @if (day.IsCompleted)
                                {
                                    <span class="completed">✓ Completed</span>
                                }
                                else if (challenge.Status == "InProgress")
                                {
                                    <form asp-controller="FitnessChallenges"
                                          asp-action="UpdateProgress"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@day.FitnessChallengeDayId" />

                                        <input type="number"
                                               name="completed"
                                               min="0"
                                               max="@day.Target"
                                               value="@day.Completed" />

                                        <button type="submit"
                                                class="progress-btn">
                                            Update Progress
                                        </button>

                                    </form>

                                    <span class="in-progress">
                                        In Progress
                                    </span>
                                }
                                else
                                {
                                    <span class="in-progress">
                                        Not Started
                                    </span>
                                }

                            </div>

                        </div>
                    }


                    <!-- ACTIONS -->

                    <div class="challenge-actions">

                        @if (challenge.Status == "Generated")
                        {
                            <form asp-controller="FitnessChallenges"
                                  asp-action="AcceptChallenge"
                                  method="post"
                                  class="challenge-action-form">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@challenge.FitnessChallengeId" />

                                <button type="submit"
                                        class="accept-btn">
                                    Accept Challenge
                                </button>

                            </form>
                        }

                        @if (challenge.Status == "Accepted")
                        {
                            <form asp-controller="FitnessChallenges"
                                  asp-action="StartChallenge"
                                  method="post"
                                  class="challenge-action-form">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@challenge.FitnessChallengeId" />

                                <button type="submit"
                                        class="start-btn">
                                    ▶ Start Challenge
                                </button>

                            </form>
                        }

                        @if (challenge.Status == "InProgress")
                        {
                            <button type="button"
                                    class="progress-btn">
                                Update Progress
                            </button>
                        }

                        @if (challenge.Status == "Completed")
                        {
                            <span class="challenge-message completed-message">
                                ✓ Challenge Completed
                            </span>
                        }

                        @if (challenge.Status == "Cancelled")
                        {
                            <span class="challenge-message cancelled-message">
                                Challenge Cancelled
                            </span>
                        }

                        @if (challenge.Status == "Expired")
                        {
                            <span class="challenge-message expired-message">
                                Challenge Expired
                            </span>
                        }


                        <!-- DELETE BUTTON -->

                        <form asp-controller="FitnessChallenges"
                              asp-action="DeleteChallenge"
                              method="post"
                              class="delete-challenge-form"
                              onsubmit="return confirm('Are you sure you want to delete this challenge?');">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@challenge.FitnessChallengeId" />

                            <button type="submit"
                                    class="delete-btn">
                                🗑 Delete Challenge
                            </button>

                        </form>

                    </div>

                </div>
            }

        </div>
    }

</div>
