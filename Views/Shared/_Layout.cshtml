<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - DUT Campus FIT Gym</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    @if (ViewContext.RouteData.Values["controller"]?.ToString() != "Account")
    {
        <div class="app-layout">

            <aside class="sidebar">

                <div class="sidebar-brand">

                    <div class="brand-icon">
                        FIT
                    </div>

                    <div class="brand-text">
                        <h4>DUT FIT</h4>
                        <span>Campus Gym</span>
                    </div>

                </div>

                <nav class="sidebar-nav">

                    <div class="nav-title">
                        MAIN MENU
                    </div>

                    <!-- Dashboard -->
                    <a asp-controller="Member"
                       asp-action="Dashboard"
                       class="sidebar-link">

                        <span class="sidebar-icon">
                            <i class="bi bi-house-fill"></i>
                        </span>

                        <span>Dashboard</span>

                    </a>


                    <!-- Profile -->
                    <a asp-controller="Member"
                       asp-action="Profile"
                       class="sidebar-link">

                        <span class="sidebar-icon">
                            <i class="bi bi-person-fill"></i>
                        </span>

                        <span>Profile</span>

                    </a>


                    <!-- Membership -->
                    <a asp-controller="Member"
                       asp-action="Membership"
                       class="sidebar-link">

                        <span class="sidebar-icon">
                            <i class="bi bi-person-vcard-fill"></i>
                        </span>

                        <span>Membership</span>

                    </a>


                    <!-- Attendance -->
                    <a asp-controller="Member"
                       asp-action="Attendance"
                       class="sidebar-link">

                        <span class="sidebar-icon">
                            <i class="bi bi-calendar-check-fill"></i>
                        </span>

                        <span>Attendance</span>

                    </a>


                    <!-- Equipment -->
                    <a asp-controller="Member"
                       asp-action="Equipment"
                       class="sidebar-link">

                        <span class="sidebar-icon">
                            <i class="bi bi-universal-access"></i>
                        </span>

                        <span>Equipment</span>

                    </a>


                    <!-- Reservations -->
                    <a asp-controller="Member"
                       asp-action="Reservations"
                       class="sidebar-link">

                        <span class="sidebar-icon">
                            <i class="bi bi-calendar-fill"></i>
                        </span>

                        <span>Reservations</span>

                    </a>


                    <!-- Workout Plan -->
                    <a asp-controller="Member"
                       asp-action="WorkoutPlan"
                       class="sidebar-link">

                        <span class="sidebar-icon">
                            <i class="bi bi-person-running"></i>
                        </span>

                        <span>Workout Plan</span>

                    </a>


                    <!-- Payments -->
                    <a href="#"
                       class="sidebar-link">

                        <span class="sidebar-icon">
                            <i class="bi bi-credit-card-fill"></i>
                        </span>

                        <span>Payments</span>

                    </a>


                    <!-- Announcements -->
                    <a href="#"
                       class="sidebar-link">

                        <span class="sidebar-icon">
                            <i class="bi bi-megaphone-fill"></i>
                        </span>

                        <span>Announcements</span>

                    </a>


                    <!-- Support -->
                    <a href="#"
                       class="sidebar-link">

                        <span class="sidebar-icon">
                            <i class="bi bi-question-circle-fill"></i>
                        </span>

                        <span>Support</span>

                    </a>

                </nav>


                <!-- Logout -->
                <div class="sidebar-bottom">

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="sidebar-link logout-link"
                                style="border: none; background: none; width: 100%; text-align: left;">

                            <span class="sidebar-icon">
                                <i class="bi bi-box-arrow-right"></i>
                            </span>

                            <span>Logout</span>

                        </button>

                    </form>

                </div>

            </aside>


            <main class="main-content">

                @RenderBody()

            </main>

        </div>
    }
    else
    {
        @RenderBody()
    }


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>