<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - DUT Campus FIT Gym</title>


    <!-- =========================================
         BOOTSTRAP
         ========================================= -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- =========================================
         SITE CSS
         ========================================= -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />


    <!-- =========================================
         MEMBER CREATE CSS
         ========================================= -->

    <link rel="stylesheet"
          href="~/css/Member-Create.css"
          asp-append-version="true" />


    <!-- =========================================
         WORKOUT CSS
         ========================================= -->

    <link rel="stylesheet"
          href="~/css/Workout.css"
          asp-append-version="true" />


    <!-- =========================================
         MEMBERSHIP CSS
         ========================================= -->

    <link rel="stylesheet"
          href="~/css/membership.css"
          asp-append-version="true" />


    <!-- =========================================
         GOOGLE FONT
         ========================================= -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet" />


    <!-- =========================================
         FAVICON
         ========================================= -->

    <link rel="icon"
          type="image/png"
          href="~/images/DUT_Campus_FIT_Gym_Emblem.png" />


    <!-- =========================================
         BOOTSTRAP ICONS
         ========================================= -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- =========================================
         FONT AWESOME
         ========================================= -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />


    <!-- =========================================
         PAGE-SPECIFIC STYLES
         ========================================= -->
    @await RenderSectionAsync("Styles", required: false)

</head>


<body>

    @{
        var controller =
        ViewContext.RouteData.Values["controller"]?.ToString();

        var action =
        ViewContext.RouteData.Values["action"]?.ToString();


        bool isAccountPage =
        controller == "Account";


        bool isAuthenticated =
        User.Identity?.IsAuthenticated == true;


        bool isStudent =
        isAuthenticated &&
        User.IsInRole("Student");


        bool isStaff =
        isAuthenticated &&
        User.IsInRole("Staff");


        bool isTrainer =
        isAuthenticated &&
        User.IsInRole("Trainer");


        bool isAdmin =
        isAuthenticated &&
        User.IsInRole("Admin");


        bool showStudentSidebar =
        isStudent && !isAccountPage;
    }


    <!-- =====================================================
         STUDENT LAYOUT
         ===================================================== -->
    @if (showStudentSidebar)
    {
        <div class="app-layout">

            <!-- =========================================
                 STUDENT SIDEBAR
                 ========================================= -->

            <aside class="sidebar"
                   id="studentSidebar">


                <!-- =====================================
                     SIDEBAR BRAND
                     ===================================== -->

                <div class="sidebar-brand">

                    <img src="~/images/DUT-logo.jpg"
                         alt="DUT Logo"
                         class="gym-logo" />


                    <div class="brand-text">

                        <h4>
                            DUT Campus
                            <span>FIT Gym</span>
                        </h4>

                    </div>


                    <!-- SIDEBAR TOGGLE -->

                    <button type="button"
                            class="sidebar-toggle"
                            id="sidebarToggle"
                            aria-label="Toggle sidebar"
                            title="Collapse sidebar">

                        <i class="fa-solid fa-bars"></i>

                    </button>

                </div>


                <!-- =====================================
                     NAVIGATION
                     ===================================== -->

                <nav class="sidebar-nav">

                    <div class="nav-title">
                        MAIN MENU
                    </div>


                    <!-- DASHBOARD -->

                    <a asp-controller="Member"
                       asp-action="Dashboard"
                       class="sidebar-link @(controller == "Member" && action == "Dashboard" ? "active" : "")">

                        <span class="sidebar-icon">
                            <i class="bi bi-house-fill"></i>
                        </span>

                        <span>
                            Dashboard
                        </span>

                    </a>


                    <!-- PROFILE -->

                    <a asp-controller="Member"
                       asp-action="Profile"
                       class="sidebar-link @(controller == "Member" && action == "Profile" ? "active" : "")">

                        <span class="sidebar-icon">
                            <i class="bi bi-person-fill"></i>
                        </span>

                        <span>
                            Profile
                        </span>

                    </a>


                    <!-- CREATE MEMBERSHIP -->

                    <a asp-controller="Member"
                       asp-action="Create"
                       class="sidebar-link @(controller == "Member" && action == "Create" ? "active" : "")">

                        <span class="sidebar-icon">
                            <i class="fa-solid fa-plus-circle"></i>
                        </span>

                        <span>
                            Create Membership
                        </span>

                    </a>


                    <!-- MEMBERSHIP -->

                    <a asp-controller="Member"
                       asp-action="Membership"
                       class="sidebar-link @(controller == "Member" && action == "Membership" ? "active" : "")">

                        <span class="sidebar-icon">
                            <i class="bi bi-person-vcard-fill"></i>
                        </span>

                        <span>
                            Membership
                        </span>

                    </a>


                    <!-- VIRTUAL GYM CARD -->

                    <a asp-controller="Member"
                       asp-action="GymCard"
                       class="sidebar-link @(controller == "Member" && action == "GymCard" ? "active" : "")">

                        <span class="sidebar-icon">
                            <i class="bi bi-person-vcard"></i>
                        </span>

                        <span>
                            Virtual Gym Card
                        </span>

                    </a>


                    <!-- CHECK-IN -->

                    <a asp-controller="Member"
                       asp-action="CheckIn"
                       class="sidebar-link @(controller == "Member" && action == "CheckIn" ? "active" : "")">

                        <span class="sidebar-icon">
                            <i class="bi bi-qr-code-scan"></i>
                        </span>

                        <span>
                            Check-In
                        </span>

                    </a>


                    <!-- ATTENDANCE -->

                    <a asp-controller="Member"
                       asp-action="Attendance"
                       class="sidebar-link @(controller == "Member" && action == "Attendance" ? "active" : "")">

                        <span class="sidebar-icon">
                            <i class="bi bi-calendar-check-fill"></i>
                        </span>

                        <span>
                            Attendance
                        </span>

                    </a>


                    <!-- EQUIPMENT -->

                    <a asp-controller="Member"
                       asp-action="Equipment"
                       class="sidebar-link @(controller == "Member" && action == "Equipment" ? "active" : "")">

                        <span class="sidebar-icon">
                            <i class="bi bi-universal-access"></i>
                        </span>

                        <span>
                            Equipment
                        </span>

                    </a>


                    <!-- RESERVATIONS -->

                    <a asp-controller="Member"
                       asp-action="Reservations"
                       class="sidebar-link @(controller == "Member" && action == "Reservations" ? "active" : "")">

                        <span class="sidebar-icon">
                            <i class="bi bi-calendar-fill"></i>
                        </span>

                        <span>
                            Reservations
                        </span>

                    </a>


                    <!-- WORKOUT PLAN -->

                    <a asp-controller="Workout"
                       asp-action="MyWorkout"
                       class="sidebar-link @(controller == "Workout" ? "active" : "")">

                        <span class="sidebar-icon">
                            <i class="fa-solid fa-person-running"></i>
                        </span>

                        <span>
                            Workout Plan
                        </span>

                    </a>


                    <!-- WORKOUT PROFILE -->

                    <a asp-controller="WorkoutProfile"
                       asp-action="Index"
                       class="sidebar-link @(controller == "WorkoutProfile" ? "active" : "")">

                        <span class="sidebar-icon">
                            <i class="fa-solid fa-clipboard-user"></i>
                        </span>

                        <span>
                            Workout Profile
                        </span>

                    </a>


                    <!-- PAYMENTS -->

                    <a asp-controller="Member"
                       asp-action="Payment"
                       class="sidebar-link @(controller == "Banking" ? "active" : "")">

                        <span class="sidebar-icon">
                            <i class="bi bi-credit-card-fill"></i>
                        </span>

                        <span>
                            Payments
                        </span>

                    </a>


                    <!-- ANNOUNCEMENTS -->

                    <a asp-controller="Member"
                       asp-action="Announcements"
                       class="sidebar-link @(controller == "Member" && action == "Announcements" ? "active" : "")">

                        <span class="sidebar-icon">
                            <i class="bi bi-megaphone-fill"></i>
                        </span>

                        <span>
                            Announcements
                        </span>

                    </a>

                </nav>


                <!-- =========================================
                     STUDENT LOGOUT
                     ========================================= -->

                <div class="sidebar-bottom">

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="sidebar-link logout-link">

                            <span class="sidebar-icon">
                                <i class="bi bi-box-arrow-right"></i>
                            </span>

                            <span>
                                Logout
                            </span>

                        </button>

                    </form>

                </div>

            </aside>


            <!-- =========================================
                 STUDENT MAIN CONTENT
                 ========================================= -->

            <main class="main-content">

                @RenderBody()

            </main>

        </div>
    }


    <!-- =====================================================
         NON-STUDENT LAYOUT
         ===================================================== -->
    @if (!showStudentSidebar)
    {

        <!-- =========================================
             TOP BAR
             TRAINER / ADMIN / STAFF
             ========================================= -->
        @if (isAuthenticated && !isAccountPage)
        {
            <div class="role-topbar">

                <div class="role-topbar-left">

                    @if (isTrainer)
                    {
                        <span>
                            <i class="fa-solid fa-user-tie"></i>
                            Trainer
                        </span>
                    }

                    @if (isAdmin)
                    {
                        <span>
                            <i class="fa-solid fa-user-shield"></i>
                            Administrator
                        </span>
                    }

                    @if (isStaff)
                    {
                        <span>
                            <i class="fa-solid fa-user"></i>
                            Staff
                        </span>
                    }

                </div>


                <!-- =====================================
                     LOGOUT
                     ===================================== -->

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="role-logout-form">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="role-logout-button">

                        <i class="bi bi-box-arrow-right"></i>

                        <span>
                            Logout
                        </span>

                    </button>

                </form>

            </div>
        }


        <!-- =========================================
             NON-STUDENT PAGE CONTENT
             ========================================= -->

        <main class="non-student-content">

            @RenderBody()

        </main>

    }


    <!-- =============================================
         JAVASCRIPT
         ============================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>


    <!-- =============================================
         PAGE-SPECIFIC SCRIPTS
         ============================================= -->
    @await RenderSectionAsync("Scripts", required: false)


    <!-- =============================================
         SIDEBAR TOGGLE
         ============================================= -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const sidebar =
                document.getElementById("studentSidebar");

            const toggleButton =
                document.getElementById("sidebarToggle");


            if (!sidebar || !toggleButton) {
                return;
            }


            const collapsed =
                localStorage.getItem(
                    "fitGymSidebarCollapsed"
                ) === "true";


            if (collapsed) {

                document.body.classList.add(
                    "sidebar-collapsed"
                );

            }


            toggleButton.addEventListener(
                "click",
                function () {

                    document.body.classList.toggle(
                        "sidebar-collapsed"
                    );


                    const isCollapsed =
                        document.body.classList.contains(
                            "sidebar-collapsed"
                        );


                    localStorage.setItem(
                        "fitGymSidebarCollapsed",
                        isCollapsed
                    );

                }
            );

        });

    </script>


</body>

</html>