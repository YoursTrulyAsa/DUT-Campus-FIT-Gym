@model DUT_Campus_FIT_Gym.Models.WorkoutPlan

<h2>Delete Workout Plan</h2>

<div class="alert alert-warning">
    <strong>Are you sure you want to delete this workout?</strong>
    <p>This action cannot be undone.</p>
</div>

<div class="card">
    <div class="card-body">

        <h5 class="card-title">@Model.WorkoutName</h5>

        <p>
            <strong>Exercise:</strong>
            @Model.ExerciseName
        </p>

        <p>
            <strong>Day:</strong>
            @Model.WorkoutDay
        </p>

        <p>
            <strong>Sets:</strong>
            @Model.Sets
        </p>

        <p>
            <strong>Repetitions:</strong>
            @Model.Repetitions
        </p>

        <p>
            <strong>Rest Time:</strong>
            @Model.RestTime
        </p>

        <p>
            <strong>Description:</strong>
            @Model.Description
        </p>

        <form asp-action="Delete" method="post">

            <input type="hidden"
                   asp-for="WorkoutPlanId" />

            <button type="submit"
                    class="btn btn-danger">
                Yes, Delete
            </button>

            <a asp-action="MyWorkout"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>
