@model DUT_Campus_FIT_Gym.Models.WorkoutProfile

@{
    ViewData["Title"] = "Create Workout Profile";
}

<div class="container mt-4">

    <h1>Create Workout Profile</h1>

    <p>
        Enter your information so we can create your workout plan.
    </p>

    <form asp-controller="Workout"
          asp-action="CreateProfile"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="text-danger"></div>

        

        <div class="mb-3">
            <label asp-for="Age" class="form-label">
                Age
            </label>

            <input asp-for="Age"
                   class="form-control"
                   type="number" />

            <span asp-validation-for="Age"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="Weight" class="form-label">
                Weight (kg)
            </label>

            <input asp-for="Weight"
                   class="form-control"
                   type="number"
                   step="0.1" />

            <span asp-validation-for="Weight"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="Height" class="form-label">
                Height (cm)
            </label>

            <input asp-for="Height"
                   class="form-control"
                   type="number"
                   step="0.1" />

            <span asp-validation-for="Height"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="Goal" class="form-label">
                Workout Goal
            </label>

            <select asp-for="Goal"
                    class="form-select">

                <option value="">
                    Select your goal
                </option>

                <option value="Strength">
                    Strength
                </option>

                <option value="Fitness">
                    General Fitness
                </option>

                <option value="Weight Loss">
                    Weight Loss
                </option>

            </select>

            <span asp-validation-for="Goal"
                  class="text-danger">
            </span>
        </div>

        <button type="submit"
                class="btn btn-primary">
            Generate Workout Plan
        </button>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}