@model IEnumerable<DUT_Campus_FIT_Gym.Models.WorkoutPlan>

@{
    ViewData["Title"] = "My Workout Plan";
    var completedWorkouts = ViewBag.CompletedWorkouts as HashSet<string> ?? new HashSet<string>();
    var workouts = Model?.ToList() ?? new List<DUT_Campus_FIT_Gym.Models.WorkoutPlan>();

    var groupedWorkouts = workouts
        .GroupBy(w => new { w.WorkoutName, w.Level })
        .ToList();
}

<div class="workout-page">

    <div class="workout-header">

        <div>
            <span class="page-label">FITNESS</span>

            <h1>My Workout Plan</h1>

            <p>
                View and manage your personalized workout plans.
            </p>
        </div>

        <a asp-controller="Workout"
           asp-action="Create"
           class="workout-create-btn">

            <i class="fa-solid fa-plus"></i>

            Create Workout

        </a>

    </div>

    @if (TempData["WorkoutCompleted"] != null)
    {
        <div class="workout-success-message">

            <i class="fa-solid fa-circle-check"></i>

            <span>
                @TempData["WorkoutCompleted"]
            </span>

        </div>
    }

    @if (!workouts.Any())
    {
        <div class="workout-empty">

            <div class="empty-icon">
                <i class="fa-solid fa-person-running"></i>
            </div>

            <h2>No Workout Plan Yet</h2>

            <p>
                You currently don't have any workout plans.
                Create your first workout to get started.
            </p>

            <a asp-controller="Workout"
               asp-action="Create"
               class="workout-create-btn">

                <i class="fa-solid fa-plus"></i>

                Create Workout

            </a>

        </div>
    }
    else
    {
        <div class="workout-plan-list">

            @foreach (var workoutGroup in groupedWorkouts)
            {
                var level = workoutGroup.Key.Level;

                if (string.IsNullOrWhiteSpace(level))
                {
                    level = "Beginner";
                }

                if (level.Equals("Advanced", StringComparison.OrdinalIgnoreCase))
                {
                    level = "Pro";
                }

                var rewardPoints = level.ToLower() switch
                {
                    "beginner" => 3,
                    "intermediate" => 5,
                    "pro" => 7,
                    _ => 3
                };

                var isCompleted =
                    completedWorkouts.Contains(workoutGroup.Key.WorkoutName);

                var trainingDays = workoutGroup
                    .GroupBy(w => w.WorkoutDay)
                    .ToList();

                <div class="workout-plan-card">

                    <div class="workout-plan-top">

                        <div class="workout-plan-heading">

                            <div class="workout-plan-icon">
                                <i class="fa-solid fa-dumbbell"></i>
                            </div>

                            <div>

                                <span class="workout-plan-label">
                                    @level WORKOUT
                                </span>

                                <h2>
                                    @workoutGroup.Key.WorkoutName
                                </h2>

                                <p>
                                    @workoutGroup.Count()
                                    @(workoutGroup.Count() == 1 ? "exercise" : "exercises")
                                    across
                                    @trainingDays.Count
                                    @(trainingDays.Count == 1 ? "training day" : "training days")
                                </p>

                            </div>

                        </div>

                        <div class="workout-reward-badge">

                            <i class="fa-solid fa-star"></i>

                            <div>
                                <span>REWARD</span>
                                <strong>+@rewardPoints</strong>
                            </div>

                        </div>

                    </div>

                    <div class="workout-level-row">

                        <span class="workout-level-badge @level.ToLower()">
                            @level
                        </span>

                        <span class="workout-level-text">
                            Complete this workout to earn @rewardPoints reward points.
                        </span>

                    </div>

                    <div class="workout-days">

                        @foreach (var dayGroup in trainingDays)
                        {
                            <div class="workout-day-section">

                                <div class="workout-day-heading">

                                    <div class="workout-day-title">

                                        <div class="workout-day-icon">
                                            <i class="fa-solid fa-calendar-day"></i>
                                        </div>

                                        <div>
                                            <span>TRAINING DAY</span>

                                            <h3>
                                                @dayGroup.Key
                                            </h3>
                                        </div>

                                    </div>

                                    <span class="workout-exercise-count">
                                        @dayGroup.Count()
                                        @(dayGroup.Count() == 1 ? "Exercise" : "Exercises")
                                    </span>

                                </div>

                                <div class="workout-exercise-list">

                                    @foreach (var exercise in dayGroup)
                                    {
                                        <div class="workout-exercise-row">

                                            <div class="workout-exercise-icon">
                                                <i class="fa-solid fa-person-running"></i>
                                            </div>

                                            <div class="workout-exercise-content">

                                                <h4>
                                                    @exercise.ExerciseName
                                                </h4>

                                                @if (!string.IsNullOrWhiteSpace(exercise.Description))
                                                {
                                                    <p>
                                                        @exercise.Description
                                                    </p>
                                                }

                                            </div>

                                            <div class="workout-exercise-stats">

                                                <div>
                                                    <span>SETS</span>
                                                    <strong>
                                                        @exercise.Sets
                                                    </strong>
                                                </div>

                                                <div>
                                                    <span>REPS</span>
                                                    <strong>
                                                        @exercise.Repetitions
                                                    </strong>
                                                </div>

                                                <div>
                                                    <span>REST</span>
                                                    <strong>
                                                        @exercise.RestTime sec
                                                    </strong>
                                                </div>

                                            </div>

                                            <div class="workout-exercise-actions">

                                                <a asp-controller="Workout"
                                                   asp-action="Edit"
                                                   asp-route-id="@exercise.WorkoutPlanId"
                                                   class="workout-edit-btn">

                                                    <i class="fa-solid fa-pen"></i>

                                                </a>

                                                <a asp-controller="Workout"
                                                   asp-action="Delete"
                                                   asp-route-id="@exercise.WorkoutPlanId"
                                                   class="workout-delete-btn">

                                                    <i class="fa-solid fa-trash"></i>

                                                </a>

                                            </div>

                                        </div>
                                    }

                                </div>

                            </div>
                        }

                    </div>

                    @if (isCompleted)
                    {
                        <div class="workout-completed">

                            <div class="workout-completed-icon">
                                <i class="fa-solid fa-circle-check"></i>
                            </div>

                            <div>
                                <strong>
                                    Workout completed
                                </strong>

                                <span>
                                    You earned +@rewardPoints reward points today.
                                </span>
                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="workout-plan-footer">

                            <div class="workout-footer-info">

                                <i class="fa-solid fa-trophy"></i>

                                <div>
                                    <strong>
                                        Ready to complete this workout?
                                    </strong>

                                    <span>
                                        Earn +@rewardPoints reward points.
                                    </span>
                                </div>

                            </div>

                            <form asp-controller="Workout"
                                  asp-action="CompleteWorkout"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="workoutName"
                                       value="@workoutGroup.Key.WorkoutName" />

                                <button type="submit"
                                        class="workout-complete-btn">

                                    <i class="fa-solid fa-check"></i>

                                    Complete Workout

                                    <span>
                                        +@rewardPoints
                                    </span>

                                </button>

                            </form>

                        </div>
                    }

                </div>
            }

        </div>
    }

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/workout.css"
          asp-append-version="true" />
}
