@model IEnumerable<DUT_Campus_FIT_Gym.Models.Equipment>

@{
    ViewData["Title"] = "Gym Equipment";

    var activeReservations =
        ViewBag.ActiveReservations
        as List<DUT_Campus_FIT_Gym.Models.Reservation>;

    var equipmentList = Model?.ToList() ?? new List<DUT_Campus_FIT_Gym.Models.Equipment>();

    var availableCount = equipmentList.Count(e =>
        activeReservations?.FirstOrDefault(r =>
            r.EquipmentID == e.EquipmentID &&
            r.Status == "Reserved" &&
            r.EndTime > DateTime.Now) == null);

    var reservedCount = equipmentList.Count - availableCount;

    var categoryCount = equipmentList
        .Where(e => !string.IsNullOrWhiteSpace(e.Category))
        .Select(e => e.Category)
        .Distinct()
        .Count();
}

<div class="equipment-page">

    <div class="equipment-hero">

        <div class="equipment-hero-content">

            <span class="equipment-eyebrow">
                <i class="fa-solid fa-dumbbell"></i>
                DUT CAMPUS FIT GYM
            </span>

            <h1>Gym Equipment</h1>

            <p>
                Explore available equipment, find what you need for your workout,
                and reserve it before you start training.
            </p>

        </div>

        <div class="equipment-hero-icon">
            <i class="fa-solid fa-dumbbell"></i>
        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="equipment-alert success-alert">

            <div class="alert-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <div>
                <strong>Reservation Updated</strong>
                <span>@TempData["Success"]</span>
            </div>

            <button type="button"
                    class="alert-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="equipment-alert error-alert">

            <div class="alert-icon">
                <i class="fa-solid fa-circle-exclamation"></i>
            </div>

            <div>
                <strong>Something went wrong</strong>
                <span>@TempData["Error"]</span>
            </div>

            <button type="button"
                    class="alert-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
                <i class="fa-solid fa-xmark"></i>
            </button>

        </div>
    }

    <div class="equipment-stats">

        <div class="equipment-stat-card">

            <div class="stat-icon available">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <div>
                <span>Available</span>
                <strong>@availableCount</strong>
            </div>

        </div>

        <div class="equipment-stat-card">

            <div class="stat-icon reserved">
                <i class="fa-solid fa-lock"></i>
            </div>

            <div>
                <span>Currently Reserved</span>
                <strong>@reservedCount</strong>
            </div>

        </div>

        <div class="equipment-stat-card">

            <div class="stat-icon categories">
                <i class="fa-solid fa-layer-group"></i>
            </div>

            <div>
                <span>Categories</span>
                <strong>@categoryCount</strong>
            </div>

        </div>

        <a asp-controller="Equipment"
           asp-action="MyReservations"
           class="equipment-stat-action">

            <div class="stat-action-icon">
                <i class="fa-solid fa-clock-rotate-left"></i>
            </div>

            <div>
                <span>Manage</span>
                <strong>My Reservations</strong>
            </div>

            <i class="fa-solid fa-arrow-right action-arrow"></i>

        </a>

    </div>

    @if (activeReservations != null && activeReservations.Any(r =>
        r.Status == "Reserved" &&
        r.EndTime > DateTime.Now))
    {
        <div class="active-reservation-section">

            <div class="section-heading">

                <div>
                    <span class="section-label">
                        YOUR RESERVATION
                    </span>

                    <h2>Active Equipment Reservation</h2>
                </div>

                <span class="live-badge">
                    <span></span>
                    ACTIVE
                </span>

            </div>

            <div class="active-reservation-card">

                @foreach (var reservation in activeReservations.Where(r =>
                    r.Status == "Reserved" &&
                    r.EndTime > DateTime.Now))
                {
                    var reservedEquipment = equipmentList
                        .FirstOrDefault(e => e.EquipmentID == reservation.EquipmentID);

                    <div class="active-reservation-image">

                        @if (reservedEquipment != null &&
                             !string.IsNullOrWhiteSpace(reservedEquipment.ImagePath))
                        {
                            <img src="@reservedEquipment.ImagePath"
                                 alt="@reservedEquipment.EquipmentName" />
                        }
                        else
                        {
                            <div class="reservation-placeholder">
                                <i class="fa-solid fa-dumbbell"></i>
                            </div>
                        }

                    </div>

                    <div class="active-reservation-info">

                        <span class="reservation-category">
                            @(reservedEquipment?.Category ?? "Equipment")
                        </span>

                        <h3>
                            @(reservedEquipment?.EquipmentName ?? "Reserved Equipment")
                        </h3>

                        <div class="reservation-time">

                            <div>
                                <i class="fa-regular fa-clock"></i>

                                <span>
                                    Reserved until
                                    <strong>
                                        @reservation.EndTime.ToString("HH:mm")
                                    </strong>
                                </span>
                            </div>

                            <span class="reservation-duration">
                                10 MIN RESERVATION
                            </span>

                        </div>

                    </div>

                    <div class="active-reservation-action">

                        <a asp-controller="Equipment"
                           asp-action="MyReservations"
                           class="view-reservation-btn">

                            <i class="fa-solid fa-eye"></i>
                            View Reservation

                        </a>

                    </div>
                }

            </div>

        </div>
    }

    <div class="equipment-list-section">

        <div class="section-heading equipment-list-heading">

            <div>
                <span class="section-label">
                    EQUIPMENT COLLECTION
                </span>

                <h2>Find Your Equipment</h2>

                <p>
                    Choose an available piece of equipment and reserve it for your workout.
                </p>
            </div>

        </div>

        <div class="equipment-controls">

            <div class="equipment-search">

                <i class="fa-solid fa-magnifying-glass"></i>

                <input type="text"
                       id="equipmentSearch"
                       placeholder="Search equipment..." />

            </div>

            <div class="equipment-filter">

                <i class="fa-solid fa-filter"></i>

                <select id="categoryFilter">

                    <option value="">All Categories</option>

                    @foreach (var category in equipmentList
                        .Where(e => !string.IsNullOrWhiteSpace(e.Category))
                        .Select(e => e.Category)
                        .Distinct()
                        .OrderBy(c => c))
                    {
                        <option value="@category">@category</option>
                    }

                </select>

            </div>

        </div>

        @if (equipmentList.Any())
        {
            <div class="equipment-grid" id="equipmentGrid">

                @foreach (var item in equipmentList)
                {
                    var activeReservation = activeReservations?
                        .FirstOrDefault(r =>
                            r.EquipmentID == item.EquipmentID &&
                            r.Status == "Reserved" &&
                            r.EndTime > DateTime.Now);

                    <article class="equipment-card"
                             data-name="@item.EquipmentName"
                             data-category="@item.Category">

                        <div class="equipment-image-wrapper">

                            @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                            {
                                <img src="@item.ImagePath"
                                     alt="@item.EquipmentName"
                                     class="equipment-image" />
                            }
                            else
                            {
                                <div class="equipment-image-placeholder">
                                    <i class="fa-solid fa-dumbbell"></i>
                                </div>
                            }

                            @if (activeReservation == null)
                            {
                                <span class="equipment-status available-status">
                                    <span></span>
                                    Available
                                </span>
                            }
                            else
                            {
                                <span class="equipment-status reserved-status">
                                    <span></span>
                                    Reserved
                                </span>
                            }

                        </div>

                        <div class="equipment-card-body">

                            <span class="equipment-category">
                                @(string.IsNullOrWhiteSpace(item.Category)
                                    ? "Gym Equipment"
                                    : item.Category)
                            </span>

                            <h3>
                                @item.EquipmentName
                            </h3>

                            <div class="equipment-location">

                                <i class="fa-solid fa-location-dot"></i>

                                <span>
                                    @(string.IsNullOrWhiteSpace(item.Location)
                                        ? "Gym Floor"
                                        : item.Location)
                                </span>

                            </div>

                            <div class="equipment-card-footer">

                                @if (activeReservation == null)
                                {
                                    <div class="ready-text">
                                        <i class="fa-solid fa-circle-check"></i>
                                        Ready to reserve
                                    </div>

                                    <form asp-controller="Equipment"
                                          asp-action="Reserve"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@item.EquipmentID" />

                                        <button type="submit"
                                                class="reserve-button">

                                            Reserve

                                            <i class="fa-solid fa-arrow-right"></i>

                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <div class="reserved-info">

                                        <i class="fa-regular fa-clock"></i>

                                        <span>
                                            Until
                                            <strong>
                                                @activeReservation.EndTime.ToString("HH:mm")
                                            </strong>
                                        </span>

                                    </div>

                                    <span class="unavailable-button">
                                        Unavailable
                                    </span>
                                }

                            </div>

                        </div>

                    </article>
                }

            </div>

            <div id="noEquipmentResults"
                 class="no-equipment-results"
                 style="display:none;">

                <div>
                    <i class="fa-solid fa-magnifying-glass"></i>
                </div>

                <h3>No equipment found</h3>

                <p>
                    Try changing your search or category filter.
                </p>

            </div>
        }
        else
        {
            <div class="equipment-empty-state">

                <div class="empty-icon">
                    <i class="fa-solid fa-dumbbell"></i>
                </div>

                <h3>No Equipment Available</h3>

                <p>
                    There is currently no gym equipment registered.
                    Please check again later.
                </p>

            </div>
        }

    </div>

    <div class="reservation-rules">

        <div class="rules-header">

            <div class="rules-icon">
                <i class="fa-solid fa-circle-info"></i>
            </div>

            <div>
                <span class="section-label">
                    RESERVATION GUIDELINES
                </span>

                <h2>Equipment Reservation Rules</h2>
            </div>

        </div>

        <div class="rules-grid">

            <div class="rule-item">

                <span class="rule-number">01</span>

                <div>
                    <strong>One Reservation</strong>
                    <p>
                        Each member can reserve only one piece of equipment at a time.
                    </p>
                </div>

            </div>

            <div class="rule-item">

                <span class="rule-number">02</span>

                <div>
                    <strong>10 Minute Limit</strong>
                    <p>
                        Every equipment reservation remains active for 10 minutes.
                    </p>
                </div>

            </div>

            <div class="rule-item">

                <span class="rule-number">03</span>

                <div>
                    <strong>Cancel Anytime</strong>
                    <p>
                        You can cancel your reservation before the 10 minutes expire.
                    </p>
                </div>

            </div>

            <div class="rule-item">

                <span class="rule-number">04</span>

                <div>
                    <strong>Automatic Release</strong>
                    <p>
                        Equipment automatically becomes available after the reservation expires.
                    </p>
                </div>

            </div>

        </div>

    </div>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/equipment-member.css"
          asp-append-version="true" />
}

@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const searchInput = document.getElementById("equipmentSearch");
            const categoryFilter = document.getElementById("categoryFilter");
            const equipmentCards = document.querySelectorAll(".equipment-card");
            const noResults = document.getElementById("noEquipmentResults");

            function filterEquipment() {

                const searchValue = searchInput.value.toLowerCase().trim();
                const categoryValue = categoryFilter.value.toLowerCase().trim();

                let visibleCount = 0;

                equipmentCards.forEach(card => {

                    const name = (card.dataset.name || "").toLowerCase();
                    const category = (card.dataset.category || "").toLowerCase();

                    const matchesSearch =
                        name.includes(searchValue) ||
                        category.includes(searchValue);

                    const matchesCategory =
                        !categoryValue ||
                        category === categoryValue;

                    if (matchesSearch && matchesCategory) {
                        card.style.display = "";
                        visibleCount++;
                    } else {
                        card.style.display = "none";
                    }

                });

                if (noResults) {
                    noResults.style.display =
                        visibleCount === 0 ? "block" : "none";
                }
            }

            if (searchInput) {
                searchInput.addEventListener("input", filterEquipment);
            }

            if (categoryFilter) {
                categoryFilter.addEventListener("change", filterEquipment);
            }

        });
    </script>
}