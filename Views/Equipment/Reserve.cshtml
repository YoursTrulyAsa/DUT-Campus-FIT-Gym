@model IEnumerable<DUT_Campus_FIT_Gym.ViewModels.ReservationViewModel>

@{
    ViewData["Title"] = "My Reservations";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/member-reservations.css"
          asp-append-version="true" />
}

<div class="reservations-page">

    <div class="page-header">

        <div>

            <span class="page-label">
                DUT CAMPUS FIT GYM
            </span>

            <h1>
                My Reservations
            </h1>

            <p>
                Manage the equipment you have reserved.
            </p>

        </div>

        <a asp-controller="Equipment"
           asp-action="Index"
           class="btn reserve-more-btn">

            <i class="fa-solid fa-plus"></i>

            Browse Equipment

        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">

            <i class="fa-solid fa-circle-check"></i>

            <span>
                @TempData["Success"]
            </span>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-warning">

            <i class="fa-solid fa-triangle-exclamation"></i>

            <span>
                @TempData["Error"]
            </span>

        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="reservation-grid">

            @foreach (var reservation in Model)
            {
                <div class="reservation-card">

                    <div class="reservation-card-header">

                        <div class="equipment-title">

                            <div class="equipment-icon">
                                <i class="fa-solid fa-dumbbell"></i>
                            </div>

                            <div>

                                <span class="equipment-label">
                                    EQUIPMENT
                                </span>

                                <h3>
                                    @reservation.EquipmentName
                                </h3>

                            </div>

                        </div>

                        @if (reservation.Status == "Reserved")
                        {
                            <span class="reservation-status status-reserved">
                                Active
                            </span>
                        }
                        else if (reservation.Status == "Expired")
                        {
                            <span class="reservation-status status-expired">
                                Expired
                            </span>
                        }
                        else if (reservation.Status == "Cancelled")
                        {
                            <span class="reservation-status status-cancelled">
                                Cancelled
                            </span>
                        }
                        else
                        {
                            <span class="reservation-status status-expired">
                                @reservation.Status
                            </span>
                        }

                    </div>

                    <div class="reservation-info">

                        <div class="reservation-info-row">

                            <span class="reservation-info-label">
                                Reserved At
                            </span>

                            <span class="reservation-info-value">
                                @reservation.ReservationDate.ToString(
                                    "dd MMM yyyy HH:mm")
                            </span>

                        </div>

                        <div class="reservation-info-row">

                            <span class="reservation-info-label">
                                Ends At
                            </span>

                            <span class="reservation-info-value">

                                @if (reservation.EndTime > DateTime.MinValue)
                                {
                                    @reservation.EndTime.ToString(
                                        "dd MMM yyyy HH:mm")
                                }
                                else
                                {
                                    <span class="text-danger">
                                        Not set
                                    </span>
                                }

                            </span>

                        </div>

                    </div>

                    @if (reservation.Status == "Reserved")
                    {
                        <div class="reservation-countdown-container">

                            <span class="countdown-label">
                                TIME REMAINING
                            </span>

                            <span class="countdown"
                                  data-end-time="@reservation.EndTime.ToUniversalTime().ToString("o")"
                                  data-reservation-id="@reservation.ReservationID">
                                --:--
                            </span>

                        </div>
                    }
                    else if (reservation.Status == "Expired")
                    {
                        <div class="reservation-countdown-container expired">

                            <span class="countdown-label">
                                RESERVATION STATUS
                            </span>

                            <span class="countdown expired-text">
                                Expired
                            </span>

                        </div>
                    }
                    else if (reservation.Status == "Cancelled")
                    {
                        <div class="reservation-countdown-container cancelled">

                            <span class="countdown-label">
                                RESERVATION STATUS
                            </span>

                            <span class="countdown cancelled-text">
                                Cancelled
                            </span>

                        </div>
                    }

                    @if (reservation.Status == "Reserved")
                    {
                        <div class="reservation-actions">

                            <form asp-controller="Equipment"
                                  asp-action="Unreserve"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@reservation.ReservationID" />

                                <button type="submit"
                                        class="btn unreserve-btn">

                                    <i class="fa-solid fa-xmark"></i>

                                    Unreserve

                                </button>

                            </form>

                        </div>
                    }

                </div>
            }

        </div>
    }
    else
    {
        <div class="empty-reservations">

            <div class="empty-icon">

                <i class="fa-solid fa-dumbbell"></i>

            </div>

            <h2>
                No Reservations Yet
            </h2>

            <p>
                You don't have any equipment reservations
                at the moment.
            </p>

            <a asp-controller="Equipment"
               asp-action="Index"
               class="btn reserve-more-btn">

                <i class="fa-solid fa-dumbbell"></i>

                Browse Equipment

            </a>

        </div>
    }

    <div class="reservation-information">

        <div class="information-icon">
            <i class="fa-solid fa-circle-info"></i>
        </div>

        <div>

            <h3>
                Reservation Information
            </h3>

            <ul>

                <li>
                    Your equipment reservation lasts for
                    <strong>10 minutes</strong>.
                </li>

                <li>
                    You can cancel your reservation at any time
                    before it expires.
                </li>

                <li>
                    After the reservation expires, the equipment
                    remains unavailable during a
                    <strong>2-minute cooldown</strong>.
                </li>

                <li>
                    If you do not dismiss the expiry notification
                    within 1 minute,
                    <strong>15 reward points</strong>
                    will be deducted.
                </li>

            </ul>

        </div>

    </div>

</div>

<form id="dismissNotificationForm"
      method="post">

    @Html.AntiForgeryToken()

</form>

<div id="reservationExpiryNotification"
     style="
    display:none;
    position:fixed;
    top:25px;
    left:50%;
    transform:translateX(-50%);
    width:min(720px, calc(100% - 40px));
    background:#071a33;
    color:#ffffff;
    border:3px solid #dc3545;
    border-radius:16px;
    padding:22px 24px;
    z-index:2147483647;
    box-shadow:0 15px 50px rgba(0,0,0,0.55);
    align-items:center;
    gap:20px;
    ">

    <div style="
        width:55px;
        height:55px;
        min-width:55px;
        border-radius:50%;
        background:#dc3545;
        color:#ffffff;
        display:flex;
        align-items:center;
        justify-content:center;
        font-size:30px;
        font-weight:900;
        ">
        !
    </div>

    <div style="
        flex:1;
        min-width:0;
        ">

        <div style="
            font-size:21px;
            font-weight:800;
            margin-bottom:5px;
            ">
            Reservation Expired
        </div>

        <div style="
            font-size:14px;
            line-height:1.5;
            margin-bottom:7px;
            ">
            Your equipment reservation has expired.
            Dismiss this notification before the timer reaches zero.
        </div>

        <div id="notificationTimer"
             style="
            font-size:28px;
            font-weight:900;
            color:#ff4d4d;
            ">
            01:00
        </div>

    </div>

    <button type="button"
            id="dismissNotification"
            style="
        border:0;
        background:#1597e5;
        color:#ffffff;
        font-weight:800;
        font-size:15px;
        padding:13px 24px;
        border-radius:8px;
        cursor:pointer;
        white-space:nowrap;
        ">

        Dismiss

    </button>

</div>

<script>

    let notificationInterval = null;

    let notificationSoundInterval = null;

    let currentReservationId = null;

    let audioContext = null;

    let audioUnlocked = false;

    let notificationEndTime = null;

    function initializeAudio() {

        try {

            const AudioContext =
                window.AudioContext ||
                window.webkitAudioContext;

            if (!AudioContext) {
                return;
            }

            if (!audioContext) {
                audioContext =
                    new AudioContext();
            }

            if (audioContext.state === "suspended") {
                audioContext.resume();
            }

            if (!audioUnlocked) {

                const oscillator =
                    audioContext.createOscillator();

                const gainNode =
                    audioContext.createGain();

                oscillator.frequency.value =
                    440;

                gainNode.gain.value =
                    0.0001;

                oscillator.connect(
                    gainNode);

                gainNode.connect(
                    audioContext.destination);

                oscillator.start();

                oscillator.stop(
                    audioContext.currentTime +
                    0.01);

                audioUnlocked =
                    true;
            }

        }
        catch (error) {

            console.error(
                "Unable to initialise alert audio:",
                error);

        }

    }

    document.addEventListener(
        "click",
        initializeAudio);

    document.addEventListener(
        "touchstart",
        initializeAudio);

    document.addEventListener(
        "keydown",
        initializeAudio);

    function playBeep(
        frequency,
        duration,
        startTime) {

        if (!audioContext) {
            return;
        }

        const oscillator =
            audioContext.createOscillator();

        const gainNode =
            audioContext.createGain();

        oscillator.type =
            "square";

        oscillator.frequency.setValueAtTime(
            frequency,
            startTime);

        gainNode.gain.setValueAtTime(
            0.001,
            startTime);

        gainNode.gain.exponentialRampToValueAtTime(
            0.65,
            startTime + 0.02);

        gainNode.gain.exponentialRampToValueAtTime(
            0.001,
            startTime + duration);

        oscillator.connect(
            gainNode);

        gainNode.connect(
            audioContext.destination);

        oscillator.start(
            startTime);

        oscillator.stop(
            startTime + duration);

    }

    function playExpirySound() {

        try {

            initializeAudio();

            if (!audioContext) {
                return;
            }

            if (audioContext.state === "suspended") {
                audioContext.resume();
            }

            const now =
                audioContext.currentTime +
                0.05;

            playBeep(
                880,
                0.30,
                now);

            playBeep(
                1100,
                0.30,
                now + 0.40);

            playBeep(
                880,
                0.30,
                now + 0.80);

            playBeep(
                1100,
                0.30,
                now + 1.20);

            playBeep(
                1320,
                0.50,
                now + 1.60);

            playBeep(
                1320,
                0.50,
                now + 2.20);

        }
        catch (error) {

            console.error(
                "Unable to play expiry sound:",
                error);

        }

    }

    function startExpirySound() {

        stopExpirySound();

        playExpirySound();

        notificationSoundInterval =
            setInterval(
                function() {

                    if (currentReservationId) {
                        playExpirySound();
                    }

                },
                4000);

    }

    function stopExpirySound() {

        if (notificationSoundInterval) {

            clearInterval(
                notificationSoundInterval);

            notificationSoundInterval =
                null;

        }

    }

    function updateNotificationTimer() {

        if (!notificationEndTime) {
            return;
        }

        const notification =
            document.getElementById(
                "reservationExpiryNotification");

        const timer =
            document.getElementById(
                "notificationTimer");

        const dismissButton =
            document.getElementById(
                "dismissNotification");

        const remaining =
            Math.max(
                0,
                notificationEndTime -
                Date.now());

        const totalSeconds =
            Math.ceil(
                remaining /
                1000);

        const minutes =
            Math.floor(
                totalSeconds /
                60);

        const seconds =
            totalSeconds %
            60;

        if (timer) {

            timer.textContent =
                String(minutes)
                    .padStart(2, "0") +
                ":" +
                String(seconds)
                    .padStart(2, "0");

        }

        if (notification) {

            notification.style.display =
                "flex";

            notification.style.visibility =
                "visible";

            notification.style.opacity =
                "1";

        }

        if (remaining <= 0) {

    if (timer) {
        timer.textContent = "00:00";
    }

    if (dismissButton) {
        dismissButton.disabled = true;
        dismissButton.textContent = "Processing...";
        dismissButton.style.background = "#6c757d";
        dismissButton.style.cursor = "not-allowed";
    }

    stopExpirySound();

    if (notificationInterval) {
        clearInterval(notificationInterval);
        notificationInterval = null;
    }

    const token =
        document.querySelector(
            "#dismissNotificationForm input[name='__RequestVerificationToken']");

    if (!token || !currentReservationId) {
        return;
    }

    const reservationId =
        currentReservationId;

    fetch(
        "@Url.Action("ProcessMissedReservationNotification", "Equipment")",
        {
            method: "POST",

            headers:
            {
                "Content-Type":
                    "application/x-www-form-urlencoded; charset=UTF-8"
            },

            body:
                "reservationId=" +
                encodeURIComponent(reservationId) +
                "&__RequestVerificationToken=" +
                encodeURIComponent(token.value)
        })
        .then(function(response) {

            if (!response.ok) {
                throw new Error(
                    "Penalty processing failed.");
            }

            return response.json();
        })
        .then(function(result) {

            if (dismissButton) {
                dismissButton.textContent =
                    result.penaltyCreated
                        ? "R50 Penalty Applied"
                        : "15 Points Deducted";
            }

            setTimeout(function() {
                window.location.reload();
            }, 1500);

        })
        .catch(function(error) {

            console.error(
                "Unable to process missed reservation:",
                error);

            if (dismissButton) {
                dismissButton.textContent =
                    "Processing Failed";
            }

        });
}

    }

    function showExpiryNotification(
        reservationId) {

        const notification =
            document.getElementById(
                "reservationExpiryNotification");

        const timer =
            document.getElementById(
                "notificationTimer");

        const dismissButton =
            document.getElementById(
                "dismissNotification");

        if (!notification ||
            !timer ||
            !dismissButton) {
            return;
        }

        if (currentReservationId) {
            return;
        }

        currentReservationId =
            reservationId;

        notificationEndTime =
            Date.now() +
            60000;

        timer.textContent =
            "01:00";

        dismissButton.disabled =
            false;

        dismissButton.textContent =
            "Dismiss";

        dismissButton.style.background =
            "#1597e5";

        dismissButton.style.cursor =
            "pointer";

        notification.style.display =
            "flex";

        notification.style.visibility =
            "visible";

        notification.style.opacity =
            "1";

        notification.style.position =
            "fixed";

        notification.style.top =
            "25px";

        notification.style.left =
            "50%";

        notification.style.transform =
            "translateX(-50%)";

        notification.style.zIndex =
            "2147483647";

        startExpirySound();

        if (notificationInterval) {

            clearInterval(
                notificationInterval);

        }

        notificationInterval =
            setInterval(
                updateNotificationTimer,
                250);

        updateNotificationTimer();

    }

    function updateCountdowns() {

        const countdowns =
            document.querySelectorAll(
                ".countdown");

        const now =
            Date.now();

        countdowns.forEach(
            function(element) {

                const endTimeString =
                    element.getAttribute(
                        "data-end-time");

                const reservationId =
                    element.getAttribute(
                        "data-reservation-id");

                if (!endTimeString ||
                    !reservationId) {

                    element.textContent =
                        "Expired";

                    return;

                }

                const endTime =
                    new Date(
                        endTimeString)
                        .getTime();

                const difference =
                    endTime -
                    now;

                if (difference <= 0) {

                    element.textContent =
                        "Expired";

                    element.classList.remove(
                        "text-danger");

                    element.classList.add(
                        "text-secondary");

                    if (!element.dataset.expired) {

                        element.dataset.expired =
                            "true";

                        showExpiryNotification(
                            reservationId);

                    }

                    return;

                }

                const totalSeconds =
                    Math.ceil(
                        difference /
                        1000);

                const minutes =
                    Math.floor(
                        totalSeconds /
                        60);

                const seconds =
                    totalSeconds %
                    60;

                element.textContent =
                    "⏱️ " +
                    String(minutes)
                        .padStart(2, "0") +
                    ":" +
                    String(seconds)
                        .padStart(2, "0") +
                    " remaining";

            });

    }

    function dismissNotification() {

        if (!currentReservationId) {
            return;
        }

        if (!notificationEndTime ||
            Date.now() >= notificationEndTime) {
            return;
        }

        const token =
            document.querySelector(
                "#dismissNotificationForm input[name='__RequestVerificationToken']");

        if (!token) {

            console.error(
                "Anti-forgery token not found.");

            return;

        }

        const reservationId =
            currentReservationId;

        const dismissButton =
            document.getElementById(
                "dismissNotification");

        if (dismissButton) {

            dismissButton.disabled =
                true;

            dismissButton.textContent =
                "Dismissing...";

        }

        fetch(
            "@Url.Action("DismissReservationNotification", "Equipment")",
            {
                method: "POST",

                headers:
                {
                    "Content-Type":
                        "application/x-www-form-urlencoded; charset=UTF-8"
                },

                body:
                    "reservationId=" +
                    encodeURIComponent(
                        reservationId) +
                    "&__RequestVerificationToken=" +
                    encodeURIComponent(
                        token.value)
            })
            .then(
                function(response) {

                    if (!response.ok) {

                        throw new Error(
                            "Dismiss request failed.");

                    }

                    const notification =
                        document.getElementById(
                            "reservationExpiryNotification");

                    notification.style.display =
                        "none";

                    notification.style.visibility =
                        "hidden";

                    notification.style.opacity =
                        "0";

                    stopExpirySound();

                    if (notificationInterval) {

                        clearInterval(
                            notificationInterval);

                        notificationInterval =
                            null;

                    }

                    currentReservationId =
                        null;

                    notificationEndTime =
                        null;

                })
            .catch(
                function(error) {

                    console.error(
                        "Unable to dismiss reservation notification:",
                        error);

                    if (dismissButton) {

                        dismissButton.disabled =
                            false;

                        dismissButton.textContent =
                            "Dismiss";

                    }

                });

    }

    document
        .getElementById(
            "dismissNotification")
        .addEventListener(
            "click",
            dismissNotification);

    updateCountdowns();

    setInterval(
        updateCountdowns,
        1000);

</script>