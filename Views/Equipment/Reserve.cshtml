@model IEnumerable<DUT_Campus_FIT_Gym.ViewModels.ReservationViewModel>

@{
    ViewData["Title"] = "My Reservations";
}

<div class="container mt-5">

    <!-- PAGE HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="mb-1">My Reservations</h1>

            <p class="text-muted mb-0">
                Manage your current and previous equipment reservations.
            </p>
        </div>

        <a asp-controller="Equipment"
           asp-action="Index"
           class="btn btn-primary">

            Reserve Equipment

        </a>

    </div>


    <!-- SUCCESS MESSAGE -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ERROR MESSAGE -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm border-0">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-dark">

                            <tr>

                                <th class="px-4">
                                    Equipment
                                </th>

                                <th>
                                    Reserved At
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Time Remaining
                                </th>

                                <th class="text-center">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var reservation in Model)
                            {
                                <tr>

                                    <!-- EQUIPMENT -->

                                    <td class="px-4">

                                        <strong>
                                            @reservation.EquipmentName
                                        </strong>

                                    </td>


                                    <!-- RESERVATION DATE -->

                                    <td>

                                        @reservation.ReservationDate.ToString(
                                            "dd MMM yyyy HH:mm")

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        @if (reservation.Status == "Reserved")
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else if (reservation.Status == "Expired")
                                        {
                                            <span class="badge bg-secondary">
                                                Expired
                                            </span>
                                        }
                                        else if (reservation.Status == "Cancelled")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Cancelled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @reservation.Status
                                            </span>
                                        }

                                    </td>


                                    <!-- TIME REMAINING -->

                                    <td>

                                        @if (reservation.Status == "Reserved")
                                        {
                                            <span class="countdown fw-bold text-danger"
                                                  data-end-time="@reservation.EndTime.ToString("o")">

                                                Calculating...

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }

                                    </td>


                                    <!-- ACTION -->

                                    <td class="text-center">

                                        @if (reservation.Status == "Reserved")
                                        {
                                            <form asp-controller="Equipment"
                                                  asp-action="Unreserve"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@reservation.ReservationID" />

                                                <button type="submit"
                                                        class="btn btn-danger btn-sm">

                                                    Cancel Reservation

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No action available
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }
    else
    {
        <!-- NO RESERVATIONS -->

        <div class="card shadow-sm border-0">

            <div class="card-body text-center py-5">

                <div style="font-size: 50px;">
                    🏋️
                </div>

                <h3 class="mt-3">
                    No Reservations
                </h3>

                <p class="text-muted">
                    You currently don't have any equipment reservations.
                </p>

                <a asp-controller="Equipment"
                   asp-action="Index"
                   class="btn btn-primary">

                    Browse Equipment

                </a>

            </div>

        </div>
    }


    <!-- INFORMATION -->

    <div class="alert alert-info mt-4">

        <strong>Reservation Information</strong>

        <ul class="mb-0 mt-2">

            <li>
                Your equipment reservation lasts for
                <strong>10 minutes</strong>.
            </li>

            <li>
                You can cancel your reservation at any time
                before it expires.
            </li>

            <li>
                After the reservation expires, the equipment
                becomes available for other students.
            </li>

        </ul>

    </div>

</div>


<!-- LIVE COUNTDOWN -->

<script>

    function updateCountdowns() {

        const countdowns =
            document.querySelectorAll(".countdown");

        countdowns.forEach(function (element) {

            const endTime =
                new Date(element.dataset.endTime).getTime();

            const now =
                new Date().getTime();

            const difference =
                endTime - now;


            if (difference <= 0) {

                element.innerHTML =
                    "Expired";

                element.classList.remove("text-danger");
                element.classList.add("text-secondary");

                return;
            }


            const minutes =
                Math.floor(
                    difference / (1000 * 60)
                );

            const seconds =
                Math.floor(
                    (difference % (1000 * 60)) / 1000
                );


            element.innerHTML =
                "⏱️ " +
                String(minutes).padStart(2, "0") +
                ":" +
                String(seconds).padStart(2, "0") +
                " remaining";

        });

    }


    updateCountdowns();

    setInterval(updateCountdowns, 1000);

</script>
