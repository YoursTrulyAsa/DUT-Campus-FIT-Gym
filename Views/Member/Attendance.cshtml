@model List<DUT_Campus_FIT_Gym.ViewModels.AttendanceViewModel>

@{
    ViewData["Title"] = "Attendance";

    var totalVisits = Model.Count;

    var thisMonth = Model.Count(a =>
        a.CheckInTime.Month == DateTime.Now.Month &&
        a.CheckInTime.Year == DateTime.Now.Year);

    var currentAttendance = Model
        .Where(a => a.CheckOutTime == null)
        .OrderByDescending(a => a.CheckInTime)
        .FirstOrDefault();

    var currentlyCheckedIn = currentAttendance != null;

    var totalRewardPoints = Model.Sum(a =>
        a.TotalRewardPoints);
}

<div class="attendance-page">

    <div class="attendance-header">

        <div>
            <span class="attendance-label">
                ACTIVITY
            </span>

            <h1>
                Attendance
            </h1>

            <p>
                View your gym visit history and activity rewards.
            </p>
        </div>

        <a asp-controller="Member"
           asp-action="Dashboard"
           class="attendance-back-btn">

            <i class="fa-solid fa-arrow-left"></i>

            Dashboard

        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="attendance-alert success">

            <div class="attendance-alert-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <div>
                <strong>
                    Attendance Updated
                </strong>

                <p>
                    @TempData["Success"]
                </p>
            </div>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="attendance-alert error">

            <div class="attendance-alert-icon">
                <i class="fa-solid fa-circle-exclamation"></i>
            </div>

            <div>
                <strong>
                    Attendance Update Failed
                </strong>

                <p>
                    @TempData["Error"]
                </p>
            </div>

        </div>
    }

    <div class="attendance-summary">

        <div class="attendance-stat">

            <div class="attendance-stat-icon">
                <i class="fa-solid fa-calendar-check"></i>
            </div>

            <div>
                <span>
                    Total Visits
                </span>

                <strong>
                    @totalVisits
                </strong>
            </div>

        </div>

        <div class="attendance-stat">

            <div class="attendance-stat-icon">
                <i class="fa-solid fa-calendar-days"></i>
            </div>

            <div>
                <span>
                    This Month
                </span>

                <strong>
                    @thisMonth
                </strong>
            </div>

        </div>

        <div class="attendance-stat">

            <div class="attendance-stat-icon">
                <i class="fa-solid fa-star"></i>
            </div>

            <div>
                <span>
                    Attendance Rewards
                </span>

                <strong>
                    +@totalRewardPoints
                </strong>
            </div>

        </div>

        <div class="attendance-stat">

            <div class="attendance-stat-icon">
                <i class="fa-solid fa-person-running"></i>
            </div>

            <div>
                <span>
                    Current Status
                </span>

                <strong>
                    @(currentlyCheckedIn ? "Checked In" : "Not Checked In")
                </strong>
            </div>

        </div>

    </div>

    @if (currentlyCheckedIn)
    {
        <div class="active-attendance-card">

            <div class="active-attendance-left">

                <div class="active-attendance-icon">
                    <i class="fa-solid fa-person-circle-check"></i>
                </div>

                <div class="active-attendance-content">

                    <span class="active-attendance-label">
                        ACTIVE GYM SESSION
                    </span>

                    <h2>
                        You're currently checked in
                    </h2>

                    <p>
                        Your attendance has been recorded for today's session.
                    </p>

                    <div class="active-attendance-time">

                        <div>
                            <span>
                                CHECKED IN
                            </span>

                            <strong>
                                @currentAttendance.CheckInTime.ToString("dd MMM yyyy")
                            </strong>
                        </div>

                        <div>
                            <span>
                                START TIME
                            </span>

                            <strong>
                                @currentAttendance.CheckInTime.ToString("HH:mm")
                            </strong>
                        </div>

                    </div>

                </div>

            </div>

            <div class="active-attendance-action">

                <form asp-controller="Member"
                      asp-action="CheckOut"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="attendance-checkout-btn">

                        <i class="fa-solid fa-right-from-bracket"></i>

                        Check Out

                    </button>

                </form>

                <span>
                    Finished your session?
                </span>

            </div>

        </div>
    }
    else
    {
        <div class="attendance-ready-card">

            <div class="attendance-ready-icon">
                <i class="fa-solid fa-dumbbell"></i>
            </div>

            <div class="attendance-ready-content">

                <span>
                    READY FOR YOUR NEXT SESSION?
                </span>

                <h2>
                    Your next gym visit starts with checking in.
                </h2>

                <p>
                    Head to the Check-In page when you're ready to start your next session.
                </p>

            </div>

            <a asp-controller="Member"
               asp-action="CheckIn"
               class="attendance-checkin-btn">

                <i class="fa-solid fa-door-open"></i>

                Check In

            </a>

        </div>
    }

    <div class="attendance-card">

        <div class="attendance-card-header">

            <div>
                <span class="attendance-label">
                    HISTORY
                </span>

                <h2>
                    Recent Visits
                </h2>
            </div>

            <i class="fa-solid fa-clock-rotate-left"></i>

        </div>

        @if (Model.Any())
        {
            <div class="attendance-table-wrapper">

                <table class="attendance-table">

                    <thead>

                        <tr>
                            <th>Date</th>
                            <th>Check In</th>
                            <th>Check Out</th>
                            <th>Duration</th>
                            <th>Equipment</th>
                            <th>Rewards</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var record in Model)
                        {
                            <tr>

                                <td>
                                    @record.CheckInTime.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @record.CheckInTime.ToString("HH:mm")
                                </td>

                                <td>

                                    @if (record.CheckOutTime.HasValue)
                                    {
                                        @record.CheckOutTime.Value.ToString("HH:mm")
                                    }
                                    else
                                    {
                                        <span class="checked-in">
                                            Currently In
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (record.Duration.HasValue)
                                    {
                                        @record.Duration.Value.ToString(@"hh\:mm")
                                    }
                                    else
                                    {
                                        <span>
                                            —
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (record.EquipmentCount > 0)
                                    {
                                        <span>
                                            @record.EquipmentCount
                                        </span>

                                        <small>
                                            @(record.EquipmentCount == 1
                                                ? "item"
                                                : "items")
                                        </small>
                                    }
                                    else
                                    {
                                        <span>
                                            0
                                        </span>
                                    }

                                </td>

                                <td>

                                    <div class="attendance-reward">

                                        <i class="fa-solid fa-star"></i>

                                        <strong>
                                            +@record.TotalRewardPoints
                                        </strong>

                                    </div>

                                    <small class="attendance-reward-breakdown">
                                        Check-in +@record.CheckInRewardPoints
                                        · Equipment +@record.EquipmentRewardPoints
                                    </small>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="no-attendance">

                <i class="fa-solid fa-calendar-xmark"></i>

                <h3>
                    No attendance records
                </h3>

                <p>
                    Your gym visits will appear here.
                </p>

                <a asp-controller="Member"
                   asp-action="CheckIn"
                   class="attendance-empty-btn">

                    <i class="fa-solid fa-door-open"></i>

                    Check In

                </a>

            </div>
        }

    </div>

</div>

@section Styles {

    <link rel="stylesheet"
          href="~/css/member-attendance.css"
          asp-append-version="true" />

}