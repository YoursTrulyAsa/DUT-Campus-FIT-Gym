@model DUT_Campus_FIT_Gym.Models.Member

@{
    ViewData["Title"] = "My Profile";
}

<div class="profile-page">

    <div class="profile-header">

        <div>
            <span class="profile-label">ACCOUNT</span>

            <h1>My Profile</h1>

            <p>
                View and update your personal DUT Campus FIT Gym information.
            </p>
        </div>

        <a asp-controller="Member"
           asp-action="Dashboard"
           class="back-btn">

            <i class="fa-solid fa-arrow-left"></i>

            Dashboard

        </a>

    </div>

    @if (TempData["ProfileSuccess"] != null)
    {
        <div class="alert alert-success">
            @TempData["ProfileSuccess"]
        </div>
    }

    @if (TempData["ProfileError"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ProfileError"]
        </div>
    }

    <div class="profile-container">

        <div class="profile-summary">

            <div class="profile-avatar">

                @if (!string.IsNullOrWhiteSpace(Model.ProfilePicture))
                {
                    <img src="@Model.ProfilePicture"
                         alt="Profile picture"
                         class="profile-avatar-image"
                         id="profilePreview" />
                }
                else
                {
                    <img src=""
                         alt="Profile preview"
                         class="profile-avatar-image"
                         id="profilePreview"
                         style="display: none;" />

                    <i class="fa-solid fa-user"
                       id="profilePlaceholder"></i>
                }

            </div>

            <h2>
                @Model.Name @Model.Surname
            </h2>

            <span class="role-badge">
                @Model.Role
            </span>

            <p>
                DUT Campus FIT Gym Member
            </p>

            <div class="profile-photo-actions">

                <form asp-controller="Member"
                      asp-action="Profile"
                      method="post"
                      enctype="multipart/form-data"
                      id="photoUploadForm">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="name"
                           value="@Model.Name" />

                    <input type="hidden"
                           name="surname"
                           value="@Model.Surname" />

                    <input type="hidden"
                           name="phoneNumber"
                           value="@Model.PhoneNumber" />

                    <label for="profilePicture"
                           class="profile-photo-btn">

                        <i class="fa-solid fa-camera"></i>

                        @(string.IsNullOrWhiteSpace(Model.ProfilePicture)
                            ? "Add Photo"
                            : "Change Photo")

                    </label>

                    <input type="file"
                           id="profilePicture"
                           name="profilePicture"
                           accept=".jpg,.jpeg,.png,.webp"
                           hidden />

                    <button type="submit"
                            class="profile-photo-btn"
                            id="uploadPhotoBtn"
                            style="display: none;">

                        <i class="fa-solid fa-cloud-arrow-up"></i>

                        Upload Photo

                    </button>

                    <button type="button"
                            class="remove-photo-btn"
                            id="cancelPhotoBtn"
                            style="display: none;">

                        <i class="fa-solid fa-xmark"></i>

                        Cancel

                    </button>

                </form>

                @if (!string.IsNullOrWhiteSpace(Model.ProfilePicture))
                {
                    <form asp-controller="Member"
                          asp-action="RemovePhoto"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="remove-photo-btn">

                            <i class="fa-solid fa-trash"></i>

                            Remove

                        </button>

                    </form>
                }

            </div>

            <small class="profile-photo-hint">
                JPG, PNG or WebP · Maximum 5 MB
            </small>

        </div>

        <div class="profile-card">

            <div class="profile-card-header">

                <div>
                    <span class="profile-label">
                        PERSONAL INFORMATION
                    </span>

                    <h2>
                        Account Details
                    </h2>
                </div>

                <i class="fa-solid fa-user-pen"></i>

            </div>

            <form asp-controller="Member"
                  asp-action="Profile"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="profile-details">

                    <div class="profile-field">

                        <label for="name">
                            First Name
                        </label>

                        <input type="text"
                               id="name"
                               name="name"
                               value="@Model.Name"
                               class="form-control"
                               required />

                        <span class="text-danger"
                              asp-validation-for="Name">
                        </span>

                    </div>

                    <div class="profile-field">

                        <label for="surname">
                            Last Name
                        </label>

                        <input type="text"
                               id="surname"
                               name="surname"
                               value="@Model.Surname"
                               class="form-control"
                               required />

                        <span class="text-danger"
                              asp-validation-for="Surname">
                        </span>

                    </div>

                    <div class="profile-field">

                        <span>
                            Student / Staff Number
                        </span>

                        <strong>
                            @Model.StudentNumber
                        </strong>

                    </div>

                    <div class="profile-field">

                        <span>
                            Email Address
                        </span>

                        <strong>
                            @Model.Email
                        </strong>

                    </div>

                    <div class="profile-field">

                        <label for="phoneNumber">
                            Phone Number
                        </label>

                        <input type="text"
                               id="phoneNumber"
                               name="phoneNumber"
                               value="@Model.PhoneNumber"
                               class="form-control"
                               required />

                        <span class="text-danger"
                              asp-validation-for="PhoneNumber">
                        </span>

                    </div>

                    <div class="profile-field">

                        <span>
                            Account Role
                        </span>

                        <strong>
                            @Model.Role
                        </strong>

                    </div>

                </div>

                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="fa-solid fa-floppy-disk"></i>

                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Styles {

    <link rel="stylesheet"
          href="~/css/member-profile.css"
          asp-append-version="true" />

}

@section Scripts {

    <script>
        const profilePicture = document.getElementById("profilePicture");
        const profilePreview = document.getElementById("profilePreview");
        const profilePlaceholder = document.getElementById("profilePlaceholder");
        const uploadPhotoBtn = document.getElementById("uploadPhotoBtn");
        const cancelPhotoBtn = document.getElementById("cancelPhotoBtn");

        profilePicture.addEventListener("change", function () {

            const file = this.files[0];

            if (!file) {
                return;
            }

            const allowedTypes = [
                "image/jpeg",
                "image/png",
                "image/webp"
            ];

            if (!allowedTypes.includes(file.type)) {
                alert("Please select a JPG, PNG or WebP image.");
                this.value = "";
                return;
            }

            if (file.size > 5 * 1024 * 1024) {
                alert("The profile picture must be 5 MB or smaller.");
                this.value = "";
                return;
            }

            const reader = new FileReader();

            reader.onload = function (event) {

                profilePreview.src = event.target.result;
                profilePreview.style.display = "block";

                if (profilePlaceholder) {
                    profilePlaceholder.style.display = "none";
                }

                uploadPhotoBtn.style.display = "inline-flex";
                cancelPhotoBtn.style.display = "inline-flex";
            };

            reader.readAsDataURL(file);
        });

        cancelPhotoBtn.addEventListener("click", function () {

            profilePicture.value = "";

            uploadPhotoBtn.style.display = "none";
            cancelPhotoBtn.style.display = "none";

            @if (!string.IsNullOrWhiteSpace(Model.ProfilePicture))
            {
                <text>
                profilePreview.src = "@Model.ProfilePicture";
                profilePreview.style.display = "block";
                </text>
            }
            else
            {
                <text>
                profilePreview.src = "";
                profilePreview.style.display = "none";

                if (profilePlaceholder) {
                    profilePlaceholder.style.display = "block";
                }
                </text>
            }
        });
    </script>

}
