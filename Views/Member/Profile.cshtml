@model DUT_Campus_FIT_Gym.Models.Member

@{
    ViewData["Title"] = "My Profile";
}
@{
    var totalPaid = Model.Payments
        .Where(p => p.PaymentStatus != null &&
                    p.PaymentStatus.Equals(
                        "Completed",
                        StringComparison.OrdinalIgnoreCase))
        .Sum(p => p.Amount);
}
<div class="text-center mb-4">

    @if (!string.IsNullOrEmpty(Model.ProfilePicture))
    {
        <img src="@Model.ProfilePicture"
             alt="Profile Picture"
             width="150"
             height="150"
             style="object-fit: cover; border-radius: 50%;" />
    }
    else
    {
        <div style="
            width:150px;
            height:150px;
            border-radius:50%;
            background:#ddd;
            display:flex;
            align-items:center;
            justify-content:center;
            margin:auto;">

            <span>No Picture</span>

        </div>
    }

</div>
<div class="card mb-4">
    <div class="card-body">

        <h5 class="card-title">
            Profile Picture
        </h5>

        @if (TempData["ProfilePictureSuccess"] != null)
        {
            <div class="alert alert-success">
                @TempData["ProfilePictureSuccess"]
            </div>
        }

        @if (TempData["ProfilePictureError"] != null)
        {
            <div class="alert alert-danger">
                @TempData["ProfilePictureError"]
            </div>
        }

        <form asp-action="UploadProfilePicture"
              asp-controller="Member"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div class="mb-3">

                <label class="form-label">
                    Choose your profile picture
                </label>

                <input type="file"
                       name="profilePicture"
                       class="form-control"
                       accept=".jpg,.jpeg,.png"
                       required />

                <small class="text-muted">
                    JPG, JPEG or PNG. Maximum 5 MB.
                </small>

            </div>

            <button type="submit"
                    class="btn btn-primary">
                Upload Picture
            </button>

        </form>

    </div>
</div>
<div class="profile-page">

    <!-- PAGE HEADER -->
    <div class="profile-header">

        <div>
            <span class="profile-label">ACCOUNT</span>

            <h1>My Profile</h1>

            <p>
                View and update your personal DUT Campus FIT Gym information.
            </p>
        </div>

        <a asp-controller="Member"
           asp-action="Dashboard"
           class="back-btn">

            <i class="fa-solid fa-arrow-left"></i>

            Dashboard

        </a>

    </div>


    <!-- SUCCESS MESSAGE -->
    @if (TempData["ProfileSuccess"] != null)
    {
        <div class="alert alert-success">
            @TempData["ProfileSuccess"]
        </div>
    }


    <!-- PROFILE CONTENT -->
    <div class="profile-container">

        <!-- PROFILE SUMMARY -->
        <div class="profile-summary">

            <div class="profile-avatar">
                <i class="fa-solid fa-user"></i>
            </div>

            <h2>
                @Model.Name @Model.Surname
            </h2>

            <span class="role-badge">
                @Model.Role
            </span>

            <p>
                DUT Campus FIT Gym Member
            </p>

        </div>


        <!-- ACCOUNT DETAILS -->
        <div class="profile-card">

            <div class="profile-card-header">

                <div>
                    <span class="profile-label">
                        PERSONAL INFORMATION
                    </span>

                    <h2>
                        Account Details
                    </h2>
                </div>

                <i class="fa-solid fa-user-pen"></i>

            </div>


            <!-- EDIT FORM -->
            <form asp-controller="Member"
                  asp-action="Profile"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- EDITABLE DETAILS -->
                <div class="profile-details">

                    <div class="profile-field">

                        <label for="name">
                            First Name
                        </label>

                        <input type="text"
                               id="name"
                               name="name"
                               value="@Model.Name"
                               class="form-control"
                               required />

                        <span class="text-danger"
                              asp-validation-for="Name">
                        </span>

                    </div>


                    <div class="profile-field">

                        <label for="surname">
                            Last Name
                        </label>

                        <input type="text"
                               id="surname"
                               name="surname"
                               value="@Model.Surname"
                               class="form-control"
                               required />

                        <span class="text-danger"
                              asp-validation-for="Surname">
                        </span>

                    </div>


                    <!-- READ-ONLY STUDENT NUMBER -->
                    <div class="profile-field">

                        <span>
                            Student / Staff Number
                        </span>

                        <strong>
                            @Model.StudentNumber
                        </strong>

                    </div>


                    <!-- READ-ONLY EMAIL -->
                    <div class="profile-field">

                        <span>
                            Email Address
                        </span>

                        <strong>
                            @Model.Email
                        </strong>

                    </div>


                    <!-- EDITABLE PHONE NUMBER -->
                    <div class="profile-field">

                        <label for="phoneNumber">
                            Phone Number
                        </label>

                        <input type="text"
                               id="phoneNumber"
                               name="phoneNumber"
                               value="@Model.PhoneNumber"
                               class="form-control"
                               required />

                        <span class="text-danger"
                              asp-validation-for="PhoneNumber">
                        </span>

                    </div>


                    <!-- READ-ONLY ROLE -->
                    <div class="profile-field">

                        <span>
                            Account Role
                        </span>

                        <strong>
                            @Model.Role
                        </strong>

                    </div>

                </div>


                <!-- SAVE BUTTON -->
                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="fa-solid fa-floppy-disk"></i>

                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Styles {

    <link rel="stylesheet"
          href="~/css/member-profile.css"
          asp-append-version="true" />

}