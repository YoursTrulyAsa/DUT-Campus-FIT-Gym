@model DUT_Campus_FIT_Gym.Models.Member

@{
    ViewData["Title"] = "My Profile";
}
@{
    var totalPaid = Model.Payments
        .Where(p => p.PaymentStatus != null &&
                    p.PaymentStatus.Equals(
                        "Completed",
                        StringComparison.OrdinalIgnoreCase))
        .Sum(p => p.Amount);
}
<div class="profile-page">

    <!-- PAGE HEADER -->
    <div class="profile-header">

        <div>
            <span class="profile-label">ACCOUNT</span>

            <h1>My Profile</h1>

            <p>
                View and update your personal DUT Campus FIT Gym information.
            </p>
        </div>

        <a asp-controller="Member"
           asp-action="Dashboard"
           class="back-btn">

            <i class="fa-solid fa-arrow-left"></i>

            Dashboard

        </a>

    </div>


    <!-- SUCCESS MESSAGE -->
    @if (TempData["ProfileSuccess"] != null)
    {
        <div class="alert alert-success">
            @TempData["ProfileSuccess"]
        </div>
    }


    <!-- PROFILE CONTENT -->
    <div class="profile-container">

        <!-- PROFILE SUMMARY -->
        <div class="profile-summary">

            <div class="profile-avatar">
                <i class="fa-solid fa-user"></i>
            </div>

            <h2>
                @Model.Name @Model.Surname
            </h2>

            <span class="role-badge">
                @Model.Role
            </span>

            <p>
                DUT Campus FIT Gym Member
            </p>

        </div>


        <!-- ACCOUNT DETAILS -->
        <div class="profile-card">

            <div class="profile-card-header">

                <div>
                    <span class="profile-label">
                        PERSONAL INFORMATION
                    </span>

                    <h2>
                        Account Details
                    </h2>
                </div>

                <i class="fa-solid fa-user-pen"></i>

            </div>


            <!-- EDIT FORM -->
            <form asp-controller="Member"
                  asp-action="Profile"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- EDITABLE DETAILS -->
                <div class="profile-details">

                    <div class="profile-field">

                        <label for="name">
                            First Name
                        </label>

                        <input type="text"
                               id="name"
                               name="name"
                               value="@Model.Name"
                               class="form-control"
                               required />

                        <span class="text-danger"
                              asp-validation-for="Name">
                        </span>

                    </div>


                    <div class="profile-field">

                        <label for="surname">
                            Last Name
                        </label>

                        <input type="text"
                               id="surname"
                               name="surname"
                               value="@Model.Surname"
                               class="form-control"
                               required />

                        <span class="text-danger"
                              asp-validation-for="Surname">
                        </span>

                    </div>


                    <!-- READ-ONLY STUDENT NUMBER -->
                    <div class="profile-field">

                        <span>
                            Student / Staff Number
                        </span>

                        <strong>
                            @Model.StudentNumber
                        </strong>

                    </div>


                    <!-- READ-ONLY EMAIL -->
                    <div class="profile-field">

                        <span>
                            Email Address
                        </span>

                        <strong>
                            @Model.Email
                        </strong>

                    </div>


                    <!-- EDITABLE PHONE NUMBER -->
                    <div class="profile-field">

                        <label for="phoneNumber">
                            Phone Number
                        </label>

                        <input type="text"
                               id="phoneNumber"
                               name="phoneNumber"
                               value="@Model.PhoneNumber"
                               class="form-control"
                               required />

                        <span class="text-danger"
                              asp-validation-for="PhoneNumber">
                        </span>

                    </div>


                    <!-- READ-ONLY ROLE -->
                    <div class="profile-field">

                        <span>
                            Account Role
                        </span>

                        <strong>
                            @Model.Role
                        </strong>

                    </div>

                </div>


                <!-- SAVE BUTTON -->
                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="fa-solid fa-floppy-disk"></i>

                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Styles {

    <link rel="stylesheet"
          href="~/css/member-profile.css"
          asp-append-version="true" />

}