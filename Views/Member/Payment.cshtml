@model IEnumerable<DUT_Campus_FIT_Gym.Models.Payment>

@{
    ViewData["Title"] = "Payment";

    var paymentList = Model?.ToList()
        ?? new List<DUT_Campus_FIT_Gym.Models.Payment>();

    var totalPayments = paymentList.Count;

    var totalPaid = paymentList
        .Where(p => p.PaymentStatus != null &&
                    p.PaymentStatus.Equals(
                        "Completed",
                        StringComparison.OrdinalIgnoreCase))
        .Sum(p => p.Amount);

    var outstandingPenalty =
        ViewBag.OutstandingPenalty as DUT_Campus_FIT_Gym.Models.EquipmentPenalty;
}

@section Styles {

    <link rel="stylesheet"
          href="~/css/payment-history.css"
          asp-append-version="true" />

}

<div class="payment-history-page">

    <div class="payment-history-header">

        <div>

            <span class="payment-label">
                DUT CAMPUS FIT GYM
            </span>

            <h1>
                Payment
            </h1>

            <p>
                View your gym membership payments and payment status.
            </p>

        </div>

        <a asp-controller="Member"
           asp-action="Dashboard"
           class="back-button">

            ← Back to Dashboard

        </a>

    </div>

    @if (TempData["PaymentSuccess"] != null)
    {
        <div class="alert alert-success">

            <span>
                @TempData["PaymentSuccess"]
            </span>

        </div>
    }

    @if (TempData["PaymentError"] != null)
    {
        <div class="alert alert-danger">

            <span>
                @TempData["PaymentError"]
            </span>

        </div>
    }

    @if (outstandingPenalty != null)
    {
        <div class="outstanding-penalty-card">

            <div class="outstanding-penalty-content">

                <div class="outstanding-penalty-icon">
                    ⚠
                </div>

                <div>

                    <span class="outstanding-penalty-label">
                        OUTSTANDING EQUIPMENT PENALTY
                    </span>

                    <h2>
                        R @outstandingPenalty.Amount.ToString("0.00")
                    </h2>

                    <p>
                        You have an outstanding equipment reservation penalty.
                        Please settle this payment before continuing to use the affected equipment.
                    </p>

                </div>

            </div>

            <a asp-controller="Banking"
               asp-action="PayPenalty"
               asp-route-penaltyId="@outstandingPenalty.EquipmentPenaltyId"
               class="penalty-pay-button">

                Pay R @outstandingPenalty.Amount.ToString("0.00")

            </a>

        </div>
    }

    @if (paymentList.Count == 0)
    {
        <div class="payment-empty">

            <div class="empty-icon">
                💳
            </div>

            <h2>
                No Payments Yet
            </h2>

            <p>
                You have not made any gym membership payments yet.
            </p>

            <a asp-controller="Member"
               asp-action="Membership"
               class="membership-button">

                View Membership

            </a>

        </div>
    }
    else
    {
        <div class="payment-summary">

            <div class="summary-card">

                <span class="summary-icon">
                    💳
                </span>

                <div>

                    <small>
                        TOTAL PAYMENTS
                    </small>

                    <strong>
                        @totalPayments
                    </strong>

                </div>

            </div>

            <div class="summary-card">

                <span class="summary-icon">
                    💰
                </span>

                <div>

                    <small>
                        TOTAL PAID
                    </small>

                    <strong>
                        R @totalPaid.ToString("0.00")
                    </strong>

                </div>

            </div>

        </div>

        <div class="payments-card">

            <div class="payments-card-header">

                <div>

                    <h2>
                        Transaction History
                    </h2>

                    <p>
                        Your gym membership and equipment payment records.
                    </p>

                </div>

            </div>

            <div class="table-responsive">

                <table class="payments-table">

                    <thead>

                        <tr>

                            <th>
                                Receipt
                            </th>

                            <th>
                                Payment
                            </th>

                            <th>
                                Amount
                            </th>

                            <th>
                                Payment Method
                            </th>

                            <th>
                                Date
                            </th>

                            <th>
                                Status
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var payment in paymentList)
                        {
                            <tr>

                                <td>

                                    <strong>
                                        @(payment.ReceiptNumber ?? "N/A")
                                    </strong>

                                </td>

                                <td>

                                    @if (payment.EquipmentPenalty != null)
                                    {
                                        <span>
                                            Equipment Penalty
                                        </span>
                                    }
                                    else if (payment.Membership != null)
                                    {
                                        <span>
                                            @payment.Membership.MembershipType Membership
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            Payment
                                        </span>
                                    }

                                </td>

                                <td>

                                    <strong>
                                        R @payment.Amount.ToString("0.00")
                                    </strong>

                                </td>

                                <td>

                                    @(payment.PaymentMethod ?? "N/A")

                                </td>

                                <td>

                                    @if (payment.PaymentDate != DateTime.MinValue)
                                    {
                                        @payment.PaymentDate.ToString(
                                            "dd MMM yyyy, HH:mm")
                                    }
                                    else
                                    {
                                        <span>
                                            Pending
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (string.Equals(
                                        payment.PaymentStatus,
                                        "Completed",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="payment-status paid">

                                            ✓ Paid

                                        </span>
                                    }
                                    else if (string.Equals(
                                        payment.PaymentStatus,
                                        "Pending",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="payment-status pending">

                                            ⏳ Pending

                                        </span>
                                    }
                                    else if (string.Equals(
                                        payment.PaymentStatus,
                                        "Failed",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="payment-status failed">

                                            ✕ Failed

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="payment-status">

                                            @(payment.PaymentStatus ?? "Unknown")

                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>

<style>
    .outstanding-penalty-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 24px;
        margin-bottom: 24px;
        border-radius: 18px;
        border: 1px solid rgba(245, 158, 11, 0.35);
        background: linear-gradient(135deg, #fff7ed, #fffbeb);
    }

    .outstanding-penalty-content {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .outstanding-penalty-icon {
        width: 52px;
        height: 52px;
        min-width: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: #f59e0b;
        color: white;
        font-size: 24px;
        font-weight: 700;
    }

    .outstanding-penalty-label {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.08em;
        color: #b45309;
    }

    .outstanding-penalty-card h2 {
        margin: 4px 0;
        font-size: 26px;
        color: #92400e;
    }

    .outstanding-penalty-card p {
        margin: 0;
        color: #78350f;
    }

    .penalty-pay-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 12px 20px;
        border-radius: 10px;
        background: #f59e0b;
        color: white;
        text-decoration: none;
        font-weight: 700;
        white-space: nowrap;
        transition: 0.2s ease;
    }

    .penalty-pay-button:hover {
        background: #d97706;
        color: white;
        transform: translateY(-1px);
    }

    @@media (max-width: 768px) {
        .outstanding-penalty-card {
            flex-direction: column;
            align-items: stretch;
        }

        .penalty-pay-button {
            width: 100%;
        }
    }
</style>