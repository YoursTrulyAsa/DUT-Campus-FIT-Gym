@model IEnumerable<DUT_Campus_FIT_Gym.Models.WorkoutPlan>

@{
    ViewData["Title"] = "My Workout Plan";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>My Workout Plan</h1>
            <p class="text-muted">
                Your personalised workout plan.
            </p>
        </div>

        <a asp-controller="Workout"
           asp-action="CreateProfile"
           class="btn btn-primary me-2">
            Create / Regenerate Plan
        </a>

        <a asp-controller="Member"
           asp-action="Dashboard"
           class="btn btn-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row">

            @foreach (var workout in Model)
            {
                <div class="col-md-6 mb-4">

                    <div class="card shadow-sm h-100">

                        <div class="card-body">

                            <h4 class="card-title">
                                @workout.WorkoutName
                            </h4>

                            <h5 class="mt-3">
                                @workout.ExerciseName
                            </h5>

                            <p>
                                <strong>Day:</strong>
                                @workout.WorkoutDay
                            </p>

                            <p>
                                <strong>Sets:</strong>
                                @workout.Sets
                            </p>

                            <p>
                                <strong>Repetitions:</strong>
                                @workout.Repetitions
                            </p>

                            <p>
                                <strong>Rest:</strong>
                                @workout.RestTime seconds
                            </p>

                            <p class="text-muted">
                                @workout.Description
                            </p>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="alert alert-info">
            You do not have a workout plan yet.
        </div>

        <a asp-controller="Workout"
           asp-action="CreateProfile"
           class="btn btn-primary">
            Create Workout Plan
        </a>
    }

</div>
