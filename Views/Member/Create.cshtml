@model DUT_Campus_FIT_Gym.Models.MembershipPage

@{
    ViewData["Title"] = "Create Membership";
}

<div class="membership-page">

    <div class="membership-card">

        <h2 class="membership-title">
            Create Membership
        </h2>

        <form asp-controller="Member"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <!-- USER DETAILS -->

            <div class="membership-section">

                <h4 class="membership-section-title">
                    User Details
                </h4>

                <hr class="membership-divider" />

                <div class="user-detail">
                    <label asp-for="Name">Name</label>
                    <input asp-for="Name" readonly />
                </div>

                <div class="user-detail">
                    <label asp-for="Surname">Surname</label>
                    <input asp-for="Surname" readonly />
                </div>

                <div class="user-detail">
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" readonly />
                </div>

                <div class="user-detail">
                    <label asp-for="StudentNo">Student No</label>
                    <input asp-for="StudentNo" readonly />
                </div>

            </div>


            <!-- PAYMENT TYPE -->

            <div class="membership-section">

                <h4 class="membership-section-title">
                    Payment Type
                </h4>

                <hr class="membership-divider" />

                <div class="payment-options">

                    <div class="payment-option">

                        <input asp-for="Payment_Method"
                               type="radio"
                               value="Cash"
                               id="cash"
                               required />

                        <label for="cash">
                            Cash
                        </label>

                    </div>

                    <div class="payment-option">

                        <input asp-for="Payment_Method"
                               type="radio"
                               value="Card"
                               id="card" />

                        <label for="card">
                            Card
                        </label>

                    </div>

                    <div class="payment-option">

                        <input asp-for="Payment_Method"
                               type="radio"
                               value="EFT"
                               id="eft" />

                        <label for="eft">
                            EFT
                        </label>

                    </div>

                </div>

            </div>


            <!-- PAYMENT PLAN -->

            <div class="membership-section payment-plan">

                <h4 class="membership-section-title">
                    Payment Plan
                </h4>

                <hr class="membership-divider" />

                <select asp-for="payments_plan"
                        id="paymentPlan">

                    <option value="Monthly">
                        Monthly
                    </option>

                    <option value="Quarterly">
                        Quarterly
                    </option>

                    <option value="Half_Yearly">
                        Half Yearly
                    </option>

                    <option value="Annually">
                        Annually
                    </option>

                </select>

            </div>


            <!-- FIRST TIME MEMBERSHIP -->

            <div class="membership-section">

                <h4 class="membership-section-title">
                    First Time Membership?
                </h4>

                <hr class="membership-divider" />

                <div class="first-time-options">

                    <div class="first-time-option">

                        <input asp-for="First_Time_Member"
                               type="radio"
                               value="true"
                               id="firstYes" />

                        <label for="firstYes">
                            Yes
                        </label>

                    </div>

                    <div class="first-time-option">

                        <input asp-for="First_Time_Member"
                               type="radio"
                               value="false"
                               id="firstNo"
                               checked />

                        <label for="firstNo">
                            No
                        </label>

                    </div>

                </div>

            </div>


            <!-- PRICE -->

            <div class="membership-price-box">

                <div class="price-row">
                    <span>Membership Price</span>
                    <strong id="basePrice">R150.00</strong>
                </div>

                <div class="price-row discount-row">

                    <span>First-Time Discount</span>

                    <strong id="discount">
                        R0.00
                    </strong>

                </div>

                <hr />

                <div class="price-total">

                    <span>Total To Pay</span>

                    <strong id="finalPrice">
                        R150.00
                    </strong>

                </div>

            </div>


            <!-- CREATE -->

            <button type="submit"
                    class="create-membership-button">

                Create Membership

            </button>

        </form>

    </div>

</div>


<script>

    const prices = {
        Monthly: 150,
        Quarterly: 400,
        Half_Yearly: 700,
        Annually: 1200
    };

    const paymentPlan =
        document.getElementById("paymentPlan");

    const firstTimeOptions =
        document.querySelectorAll(
            'input[name="First_Time_Member"]'
        );

    const basePrice =
        document.getElementById("basePrice");

    const discount =
        document.getElementById("discount");

    const finalPrice =
        document.getElementById("finalPrice");


    function calculatePrice() {

        const plan = paymentPlan.value;

        const price = prices[plan];

        const firstTime =
            document.querySelector(
                'input[name="First_Time_Member"]:checked'
            );

        let discountAmount = 0;

        if (firstTime && firstTime.value === "true") {

            discountAmount = price * 0.10;

        }

        const total = price - discountAmount;


        basePrice.textContent =
            "R" + price.toFixed(2);

        discount.textContent =
            "- R" + discountAmount.toFixed(2);

        finalPrice.textContent =
            "R" + total.toFixed(2);
    }


    paymentPlan.addEventListener(
        "change",
        calculatePrice
    );


    firstTimeOptions.forEach(option => {

        option.addEventListener(
            "change",
            calculatePrice
        );

    });


    calculatePrice();

</script>