@model DUT_Campus_FIT_Gym.ViewModels.MembershipPage

@{
    ViewData["Title"] = "Apply for Membership";
}

<div class="membership-page">

    <div class="membership-container">

        <!-- ========================================== -->
        <!-- HEADER -->
        <!-- ========================================== -->

        <div class="membership-header">

            <div>

                <span class="membership-label">
                    DUT CAMPUS FIT GYM
                </span>

                <h1>
                    Apply for Membership
                </h1>

                <p>
                    Complete the form below to apply for a gym membership.
                </p>

            </div>

        </div>


        <!-- ========================================== -->
        <!-- FORM CARD -->
        <!-- ========================================== -->

        <div class="membership-card">

            <form asp-controller="Member"
                  asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()


                <!-- ========================================== -->
                <!-- VALIDATION -->
                <!-- ========================================== -->

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-4">
                </div>


                <!-- ========================================== -->
                <!-- MEMBER INFORMATION -->
                <!-- ========================================== -->

                <div class="membership-section">

                    <h4 class="membership-section-title">
                        Member Information
                    </h4>

                    <hr class="membership-divider" />


                    <div class="user-detail">

                        <label asp-for="Name">
                            Name
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               readonly />

                    </div>


                    <div class="user-detail">

                        <label asp-for="Surname">
                            Surname
                        </label>

                        <input asp-for="Surname"
                               class="form-control"
                               readonly />

                    </div>


                    <div class="user-detail">

                        <label asp-for="Email">
                            Email
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               readonly />

                    </div>


                    <div class="user-detail">

                        <label asp-for="StudentNo">
                            Student / Staff Number
                        </label>

                        <input asp-for="StudentNo"
                               class="form-control"
                               readonly />

                    </div>

                </div>


                <!-- ========================================== -->
                <!-- MEMBERSHIP PERIOD -->
                <!-- ========================================== -->

                <div class="membership-section">

                    <h4 class="membership-section-title">
                        Membership Period
                    </h4>

                    <hr class="membership-divider" />


                    <div class="user-detail">

                        <label asp-for="MembershipPeriod">
                            Select Membership Period
                        </label>

                        <select asp-for="MembershipPeriod"
                                class="form-control">

                            <option value="">
                                -- Select Membership Period --
                            </option>

                            <option value="Semester">
                                Semester
                            </option>

                            <option value="Annual">
                                Annual
                            </option>

                        </select>

                        <span asp-validation-for="MembershipPeriod"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- ========================================== -->
                <!-- PAYMENT METHOD -->
                <!-- ========================================== -->

                <div class="membership-section">

                    <h4 class="membership-section-title">
                        Payment Method
                    </h4>

                    <hr class="membership-divider" />


                    <div class="payment-options">


                        <div class="payment-option">

                            <input asp-for="PaymentMethod"
                                   type="radio"
                                   value="Cash"
                                   id="cash" />

                            <label for="cash">
                                Cash
                            </label>

                        </div>


                        <div class="payment-option">

                            <input asp-for="PaymentMethod"
                                   type="radio"
                                   value="Card"
                                   id="card" />

                            <label for="card">
                                Card
                            </label>

                        </div>


                        <div class="payment-option">

                            <input asp-for="PaymentMethod"
                                   type="radio"
                                   value="EFT"
                                   id="eft" />

                            <label for="eft">
                                EFT
                            </label>

                        </div>

                    </div>


                    <span asp-validation-for="PaymentMethod"
                          class="text-danger">
                    </span>

                </div>


                <!-- ========================================== -->
                <!-- VERIFICATION DOCUMENT -->
                <!-- ========================================== -->

                <div class="membership-section">

                    <h4 class="membership-section-title">
                        Verification Document
                    </h4>

                    <hr class="membership-divider" />


                    <p>
                        Please upload your DUT student/staff card
                        for verification.
                    </p>


                    <div class="user-detail">

                        <label asp-for="VerificationDocument">
                            Student / Staff Card
                        </label>

                        <input asp-for="VerificationDocument"
                               type="file"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.pdf" />

                    </div>


                    <span asp-validation-for="VerificationDocument"
                          class="text-danger">
                    </span>


                    <small class="text-muted">
                        Accepted files: JPG, JPEG, PNG or PDF.
                        Maximum size: 5 MB.
                    </small>

                </div>


                <!-- ========================================== -->
                <!-- MEMBERSHIP PRICE -->
                <!-- ========================================== -->

                <div class="membership-price-box">

                    <div class="price-row">

                        <span>
                            Membership Price
                        </span>

                        <strong id="membershipPrice">
                            Select a membership period
                        </strong>

                    </div>

                </div>


                <!-- ========================================== -->
                <!-- SUBMIT -->
                <!-- ========================================== -->

                <div class="membership-actions">

                    <button type="submit"
                            class="create-membership-button">

                        <i class="bi bi-check-circle"></i>

                        Submit Membership Application

                    </button>


                    <a asp-action="Membership"
                       class="membership-back-btn">

                        <i class="bi bi-arrow-left"></i>

                        Back to Membership

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


    <script>

        const membershipPeriod =
            document.getElementById("MembershipPeriod");

        const membershipPrice =
            document.getElementById("membershipPrice");


        function updatePrice() {

            if (!membershipPeriod) {
                return;
            }

            const selected =
                membershipPeriod.value;


            if (selected === "Semester") {

                membershipPrice.textContent =
                    "R250.00";

            }
            else if (selected === "Annual") {

                membershipPrice.textContent =
                    "R500.00";

            }
            else {

                membershipPrice.textContent =
                    "Select a membership period";

            }
        }


        membershipPeriod.addEventListener(
            "change",
            updatePrice
        );


        updatePrice();

    </script>

}