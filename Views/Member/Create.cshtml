@model DUT_Campus_FIT_Gym.ViewModels.MembershipPage

@{
    ViewData["Title"] = "Apply for Membership";
}

<div class="membership-page">

    <div class="membership-container">

        <!-- ========================================== -->
        <!-- HEADER -->
        <!-- ========================================== -->

        <div class="membership-header">

            <div>

                <span class="membership-label">
                    DUT CAMPUS FIT GYM
                </span>

                <h1>
                    Apply for Membership
                </h1>

                <p>
                    Complete the form below to apply for a gym membership.
                </p>

            </div>

        </div>


        <!-- ========================================== -->
        <!-- FORM CARD -->
        <!-- ========================================== -->

        <div class="membership-card">

        <h2 class="membership-title">
            Create Membership
        </h2>

        @if (Model.IsRenewal)
        {
            <div class="alert alert-info">
                <strong>Membership Renewal</strong>
                <br />
                You have previously registered for a gym membership.
                The first-time membership discount is therefore not available.
            </div>
        }

        <div asp-validation-summary="All"
             class="text-danger mb-3">
        </div>

        <form asp-controller="Member"
              asp-action="Create"
              method="post">
            <form asp-controller="Member"
                  asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()


                <!-- ========================================== -->
                <!-- VALIDATION -->
                <!-- ========================================== -->

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-4">
                </div>


                <!-- ========================================== -->
                <!-- MEMBER INFORMATION -->
                <!-- ========================================== -->

                <div class="membership-section">

                    <h4 class="membership-section-title">
                        Member Information
                    </h4>

                    <hr class="membership-divider" />

                <div class="user-detail">
                    <label asp-for="Name">Name</label>
                    <input asp-for="Name"
                           readonly />
                </div>

                <div class="user-detail">
                    <label asp-for="Surname">Surname</label>
                    <input asp-for="Surname"
                           readonly />
                </div>

                <div class="user-detail">
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email"
                           readonly />
                </div>

                <div class="user-detail">
                    <label asp-for="StudentNo">Student No</label>
                    <input asp-for="StudentNo"
                           readonly />
                </div>

                </div>


                <!-- ========================================== -->
                <!-- PAYMENT METHOD -->
                <!-- ========================================== -->

                <div class="membership-section">

                    <h4 class="membership-section-title">
                        Payment Method
                    </h4>

                    <hr class="membership-divider" />


                    <div class="payment-options">


                        <div class="payment-option">

                        <input asp-for="Payment_Method"
                               type="radio"
                               value="Card"
                               id="card"
                               required />

                        <label for="card">
                            Card
                        </label>

                        </div>


                        <div class="payment-option">

                            <input asp-for="PaymentMethod"
                                   type="radio"
                                   value="EFT"
                                   id="eft" />

                            <label for="eft">
                                EFT
                            </label>

                        </div>

                </div>

                <span asp-validation-for="Payment_Method"
                      class="text-danger">
                </span>

            </div>


                    <span asp-validation-for="PaymentMethod"
                          class="text-danger">
                    </span>

                </div>


                <!-- ========================================== -->
                <!-- VERIFICATION DOCUMENT -->
                <!-- ========================================== -->

                <div class="membership-section">

                    <h4 class="membership-section-title">
                        Verification Document
                    </h4>

                    <hr class="membership-divider" />

                @if (Model.CanClaimFirstTimeDiscount)
                {
                    <div class="first-time-options">

                        <div class="first-time-option">
                    <p>
                        Please upload your DUT student/staff card
                        for verification.
                    </p>


                    <div class="user-detail">

                        <label asp-for="VerificationDocument">
                            Student / Staff Card
                        </label>
                            <label for="firstYes">
                                Yes
                            </label>

                        <input asp-for="VerificationDocument"
                               type="file"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.pdf" />

                    </div>

                        <div class="first-time-option">

                            <input asp-for="First_Time_Member"
                                   type="radio"
                                   value="false"
                                   id="firstNo"
                                   checked />

                            <label for="firstNo">
                                No
                            </label>
                    <span asp-validation-for="VerificationDocument"
                          class="text-danger">
                    </span>

                        </div>

                    </div>

                    <small class="text-muted">
                        Accepted files: JPG, JPEG, PNG or PDF.
                        Maximum size: 5 MB.
                    </small>
                    <small class="text-muted">
                        First-time members receive a 10% discount.
                    </small>
                }
                else
                {
                    <div class="alert alert-secondary mb-0">

                        You have previously registered for a gym membership.

                        <br />

                        <strong>
                            First-time membership discount:
                            Not available
                        </strong>

                    </div>
                }

                </div>


                <!-- ========================================== -->
                <!-- MEMBERSHIP PRICE -->
                <!-- ========================================== -->

                <div class="membership-price-box">

                <div class="price-row">

                    <span>
                        Membership Price
                    </span>

                    <strong id="basePrice">
                        R150.00
                    </strong>

                </div>

                <div class="price-row discount-row">

                        <span>
                            Membership Price
                        </span>
                    <span>
                        First-Time Discount
                    </span>

                        <strong id="membershipPrice">
                            Select a membership period
                        </strong>

                    </div>

                <hr />

                <div class="price-total">

                    <span>
                        Total To Pay
                    </span>

                    <strong id="finalPrice">
                        R150.00
                    </strong>

                </div>


                <!-- ========================================== -->
                <!-- SUBMIT -->
                <!-- ========================================== -->

                <div class="membership-actions">

                    <button type="submit"
                            class="create-membership-button">

                        <i class="bi bi-check-circle"></i>

                        Submit Membership Application

                    </button>


                    <a asp-action="Membership"
                       class="membership-back-btn">

                        <i class="bi bi-arrow-left"></i>

                        Back to Membership

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {
    const canClaimFirstTimeDiscount =
        @(Model.CanClaimFirstTimeDiscount ? "true" : "false");


    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

        const plan =
            paymentPlan.value;

        const price =
            prices[plan];

        let discountAmount = 0;

        if (canClaimFirstTimeDiscount) {
    <script>

            const firstTime =
                document.querySelector(
                    'input[name="First_Time_Member"]:checked'
                );
        const membershipPeriod =
            document.getElementById("MembershipPeriod");

        const membershipPrice =
            document.getElementById("membershipPrice");


        function updatePrice() {
            if (firstTime &&
                firstTime.value === "true") {

            if (!membershipPeriod) {
                return;
            }
                discountAmount =
                    price * 0.10;
            }
        }

            const selected =
                membershipPeriod.value;
        const total =
            price - discountAmount;


            if (selected === "Semester") {

                membershipPrice.textContent =
                    "R250.00";

            }
            else if (selected === "Annual") {

                membershipPrice.textContent =
                    "R500.00";

            }
            else {

                membershipPrice.textContent =
                    "Select a membership period";

            }
        }


        membershipPeriod.addEventListener(
            "change",
            updatePrice
        );


        updatePrice();

    </script>

}