@model DUT_Campus_FIT_Gym.ViewModels.MembershipPage

@{
    ViewData["Title"] = "Apply for Membership";

    bool firstTimeMember =
        ViewBag.IsFirstTimeMember != null &&
        (bool)ViewBag.IsFirstTimeMember;

    string memberRole =
        ViewBag.MemberRole?.ToString() ?? "Student";

    decimal annualPrice =
        memberRole.Equals("Staff", StringComparison.OrdinalIgnoreCase)
            ? 340m
            : 300m;

    decimal semesterPrice =
        memberRole.Equals("Staff", StringComparison.OrdinalIgnoreCase)
            ? 170m
            : 150m;

    decimal discountPercentage =
        firstTimeMember
            ? memberRole.Equals("Staff", StringComparison.OrdinalIgnoreCase)
                ? 6m
                : 10m
            : 0m;

    bool semester1Available =
        ViewBag.Semester1Available != null &&
        (bool)ViewBag.Semester1Available;

    bool semester2Available =
        ViewBag.Semester2Available != null &&
        (bool)ViewBag.Semester2Available;

    bool annualAvailable =
        ViewBag.AnnualAvailable != null &&
        (bool)ViewBag.AnnualAvailable;
}

<div class="membership-page">

    <div class="membership-container">

        <div class="membership-header">

            <div>

                <span class="membership-label">
                    DUT CAMPUS FIT GYM
                </span>

                <h1>
                    Apply for Membership
                </h1>

                <p>
                    Complete the form below to apply for a gym membership.
                </p>

            </div>

        </div>

        <div class="membership-card">

            <h2 class="membership-title">
                Create Membership
            </h2>

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-4">
            </div>

            @if (firstTimeMember)
            {
                <div class="alert alert-success mb-4">

                    <strong>
                        🎉 First-Time Member Discount
                    </strong>

                    <p class="mb-0">
                        Welcome to DUT Campus FIT Gym!
                        You qualify for a
                        <strong>@discountPercentage% discount</strong>
                        on your first membership.
                    </p>

                </div>
            }

            <form asp-controller="Member"
                  asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div class="membership-section">

                    <h4 class="membership-section-title">
                        Member Information
                    </h4>

                    <hr class="membership-divider" />

                    <div class="user-detail">

                        <label asp-for="Name">
                            Name
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               readonly />

                    </div>

                    <div class="user-detail">

                        <label asp-for="Surname">
                            Surname
                        </label>

                        <input asp-for="Surname"
                               class="form-control"
                               readonly />

                    </div>

                    <div class="user-detail">

                        <label asp-for="Email">
                            Email
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               readonly />

                    </div>

                    <div class="user-detail">

                        <label asp-for="StudentNo">
                            Student / Staff No
                        </label>

                        <input asp-for="StudentNo"
                               class="form-control"
                               readonly />

                    </div>

                    <div class="user-detail">

                        <label>
                            Member Type
                        </label>

                        <input class="form-control"
                               value="@memberRole"
                               readonly />

                    </div>

                </div>

                <div class="membership-section">

                    <h4 class="membership-section-title">
                        Membership Period
                    </h4>

                    <hr class="membership-divider" />

                    <div class="user-detail">

                        <label asp-for="MembershipPeriod">
                            Membership Period
                        </label>

                        <select asp-for="MembershipPeriod"
                                id="MembershipPeriod"
                                class="form-control">

                            <option value="">
                                Select membership period
                            </option>

                            <option value="Semester1"
                                    disabled="@(!semester1Available)">
                                Semester 1
                                @if (!semester1Available)
                                {
                                    <text> - Currently Unavailable</text>
                                }
                            </option>

                            <option value="Semester2"
                                    disabled="@(!semester2Available)">
                                Semester 2
                                @if (!semester2Available)
                                {
                                    <text> - Currently Unavailable</text>
                                }
                            </option>

                            <option value="Annual"
                                    disabled="@(!annualAvailable)">
                                Annual
                                @if (!annualAvailable)
                                {
                                    <text> - Currently Unavailable</text>
                                }
                            </option>

                        </select>

                        <span asp-validation-for="MembershipPeriod"
                              class="text-danger">
                        </span>

                        <small class="text-muted d-block mt-2">
                            Semester 1 is available during the first semester period.
                            Semester 2 is available during the second semester period.
                            Annual membership is available during the academic year.
                        </small>

                    </div>

                </div>

                <div class="membership-section">

                    <h4 class="membership-section-title">
                        Payment Method
                    </h4>

                    <hr class="membership-divider" />

                    <div class="payment-options">

                        <div class="payment-option">

                            <input asp-for="PaymentMethod"
                                   type="radio"
                                   value="Card"
                                   id="card" />

                            <label for="card">
                                Card
                            </label>

                        </div>

                        <div class="payment-option">

                            <input asp-for="PaymentMethod"
                                   type="radio"
                                   value="EFT"
                                   id="eft" />

                            <label for="eft">
                                EFT
                            </label>

                        </div>

                    </div>

                    <span asp-validation-for="PaymentMethod"
                          class="text-danger">
                    </span>

                </div>

                <div class="membership-section">

                    <h4 class="membership-section-title">
                        Verification Document
                    </h4>

                    <hr class="membership-divider" />

                    <p>
                        Please upload your DUT student/staff card
                        for verification.
                    </p>

                    <div class="user-detail">

                        <label asp-for="VerificationDocument">
                            Student / Staff Card
                        </label>

                        <input asp-for="VerificationDocument"
                               type="file"
                               class="form-control"
                               accept=".jpg,.jpeg,.png,.pdf" />

                        <span asp-validation-for="VerificationDocument"
                              class="text-danger">
                        </span>

                    </div>

                    <small class="text-muted">
                        Accepted files: JPG, JPEG, PNG or PDF.
                        Maximum size: 5 MB.
                    </small>

                </div>

                <div class="membership-price-box">

                    <div class="price-row">

                        <span>
                            Membership Price
                        </span>

                        <strong id="membershipPrice">
                            Select a membership period
                        </strong>

                    </div>

                    @if (firstTimeMember)
                    {
                        <div class="price-row">

                            <span>
                                First-Time Discount
                            </span>

                            <strong id="membershipDiscount">
                                -
                            </strong>

                        </div>
                    }

                    <hr />

                    <div class="price-total">

                        <span>
                            Total
                        </span>

                        <strong id="membershipTotal">
                            Select a membership period
                        </strong>

                    </div>

                    <div class="price-row mt-2">

                        <span>
                            Application Status
                        </span>

                        <strong>
                            Pending Approval
                        </strong>

                    </div>

                </div>

                <div class="membership-actions">

                    <button type="submit"
                            class="create-membership-button">

                        <i class="bi bi-check-circle"></i>

                        Submit Membership Application

                    </button>

                    <a asp-controller="Member"
                       asp-action="Membership"
                       class="membership-back-btn">

                        <i class="bi bi-arrow-left"></i>

                        Back to Membership

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        const membershipPeriod =
            document.getElementById("MembershipPeriod");

        const membershipPrice =
            document.getElementById("membershipPrice");

        const membershipDiscount =
            document.getElementById("membershipDiscount");

        const membershipTotal =
            document.getElementById("membershipTotal");

        const prices = {
            Semester1: @semesterPrice,
            Semester2: @semesterPrice,
            Annual: @annualPrice
                };

        const availablePeriods = {
            Semester1: @semester1Available.ToString().ToLower(),
            Semester2: @semester2Available.ToString().ToLower(),
            Annual: @annualAvailable.ToString().ToLower()
                };

        const firstTimeMember =
                    @(firstTimeMember.ToString().ToLower());

        const discountPercentage =
                    @discountPercentage;

        function updatePrice() {

            if (!membershipPeriod ||
                !membershipPrice ||
                !membershipTotal) {

                return;
            }

            const selected =
                membershipPeriod.value;

            if (selected &&
                prices[selected] &&
                availablePeriods[selected]) {

                const basePrice =
                    prices[selected];

                let discount = 0;

                if (firstTimeMember) {

                    discount =
                        basePrice *
                        (discountPercentage / 100);

                }

                const finalPrice =
                    basePrice - discount;

                membershipPrice.textContent =
                    "R" + basePrice.toFixed(2);

                membershipTotal.textContent =
                    "R" + finalPrice.toFixed(2);

                if (membershipDiscount) {

                    membershipDiscount.textContent =
                        "-R" + discount.toFixed(2);

                }

            } else {

                membershipPrice.textContent =
                    "Select a membership period";

                membershipTotal.textContent =
                    "Select a membership period";

                if (membershipDiscount) {

                    membershipDiscount.textContent =
                        "-";

                }

            }
        }

        if (membershipPeriod) {

            membershipPeriod.addEventListener(
                "change",
                updatePrice
            );

        }

        updatePrice();

    </script>

}