@{
    ViewData["Title"] = "Request Trainer";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header">
            <h3>Request Trainer Assistance</h3>
        </div>

        <div class="card-body">

            @if (TempData["TrainerRequestSuccess"] != null)
            {
                <div class="alert alert-success">
                    @TempData["TrainerRequestSuccess"]
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @Html.ValidationSummary(false)
                </div>
            }

            <form asp-action="RequestTrainer"
                  asp-controller="Member"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">

                    <label class="form-label">
                        Select Trainer
                    </label>

                    <select name="trainerId"
                            class="form-select"
                            required>

                        <option value="">
                            -- Select a Trainer --
                        </option>

                        @foreach (var trainer in ViewBag.Trainers)
                        {
                            <option value="@trainer.TrainerId">
                                @trainer.TrainerName
                            </option>
                        }

                    </select>

                </div>


                <div class="mb-3">

                    <label class="form-label">
                        What assistance do you need?
                    </label>

                    <textarea name="requestMessage"
                              class="form-control"
                              rows="5"
                              maxlength="500"
                              placeholder="Explain what you need help with..."
                              required></textarea>

                </div>


                <button type="submit"
                        class="btn btn-primary">

                    Send Request

                </button>

                <a asp-action="Dashboard"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>