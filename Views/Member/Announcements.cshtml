@model IEnumerable<DUT_Campus_FIT_Gym.Models.Announcement>

<link rel="stylesheet" href="~/css/announcements.css" />

<div class="announcements-page">

    <div class="announcements-header">
        <div>
            <span class="page-label">GYM UPDATES</span>
            <h1>Announcements</h1>
            <p>Stay updated with the latest news, events and gym information.</p>
        </div>

        <div class="announcement-icon">
            <i class="bi bi-megaphone-fill"></i>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-announcements">
            <i class="bi bi-megaphone"></i>
            <h3>No announcements yet</h3>
            <p>There are currently no updates from the gym.</p>
        </div>
    }
    else
    {
        var groupedAnnouncements = Model
        .GroupBy(a => a.Category)
        .OrderBy(g => g.Key);

        <div class="announcement-groups">

            @foreach (var group in groupedAnnouncements)
            {
                <section class="announcement-group">

                    <div class="category-header">
                        <div class="category-icon">
                            <i class="bi bi-megaphone-fill"></i>
                        </div>

                        <div>
                            <h2>@group.Key</h2>
                            <span>
                                @group.Count() announcement@(group.Count() == 1 ? "" : "s")
                            </span>
                        </div>
                    </div>

                    <div class="announcements-list">

                        @foreach (var announcement in group.OrderByDescending(a => a.DatePosted))
                        {
                            <div class="announcement-card">

                                <div class="announcement-card-top">

                                    <div class="announcement-title-section">

                                        <div class="announcement-small-icon">
                                            <i class="bi bi-megaphone-fill"></i>
                                        </div>

                                        <div>
                                            <h3>@announcement.Title</h3>

                                            <span class="announcement-category">
                                                @announcement.Category
                                            </span>
                                        </div>

                                    </div>

                                    <div class="announcement-date">
                                        <i class="bi bi-calendar3"></i>
                                        @announcement.DatePosted.ToString("dd MMM yyyy")
                                    </div>

                                </div>

                                <div class="announcement-message">
                                    @announcement.Message
                                </div>

                            </div>
                        }

                    </div>

                </section>
            }

        </div>
    }

</div>