@model IEnumerable<DUT_Campus_FIT_Gym.Models.Announcement>

@{
    ViewData["Title"] = "Announcements";
}

<div class="member-page">

    <div class="member-page-header">

        <div>
            <span class="member-page-label">DUT CAMPUS FIT GYM</span>
            <h1>Announcements</h1>
            <p>Stay up to date with the latest gym news and updates.</p>
        </div>

    </div>

    <div class="member-announcements">

        @if (!Model.Any())
        {
            <div class="announcement-empty">

                <div class="empty-icon">
                    <i class="fa-regular fa-bell"></i>
                </div>

                <h3>No announcements</h3>

                <p>
                    There are currently no announcements from the gym.
                </p>

            </div>
        }
        else
        {
            foreach (var announcement in Model)
            {
                <div class="member-announcement-card">

                    <div class="announcement-card-header">

                        <div class="announcement-icon">
                            <i class="fa-solid fa-bullhorn"></i>
                        </div>

                        <div class="announcement-heading">

                            <h2>
                                @announcement.Title
                            </h2>

                            <div class="announcement-meta">

                                <span>
                                    <i class="fa-regular fa-calendar"></i>
                                    @announcement.DatePosted.ToString("dd MMM yyyy")
                                </span>

                                <span>
                                    <i class="fa-regular fa-clock"></i>
                                    @announcement.DatePosted.ToString("HH:mm")
                                </span>

                            </div>

                        </div>

                        <span class="announcement-category">
                            @announcement.Category
                        </span>

                    </div>

                    <div class="announcement-card-body">

                        <p>
                            @announcement.Message
                        </p>

                    </div>

                </div>
            }
        }

    </div>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/announcements.css"
          asp-append-version="true" />
}
