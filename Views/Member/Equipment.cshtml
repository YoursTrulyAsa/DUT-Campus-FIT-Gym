@model IEnumerable<DUT_Campus_FIT_Gym.Models.Equipment>

@{
    ViewData["Title"] = "Equipment";

    var activeReservations =
        ViewBag.ActiveReservations
        as List<DUT_Campus_FIT_Gym.Models.Reservation>
        ?? new List<DUT_Campus_FIT_Gym.Models.Reservation>();
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/member-equipment.css"
          asp-append-version="true" />
}

<div class="equipment-page">

    <div class="equipment-header">

        <div>

            <h1>
                Gym Equipment
            </h1>

            <p>
                View available equipment and reserve what you need.
            </p>

        </div>

    </div>


    <!-- SUCCESS MESSAGE -->
    @if (TempData["EquipmentSuccess"] != null)
    {
        <div class="alert alert-success">

            @TempData["EquipmentSuccess"]

        </div>
    }


    <!-- ERROR MESSAGE -->
    @if (TempData["EquipmentError"] != null)
    {
        <div class="alert alert-danger">

            @TempData["EquipmentError"]

        </div>
    }


    <div class="equipment-grid">

        @if (Model == null || !Model.Any())
        {
            <div class="equipment-empty">

                <h3>
                    No Equipment Available
                </h3>

                <p>
                    There is currently no gym equipment listed.
                </p>

            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                var activeReservation =
                    activeReservations.FirstOrDefault(r =>
                        r.EquipmentID == item.EquipmentID &&
                        r.Status == "Reserved" &&
                        r.EndTime > DateTime.Now);


                <div class="equipment-card">

                    <!-- EQUIPMENT ICON -->

                    <div class="equipment-icon">
                        🏋️
                    </div>


                    <!-- EQUIPMENT INFORMATION -->

                    <div class="equipment-info">

                        <h3>
                            @item.EquipmentName
                        </h3>

                        <p class="equipment-category">
                            @item.Category
                        </p>

                        <p class="equipment-location">
                            📍 @item.Location
                        </p>


                        <!-- STATUS -->
                        @if (activeReservation == null)
                        {
                            <span class="status available">
                                ● Available
                            </span>

                            <div class="small text-success mt-1">
                                Ready to use
                            </div>
                        }
                        else
                        {
                            <span class="status unavailable">
                                ● Reserved
                            </span>


                            <!-- COUNTDOWN -->

                            <div class="countdown-container">

                                Available in:

                                <strong class="countdown"
                                        data-end-time="@activeReservation.EndTime.ToString("o")">

                                    --:--

                                </strong>

                            </div>


                            <div class="small text-muted">

                                Available again at:

                                <strong>
                                    @activeReservation.EndTime.ToString("HH:mm")
                                </strong>

                            </div>
                        }

                    </div>


                    <!-- ACTION -->

                    <div class="equipment-action">

                        @if (activeReservation == null)
                        {
                            <form asp-controller="Equipment"
                                  asp-action="Reserve"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@item.EquipmentID" />

                                <button type="submit"
                                        class="reserve-btn">

                                    Reserve Equipment

                                </button>

                            </form>
                        }
                        else
                        {
                            <button type="button"
                                    class="reserve-btn disabled"
                                    disabled>

                                Currently Reserved

                            </button>
                        }

                    </div>

                </div>
            }
        }

    </div>

</div>


<!-- =========================================================
     LIVE COUNTDOWN
     ========================================================= -->

<script>

    let countdownTimer;


    function updateCountdowns() {

        const countdowns =
            document.querySelectorAll(".countdown");


        const now =
            new Date().getTime();


        let reservationExpired = false;


        countdowns.forEach(function(element) {

            const endTime =
                new Date(
                    element.dataset.endTime
                ).getTime();


            const difference =
                endTime - now;


            // =========================================
            // EXPIRED
            // =========================================

            if (difference <= 0) {

                element.textContent = "00:00";

                reservationExpired = true;

                return;
            }


            // =========================================
            // REMAINING TIME
            // =========================================

            const totalSeconds =
                Math.floor(
                    difference / 1000
                );


            const minutes =
                Math.floor(
                    totalSeconds / 60
                );


            const seconds =
                totalSeconds % 60;


            element.textContent =
                minutes
                    .toString()
                    .padStart(2, "0")
                + ":"
                + seconds
                    .toString()
                    .padStart(2, "0");

        });


        // =========================================
        // REFRESH WHEN RESERVATION EXPIRES
        // =========================================

        if (reservationExpired) {

            clearInterval(countdownTimer);

            location.reload();

        }

    }


    // Run immediately

    updateCountdowns();


    // Update every second

    countdownTimer =
        setInterval(
            updateCountdowns,
            1000
        );

</script>