@model DUT_Campus_FIT_Gym.ViewModels.CheckInViewModel

@{
    ViewData["Title"] = "Gym Check-In";
}

<div class="checkin-page">


    <div class="checkin-header">

        <div>

            <span class="checkin-label">
                DUT CAMPUS FIT GYM
            </span>

            <h1>
                Gym Check-In
            </h1>

            <p>
                Choose how you would like to check in.
            </p>

        </div>

        <div class="checkin-icon">
            <i class="bi bi-door-open-fill"></i>
        </div>

    </div>

    @if (TempData["CheckInSuccess"] != null)
    {
        <div class="checkin-alert success">

            <div class="alert-icon">
                <i class="bi bi-check-circle-fill"></i>
            </div>

            <div>
                <strong>Check-In Successful</strong>

                <p>
                    @TempData["CheckInSuccess"]
                </p>
            </div>

        </div>
    }

    @if (TempData["CheckInError"] != null)
    {
        <div class="checkin-alert error">

            <div class="alert-icon">
                <i class="bi bi-exclamation-circle-fill"></i>
            </div>

            <div>
                <strong>Check-In Unsuccessful</strong>

                <p>
                    @TempData["CheckInError"]
                </p>
            </div>

        </div>
    }

    @if (Model.IsCheckedIn)
    {
        <div class="current-checkin-card">

            <div class="current-status-icon">
                <i class="bi bi-person-check-fill"></i>
            </div>

            <div class="current-status-content">

                <span class="status-label">
                    CURRENT STATUS
                </span>

                <h2>
                    You are checked in
                </h2>

                @if (Model.CheckInTime.HasValue)
                {
                    <p>
                        Checked in at
                        <strong>
                            @Model.CheckInTime.Value.ToString("dd MMM yyyy, HH:mm")
                        </strong>
                    </p>
                }

            </div>

            <form asp-action="CheckOut"
                  method="post"
                  class="checkout-form">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="checkout-button">

                    <i class="bi bi-box-arrow-right"></i>

                    Check Out

                </button>

            </form>

        </div>
    }

    @if (!Model.IsCheckedIn)
    {
        <div class="checkin-options">


            <div class="checkin-card">

                <div class="checkin-card-icon qr-icon">
                    <i class="bi bi-qr-code-scan"></i>
                </div>

                <span class="option-label">
                    QUICK CHECK-IN
                </span>

                <h2>
                    Scan QR Code
                </h2>

                <p>
                    Scan the official DUT Campus FIT Gym QR code
                    to verify your membership and check in.
                </p>

                <button type="button"
                        id="startScanner"
                        class="checkin-button primary">

                    <i class="bi bi-camera-fill"></i>

                    Scan QR Code

                </button>

            </div>


            <div class="checkin-divider">

                <span>
                    OR
                </span>

            </div>

            <div class="checkin-card">

                <div class="checkin-card-icon card-icon">
                    <i class="bi bi-person-vcard-fill"></i>
                </div>

                <span class="option-label">
                    DIGITAL MEMBER CARD
                </span>

                <h2>
                    Use Virtual Card
                </h2>

                <p>
                    Display your Virtual Gym Card and present
                    your barcode at the gym entrance scanner.
                </p>

                <a asp-action="GymCard"
                   class="checkin-button secondary">

                    <i class="bi bi-credit-card-2-front-fill"></i>

                    Use Virtual Card

                </a>

            </div>

        </div>
    }


    <div id="scannerSection"
         class="scanner-section">

        <div class="scanner-header">

            <div>

                <span class="scanner-label">
                    GYM ENTRANCE SCANNER
                </span>

                <h2>
                    Scan Gym QR Code
                </h2>

                <p>
                    Position the QR code inside the scanning box.
                </p>

            </div>

            <button type="button"
                    id="closeScanner"
                    class="close-scanner">

                <i class="bi bi-x-lg"></i>

            </button>

        </div>


        <div class="scanner-camera-container">

            <div id="qr-reader"></div>

        </div>


        <div id="scannerStatus"
             class="scanner-status">

            <i class="bi bi-camera"></i>

            Camera is ready when you start scanning.

        </div>

    </div>

    <div id="checkinResult"
         class="checkin-result">
    </div>

</div>


@section Styles {

    <link rel="stylesheet"
          href="~/css/checkin.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/checkin-result.css"
          asp-append-version="true" />

}


@section Scripts {

    <script src="https://unpkg.com/html5-qrcode"
            type="text/javascript">
    </script>

    <script>

        const startScanner =
            document.getElementById("startScanner");

        const closeScanner =
            document.getElementById("closeScanner");

        const scannerSection =
            document.getElementById("scannerSection");

        const scannerStatus =
            document.getElementById("scannerStatus");

        let qrScanner = null;



        if (startScanner) {

            startScanner.addEventListener("click", function () {

                scannerSection.style.display = "block";

                scannerSection.scrollIntoView({
                    behavior: "smooth",
                    block: "center"
                });

                startScanner.disabled = true;

                startScanner.innerHTML =
                    '<i class="bi bi-camera-fill"></i> Scanner Open';

                scannerStatus.innerHTML =
                    '<i class="bi bi-hourglass-split"></i> Opening camera...';


                qrScanner =
                    new Html5Qrcode("qr-reader");


                qrScanner.start(

                    {
                        facingMode: "environment"
                    },

                    {
                        fps: 10,

                        qrbox: {
                            width: 250,
                            height: 250
                        }
                    },

                    function (decodedText) {

                        scannerStatus.innerHTML =
                            '<i class="bi bi-check-circle-fill"></i> QR code detected. Verifying membership...';

                        stopScanner();

                        verifyQrCode(decodedText);

                    },

                    function () {

                        // Ignore scanning errors
                        // while camera searches.

                    }

                ).catch(function () {

                    scannerStatus.innerHTML =
                        '<i class="bi bi-exclamation-circle-fill"></i> Unable to access the camera. Please allow camera access.';

                    startScanner.disabled = false;

                    startScanner.innerHTML =
                        '<i class="bi bi-camera-fill"></i> Try Again';

                });

            });

        }


        if (closeScanner) {

            closeScanner.addEventListener("click", function () {

                stopScanner();

                scannerSection.style.display = "none";

                if (startScanner) {

                    startScanner.disabled = false;

                    startScanner.innerHTML =
                        '<i class="bi bi-camera-fill"></i> Scan QR Code';

                }

            });

        }

        function stopScanner() {

            if (qrScanner) {

                qrScanner.stop()
                    .then(function () {

                        qrScanner.clear();

                        qrScanner = null;

                    })
                    .catch(function () {

                        qrScanner = null;

                    });

            }

        }


        function verifyQrCode(qrData) {

            const form =
                document.createElement("form");

            form.method = "POST";

            form.action =
                "@Url.Action("VerifyQrCheckIn", "Member")";

            const token =
                document.querySelector(
                    'input[name="__RequestVerificationToken"]'
                );


            if (token) {

                const tokenInput =
                    document.createElement("input");

                tokenInput.type = "hidden";

                tokenInput.name =
                    "__RequestVerificationToken";

                tokenInput.value =
                    token.value;

                form.appendChild(tokenInput);

            }


            const qrInput =
                document.createElement("input");

            qrInput.type = "hidden";

            qrInput.name =
                "qrData";

            qrInput.value =
                qrData;

            form.appendChild(qrInput);


            document.body.appendChild(form);

            form.submit();

        }

    </script>

}