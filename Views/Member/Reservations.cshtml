@model IEnumerable<DUT_Campus_FIT_Gym.ViewModels.ReservationViewModel>

@{
    ViewData["Title"] = "My Reservations";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/member-reservations.css"
          asp-append-version="true" />
}

<div class="reservations-page">

    <!-- ========================================= -->
    <!-- PAGE HEADER -->
    <!-- ========================================= -->

    <div class="page-header">

        <div>

            <span class="page-label">
                DUT CAMPUS FIT GYM
            </span>

            <h1>
                My Reservations
            </h1>

            <p>
                Manage the equipment you have reserved.
            </p>

        </div>

        <a asp-controller="Member"
           asp-action="Equipment"
           class="btn reserve-more-btn">

            <i class="fa-solid fa-plus"></i>

            Browse Equipment

        </a>

    </div>


    <!-- ========================================= -->
    <!-- SUCCESS MESSAGE -->
    <!-- ========================================= -->
    @if (TempData["EquipmentSuccess"] != null)
    {
        <div class="alert alert-success">

            <i class="fa-solid fa-circle-check"></i>

            <span>
                @TempData["EquipmentSuccess"]
            </span>

        </div>
    }


    <!-- ========================================= -->
    <!-- ERROR MESSAGE -->
    <!-- ========================================= -->
    @if (TempData["EquipmentError"] != null)
    {
        <div class="alert alert-warning">

            <i class="fa-solid fa-triangle-exclamation"></i>

            <span>
                @TempData["EquipmentError"]
            </span>

        </div>
    }


    <!-- ========================================= -->
    <!-- RESERVATIONS TABLE -->
    <!-- ========================================= -->
    @if (Model != null && Model.Any())
    {
        <div class="reservation-table-container">

            <div class="table-responsive">

                <table class="table reservation-table align-middle">

                    <thead>

                        <tr>

                            <th>
                                Equipment
                            </th>

                            <th>
                                Reserved At
                            </th>

                            <th>
                                Ends At
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Time Remaining
                            </th>

                            <th>
                                Action
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var reservation in Model)
                        {
                            <tr>

                                <!-- EQUIPMENT -->

                                <td>

                                    <div class="equipment-name">

                                        <i class="fa-solid fa-dumbbell"></i>

                                        <strong>
                                            @reservation.EquipmentName
                                        </strong>

                                    </div>

                                </td>


                                <!-- RESERVED AT -->

                                <td>

                                    @reservation.ReservationDate.ToString(
                                    "dd MMM yyyy HH:mm")

                        </td>


                        <!-- END TIME -->

                        <td>

                            @if (reservation.EndTime > DateTime.MinValue)
                                    {
                                        @reservation.EndTime.ToString(
                                        "dd MMM yyyy HH:mm")
                                                        }
                                    else
                                    {
                                        <span class="text-danger">
                                            Not set
                                        </span>
                                    }

                                </td>


                                <!-- STATUS -->

                                <td>

                                    @if (reservation.Status == "Reserved")
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else if (reservation.Status == "Expired")
                                    {
                                        <span class="badge bg-secondary">
                                            Expired
                                        </span>
                                    }
                                    else if (reservation.Status == "Cancelled")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Cancelled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @reservation.Status
                                        </span>
                                    }

                                </td>


                                <!-- ================================= -->
                                <!-- COUNTDOWN -->
                                <!-- ================================= -->

                                <td>

                                    @if (reservation.Status == "Reserved"
                                                                && reservation.EndTime > DateTime.Now)
                                    {
                                        <span class="countdown fw-bold text-danger"
                                              data-end-time="@reservation.EndTime.ToUniversalTime().ToString("o")">

                                            10:00

                                        </span>
                                    }
                                    else if (reservation.Status == "Expired")
                                    {
                                        <span class="text-secondary">
                                            Expired
                                        </span>
                                    }
                                    else if (reservation.Status == "Cancelled")
                                    {
                                        <span class="text-muted">
                                            Cancelled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">
                                            Expired
                                        </span>
                                    }

                                </td>


                                <!-- ================================= -->
                                <!-- ACTION -->
                                <!-- ================================= -->

                                <td>

                                    @if (reservation.Status == "Reserved"
                                                                && reservation.EndTime > DateTime.Now)
                                    {
                                        <form asp-controller="Member"
                                              asp-action="Unreserve"
                                              method="post">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="reservationId"
                                                   value="@reservation.ReservationID" />

                                            <button type="submit"
                                                    class="btn unreserve-btn">

                                                <i class="fa-solid fa-xmark"></i>

                                                Unreserve

                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No action
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }
    else
    {
        <!-- ========================================= -->
        <!-- NO RESERVATIONS -->
        <!-- ========================================= -->

        <div class="empty-reservations">

            <div class="empty-icon">

                <i class="fa-solid fa-dumbbell"></i>

            </div>

            <h2>
                No Reservations Yet
            </h2>

            <p>
                You don't have any equipment reservations
                at the moment.
            </p>

            <a asp-controller="Member"
               asp-action="Equipment"
               class="btn reserve-more-btn">

                <i class="fa-solid fa-dumbbell"></i>

                Browse Equipment

            </a>

        </div>
    }


    <!-- ========================================= -->
    <!-- INFORMATION -->
    <!-- ========================================= -->

    <div class="alert alert-info mt-4">

        <strong>
            Reservation Information
        </strong>

        <ul class="mb-0 mt-2">

            <li>
                Your equipment reservation lasts for
                <strong>10 minutes</strong>.
            </li>

            <li>
                You can cancel your reservation at any time
                before it expires.
            </li>

            <li>
                After the reservation expires, the equipment
                becomes available for other students.
            </li>

        </ul>

    </div>

</div>


<!-- ========================================= -->
<!-- LIVE COUNTDOWN -->
<!-- ========================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        function updateCountdowns() {

            const countdowns =
                document.querySelectorAll(".countdown");


            countdowns.forEach(function (element) {

                const endTimeString =
                    element.getAttribute("data-end-time");


                if (!endTimeString) {

                    element.textContent = "Expired";

                    return;
                }


                const endTime =
                    new Date(endTimeString).getTime();


                const now =
                    Date.now();


                const difference =
                    endTime - now;


                // =====================================
                // EXPIRED
                // =====================================

                if (difference <= 0) {

                    element.textContent =
                        "Expired";

                    element.classList.remove(
                        "text-danger"
                    );

                    element.classList.add(
                        "text-secondary"
                    );

                    return;
                }


                // =====================================
                // CALCULATE TIME
                // =====================================

                const totalSeconds =
                    Math.floor(difference / 1000);


                const minutes =
                    Math.floor(totalSeconds / 60);


                const seconds =
                    totalSeconds % 60;


                // =====================================
                // DISPLAY
                // =====================================

                element.textContent =
                    "⏱️ " +
                    String(minutes).padStart(2, "0") +
                    ":" +
                    String(seconds).padStart(2, "0") +
                    " remaining";

            });

        }


        // Run immediately
        updateCountdowns();


        // Update every second
        setInterval(
            updateCountdowns,
            1000
        );

    });

</script>