@model IEnumerable<DUT_Campus_FIT_Gym.Models.TrainerRequest>

@{
    ViewData["Title"] = "My Trainer Requests";
}

<div class="container mt-5">

    <!-- HEADER -->

    <div class="mb-4">

        <span class="text-muted">
            DUT CAMPUS FIT GYM
        </span>

        <h1 class="mt-2">
            My Trainer Requests
        </h1>

        <p class="text-muted">
            Track the status of your trainer assistance requests.
        </p>

    </div>


    <!-- SUCCESS MESSAGE -->
    @if (TempData["TrainerRequestSuccess"] != null)
    {
        <div class="alert alert-success">
            @TempData["TrainerRequestSuccess"]
        </div>
    }


    <!-- ERROR MESSAGE -->
    @if (TempData["TrainerRequestError"] != null)
    {
        <div class="alert alert-danger">
            @TempData["TrainerRequestError"]
        </div>
    }


    <!-- NO REQUESTS -->
    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm">

            <div class="card-body text-center p-5">

                <div class="mb-3">

                    <i class="bi bi-person-workspace"
                       style="font-size: 50px;">
                    </i>

                </div>

                <h4>
                    No Trainer Requests
                </h4>

                <p class="text-muted">
                    You have not requested assistance from a
                    trainer yet.
                </p>

                <a asp-controller="Member"
                   asp-action="RequestTrainer"
                   class="btn btn-primary">

                    <i class="bi bi-person-plus"></i>

                    Request a Trainer

                </a>

            </div>

        </div>
    }
    else
    {
        <!-- REQUESTS -->

        <div class="row">

            @foreach (var request in Model)
            {
                string badgeClass = "bg-secondary";

                string statusIcon = "bi-info-circle";

                if (request.Status == "Pending")
                {
                    badgeClass = "bg-warning text-dark";
                    statusIcon = "bi-hourglass-split";
                }
                else if (request.Status == "Accepted")
                {
                    badgeClass = "bg-success";
                    statusIcon = "bi-check-circle";
                }
                else if (request.Status == "Rejected")
                {
                    badgeClass = "bg-danger";
                    statusIcon = "bi-x-circle";
                }
                else if (request.Status == "Completed")
                {
                    badgeClass = "bg-primary";
                    statusIcon = "bi-check2-all";
                }


                <div class="col-md-6 mb-4">

                    <div class="card h-100 shadow-sm">

                        <!-- CARD HEADER -->

                        <div class="card-header d-flex justify-content-between align-items-center">

                            <strong>
                                Trainer Request
                            </strong>

                            <span class="badge @badgeClass">

                                <i class="bi @statusIcon"></i>

                                @request.Status

                            </span>

                        </div>


                        <!-- CARD BODY -->

                        <div class="card-body">

                            <!-- TRAINER -->

                            <div class="mb-3">

                                <small class="text-muted">
                                    TRAINER
                                </small>

                                <h5 class="mb-0">

                                    @(request.Trainer?.TrainerName
                                        ?? "Trainer unavailable")

                                </h5>

                            </div>


                            <!-- REQUEST DATE -->

                            <div class="mb-3">

                                <small class="text-muted">
                                    REQUEST DATE
                                </small>

                                <div>

                                    @request.RequestDate.ToString(
                                        "dd MMM yyyy HH:mm")

                                </div>

                            </div>


                            <!-- MESSAGE -->

                            <div class="mb-3">

                                <small class="text-muted">
                                    YOUR MESSAGE
                                </small>

                                <div class="mt-1">

                                    @request.RequestMessage

                                </div>

                            </div>


                            <!-- RESPONSE DATE -->
                            @if (request.ResponseDate.HasValue)
                            {
                                <div class="mb-3">

                                    <small class="text-muted">
                                        RESPONSE DATE
                                    </small>

                                    <div>

                                        @request.ResponseDate.Value.ToString(
                                            "dd MMM yyyy HH:mm")

                                    </div>

                                </div>
                            }
                            <!-- COMPLETION DATE -->
                            @if (request.CompletionDate.HasValue)
                            {
                                <div class="mb-3">

                                    <small class="text-muted">
                                        COMPLETION DATE
                                    </small>

                                    <div>
                                        @request.CompletionDate.Value.ToString(
                                            "dd MMM yyyy HH:mm")
                                    </div>

                                </div>
                            }


                            <!-- STATUS MESSAGE -->
                            @if (request.Status == "Pending")
                            {
                                <div class="alert alert-warning mb-0">

                                    <i class="bi bi-hourglass-split"></i>

                                    Your request is waiting for the
                                    trainer to respond.

                                </div>
                            }
                            else if (request.Status == "Accepted")
                            {
                                <div class="alert alert-success mb-0">

                                    <i class="bi bi-check-circle"></i>

                                    Your trainer request has been
                                    accepted. Your trainer can now
                                    assist you.

                                </div>
                            }
                            else if (request.Status == "Rejected")
                            {
                                <div class="alert alert-danger mb-0">

                                    <i class="bi bi-x-circle"></i>

                                    Your trainer request was rejected.
                                    You may request another trainer.

                                </div>
                            }
                            else if (request.Status == "Completed")
                            {
                                <div class="alert alert-primary mb-0">

                                    <i class="bi bi-check2-all"></i>

                                    This trainer session has been
                                    completed.

                                </div>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>


        <!-- REQUEST ANOTHER TRAINER -->

        <div class="mt-2 mb-5">

            <a asp-controller="Member"
               asp-action="RequestTrainer"
               class="btn btn-primary">

                <i class="bi bi-person-plus"></i>

                Request a Trainer

            </a>

        </div>
    }


    <!-- BACK TO DASHBOARD -->

    <div class="mb-5">

        <a asp-controller="Member"
           asp-action="Dashboard"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left"></i>

            Back to Dashboard

        </a>

    </div>

</div>
