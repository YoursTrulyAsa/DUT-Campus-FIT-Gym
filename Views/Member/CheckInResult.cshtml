@{
    ViewData["Title"] = "Check-In Result";

    var successMessage = TempData["CheckInSuccess"];
    var errorMessage = TempData["CheckInError"];
}

<div class="checkin-result-page">

    <div class="result-header">

        <span class="result-label">
            DUT CAMPUS FIT GYM
        </span>

        <h1>
            Check-In Result
        </h1>

        <p>
            Your gym access verification result.
        </p>

    </div>


    @if (successMessage != null)
    {
        <div class="result-card success">

            <div class="result-icon">

                <i class="bi bi-check-lg"></i>

            </div>

            <div class="result-content">

                <span class="result-status">
                    ACCESS GRANTED
                </span>

                <h3>
                    Check-In Successful
                </h3>

                <p>
                    @successMessage
                </p>

            </div>

            <div class="result-action">

                <a asp-controller="Member"
                   asp-action="CheckIn">

                    Continue

                </a>

            </div>

        </div>
    }
    else if (errorMessage != null)
    {
        <div class="result-card denied">

            <div class="result-icon">

                <i class="bi bi-x-lg"></i>

            </div>

            <div class="result-content">

                <span class="result-status">
                    ACCESS DENIED
                </span>

                <h3>
                    Check-In Unsuccessful
                </h3>

                <p>
                    @errorMessage
                </p>

            </div>

            <div class="result-action">

                <a asp-controller="Member"
                   asp-action="CheckIn">

                    Try Again

                </a>

            </div>

        </div>
    }
    else
    {
        <div class="result-card invalid">

            <div class="result-icon">

                <i class="bi bi-info-lg"></i>

            </div>

            <div class="result-content">

                <span class="result-status">
                    NO RESULT
                </span>

                <h3>
                    No Check-In Result
                </h3>

                <p>
                    No check-in result is currently available.
                    Return to the check-in page to try again.
                </p>

            </div>

            <div class="result-action">

                <a asp-controller="Member"
                   asp-action="CheckIn">

                    Go to Check-In

                </a>

            </div>

        </div>
    }


    <div class="result-back">

        <a asp-controller="Member"
           asp-action="Dashboard">

            <i class="bi bi-arrow-left"></i>

            Back to Dashboard

        </a>

    </div>

</div>


@section Styles {

    <link rel="stylesheet"
          href="~/css/checkin-result.css"
          asp-append-version="true" />

}