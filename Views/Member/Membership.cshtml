@model Membership

@{
    ViewData["Title"] = "My Membership";
}

<div class="container mt-4">
    <h2>My Gym Membership</h2>

    @if (Model == null)
    {
        <div class="alert alert-warning">
            <p>You don't have an active membership.</p>
            <a href="@Url.Action("Create", "Member")" class="btn btn-primary">Purchase Membership</a>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-header @(Model.Status == "Active" ? "bg-success" : Model.Status == "WaitingForPayment" ? "bg-warning" : "bg-danger")">
                <h4 class="mb-0 text-white">Membership Status: @Model.Status</h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Membership Type</dt>
                    <dd class="col-sm-8">@Model.MembershipType</dd>

                    <dt class="col-sm-4">Price</dt>
                    <dd class="col-sm-8">R @Model.Price.ToString("0.00")</dd>

                    <dt class="col-sm-4">Start Date</dt>
                    <dd class="col-sm-8">
                        @(Model.StartDate.HasValue? Model.StartDate.Value.ToString("MMMM dd, yyyy") : "Not yet active")
                    </dd>

                    <dt class="col-sm-4">End Date</dt>
                    <dd class="col-sm-8">
                        @(Model.EndDate.HasValue? Model.EndDate.Value.ToString("MMMM dd, yyyy") : "Not yet active")
                    </dd>

                    @if (Model.Status == "WaitingForPayment")
                    {
                        <dt class="col-sm-4">Action</dt>
                        <dd class="col-sm-8">
                            <a href="@Url.Action("Index", "Banking", new { membershipId = Model.MembershipId })"
                               class="btn btn-success">
                                <i class="fas fa-credit-card"></i> Pay Now
                            </a>
                            <span class="text-muted ml-2">Complete your payment to activate membership</span>
                        </dd>
                    }
                    else if (Model.Status == "Active" && Model.EndDate.HasValue)
                    {
                        <dt class="col-sm-4">Days Remaining</dt>
                        <dd class="col-sm-8">
                            @{
                                var daysRemaining = (Model.EndDate.Value - DateTime.Today).Days;
                                <span>@daysRemaining days</span>
                            }
                        </dd>
                    }
                </dl>
            </div>
        </div>
    }
</div>