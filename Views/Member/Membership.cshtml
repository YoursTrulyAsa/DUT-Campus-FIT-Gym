@model DUT_Campus_FIT_Gym.Models.Membership

@{
    ViewData["Title"] = "My Membership";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var pendingApplication = ViewBag.PendingApplication;

    bool hasMembership = Model != null;

    bool isActive =
        Model != null &&
        Model.Status == "Active" &&
        Model.EndDate.HasValue &&
        Model.EndDate.Value.Date >= DateTime.Today;

    int daysRemaining = 0;

    if (isActive && Model!.EndDate.HasValue)
    {
        daysRemaining = Math.Max(
            0,
            (Model.EndDate.Value.Date - DateTime.Today).Days
        );
    }

    string statusClass = Model?.Status switch
    {
        "Active" => "status-active",
        "WaitingForPayment" => "status-payment",
        "Pending" => "status-pending",
        "Rejected" => "status-rejected",
        _ => "status-inactive"
    };
}

<div class="membership-page">

    <!-- ====================================================== -->
    <!-- PAGE HEADER -->
    <!-- ====================================================== -->

    <div class="membership-header">

        <div>

            <span class="membership-label">
                DUT CAMPUS FIT GYM
            </span>

            <h1>
                My Gym Membership
            </h1>

            <p>
                View and manage your current gym membership.
            </p>

        </div>

    </div>


    <!-- ====================================================== -->
    <!-- SUCCESS MESSAGE -->
    <!-- ====================================================== -->
    @if (TempData["MembershipSuccess"] != null)
    {
        <div class="alert alert-success">

            <i class="bi bi-check-circle-fill"></i>

            <span>
                @TempData["MembershipSuccess"]
            </span>

        </div>
    }


    <!-- ====================================================== -->
    <!-- ERROR MESSAGE -->
    <!-- ====================================================== -->
    @if (TempData["MembershipError"] != null)
    {
        <div class="alert alert-warning">

            <i class="bi bi-exclamation-triangle-fill"></i>

            <span>
                @TempData["MembershipError"]
            </span>

        </div>
    }


    <!-- ====================================================== -->
    <!-- PENDING / WAITING FOR PAYMENT APPLICATION -->
    <!-- ====================================================== -->
    @if (pendingApplication != null)
    {
        <div class="membership-card">

            <div class="membership-status-panel
                     @(pendingApplication.Status == "WaitingForPayment"
                                      ? "payment"
                                      : "active")">

            <div class="status-icon">

                @if (pendingApplication.Status == "WaitingForPayment")
                    {
                        <i class="bi bi-credit-card-fill"></i>
                    }
                    else
                    {
                        <i class="bi bi-hourglass-split"></i>
                    }

                </div>


                <div>

                    <span>
                        MEMBERSHIP APPLICATION
                    </span>

                    @if (pendingApplication.Status == "WaitingForPayment")
                    {
                        <strong>
                            Approved - Payment Required
                        </strong>

                        <p>
                            Your membership application has been approved.
                            Please complete your payment to activate your
                            gym membership.
                        </p>
                    }
                    else
                    {
                        <strong>
                            Application Pending
                        </strong>

                        <p>
                            Your membership application has been submitted
                            successfully and is waiting for admin approval.
                        </p>
                    }

            </div>

        </div>


        <!-- ================================================== -->
        <!-- APPLICATION DETAILS -->
        <!-- ================================================== -->

        <div class="membership-details-grid">

            <!-- APPLICATION DATE -->

            <div class="membership-detail">

                <div class="detail-icon">
                    <i class="bi bi-calendar-check"></i>
                </div>

                <div>

                    <span>
                        APPLICATION DATE
                    </span>

                    <strong>
                        @pendingApplication.ApplicationDate.ToString("dd MMM yyyy")
                    </strong>

                </div>

            </div>


            <!-- MEMBERSHIP PERIOD -->

            <div class="membership-detail">

                <div class="detail-icon">
                    <i class="bi bi-card-checklist"></i>
                </div>

                <div>

                    <span>
                        MEMBERSHIP PERIOD
                    </span>

                    <strong>
                        @pendingApplication.MembershipType
                    </strong>

                </div>

            </div>


            <!-- MEMBERSHIP FEE -->

            <div class="membership-detail">

                <div class="detail-icon">
                    <i class="bi bi-cash-stack"></i>
                </div>

                <div>

                    <span>
                        MEMBERSHIP FEE
                    </span>

                    <strong>
                        R @pendingApplication.Price.ToString("0.00")
                    </strong>

                </div>

            </div>


            <!-- STATUS -->

            <div class="membership-detail">

                <div class="detail-icon">
                    <i class="bi bi-info-circle"></i>
                </div>

                <div>

                    <span>
                        STATUS
                    </span>

                    <strong>
                        @(
                                                pendingApplication.Status == "WaitingForPayment"
                                                ? "Approved - Waiting for Payment"
                                                : pendingApplication.Status
                                                )
                    </strong>

                    </div>

                </div>

            </div>


            <!-- ================================================== -->
            <!-- PAYMENT BUTTON -->
            <!-- ================================================== -->
        @if (pendingApplication.Status == "WaitingForPayment")
            {
                <div class="membership-actions">

                    <a asp-controller="Banking"
                       asp-action="Index"
                       asp-route-membershipApplicationId="@pendingApplication.MembershipApplicationId"
                       class="payment-btn">

                        <i class="fa-solid fa-credit-card"></i>

                        <span>
                            Pay Membership Fee
                        </span>

                        <i class="fa-solid fa-arrow-right"></i>

                    </a>

                </div>
            }

        </div>
    }


    <!-- ====================================================== -->
    <!-- NO MEMBERSHIP / NO APPLICATION -->
    <!-- ====================================================== -->
    @if (pendingApplication == null && !hasMembership)
    {
        <div class="membership-card">

            <div class="membership-status-panel expired">

                <div class="status-icon">

                    <i class="bi bi-exclamation-lg"></i>

                </div>

                <div>

                    <span>
                        MEMBERSHIP STATUS
                    </span>

                    <strong>
                        No Active Membership
                    </strong>

                    <p>
                        You do not currently have an active gym membership.
                        Apply for a membership to access the
                        DUT Campus FIT Gym.
                    </p>

                </div>

            </div>


            <!-- ================================================== -->
            <!-- MEMBERSHIP PRICES -->
            <!-- ================================================== -->

            <div class="membership-pricing">

                <div class="pricing-card">

                    <span>
                        SEMESTER
                    </span>

                    <strong>
                        R150.00
                    </strong>

                    <small>
                        Per semester
                    </small>

                </div>


                <div class="pricing-card">

                    <span>
                        ANNUAL
                    </span>

                    <strong>
                        R300.00
                    </strong>

                    <small>
                        Per year
                    </small>

                </div>

            </div>


            <!-- ================================================== -->
            <!-- FIRST-TIME DISCOUNT -->
            <!-- ================================================== -->

            <div class="first-time-discount">

                <i class="bi bi-stars"></i>

                <div>

                    <strong>
                        First-Time Member?
                    </strong>

                    <p>
                        Get 10% off your first membership.
                    </p>

                </div>

            </div>


            <!-- ================================================== -->
            <!-- APPLY -->
            <!-- ================================================== -->

            <div class="membership-actions">

                <a asp-controller="Member"
                   asp-action="Create"
                   class="btn btn-primary">

                    <i class="bi bi-plus-circle"></i>

                    <span>
                        Apply for Membership
                    </span>

                </a>

            </div>

        </div>
    }


    <!-- ====================================================== -->
    <!-- EXISTING MEMBERSHIP -->
    <!-- ====================================================== -->
    @if (hasMembership)
    {
        <div class="membership-card">

            <!-- ================================================== -->
            <!-- MEMBERSHIP CARD HEADER -->
            <!-- ================================================== -->

            <div class="membership-card-top">

                <div>

                    <span class="card-small-label">
                        DUT CAMPUS FIT GYM
                    </span>

                    <span class="card-small-label">
                        MEMBERSHIP PLAN
                    </span>

                    <h2>
                        @Model!.MembershipType
                    </h2>

                    <p>
                        Gym Membership
                    </p>

                </div>


                <div class="membership-logo-icon">

                    <i class="fa-solid fa-dumbbell"></i>

                </div>

            </div>


            <!-- ================================================== -->
            <!-- STATUS -->
            <!-- ================================================== -->

            <div class="membership-status-row">

                <span class="membership-status @statusClass">

                    <span class="status-dot"></span>

                    @(
                                    Model.Status == "WaitingForPayment"
                                    ? "Waiting for Payment"
                                    : Model.Status
                                    )

                </span>

            </div>


            <!-- ================================================== -->
            <!-- PRICE -->
            <!-- ================================================== -->

            <div class="membership-price">

                <span>
                    Membership Fee
                </span>

                <strong>
                    R @Model.Price.ToString("0.00")
                </strong>

            </div>

        </div>


        <!-- ====================================================== -->
        <!-- MEMBERSHIP INFORMATION -->
        <!-- ====================================================== -->

        <div class="membership-info-grid">

            <!-- START DATE -->

            <div class="membership-info-card">

                <div class="info-icon">

                    <i class="fa-regular fa-calendar-plus"></i>

                </div>

                <div>

                    <span>
                        Start Date
                    </span>

                    <strong>

                        @(Model.StartDate.HasValue
                                            ? Model.StartDate.Value.ToString("dd MMM yyyy")
                                            : "Not yet active")

                    </strong>

                </div>

            </div>


            <!-- END DATE -->

            <div class="membership-info-card">

                <div class="info-icon">

                    <i class="fa-regular fa-calendar-xmark"></i>

                </div>

                <div>

                    <span>
                        End Date
                    </span>

                    <strong>

                        @(Model.EndDate.HasValue
                                            ? Model.EndDate.Value.ToString("dd MMM yyyy")
                                            : "Not yet active")

                </strong>

                </div>

            </div>


            <!-- DAYS REMAINING -->
        @if (Model.Status == "Active" &&
                Model.EndDate.HasValue)
            {
                <div class="membership-info-card">

                    <div class="info-icon">

                        <i class="fa-solid fa-hourglass-half"></i>

                    </div>

                    <div>

                        <span>
                            Days Remaining
                        </span>

                        <strong>
                            @daysRemaining days
                        </strong>

                    </div>

                </div>
            }


            <!-- MEMBERSHIP TYPE -->

            <div class="membership-info-card">

                <div class="info-icon">

                    <i class="fa-solid fa-layer-group"></i>

                </div>

                <div>

                    <span>
                        Membership Type
                    </span>

                    <strong>
                        @Model.MembershipType
                    </strong>

                </div>

            </div>

        </div>


        <!-- ====================================================== -->
        <!-- PAYMENT REQUIRED -->
        <!-- ====================================================== -->
        @if (Model.Status == "WaitingForPayment")
        {
            <div class="payment-card">

                <div class="payment-icon">

                    <i class="fa-solid fa-credit-card"></i>

                </div>


                <div class="payment-content">

                    <span class="payment-label">
                        PAYMENT REQUIRED
                    </span>

                    <h3>
                        Complete Your Membership Payment
                    </h3>

                    <p>
                        Your membership application has been approved.
                        Complete your payment to activate your membership.
                    </p>

                </div>


                <a asp-controller="Banking"
                   asp-action="Index"
                   asp-route-membershipId="@Model.MembershipId"
                   class="payment-btn">

                    <i class="fa-solid fa-credit-card"></i>

                    <span>
                        Pay Now
                    </span>

                    <i class="fa-solid fa-arrow-right"></i>

                </a>

            </div>
        }


        <!-- ====================================================== -->
        <!-- ACTIVE MEMBERSHIP -->
        <!-- ====================================================== -->
        @if (Model.Status == "Active")
        {
            <div class="notice-card notice-active">

                <div class="notice-icon">

                    <i class="fa-solid fa-circle-check"></i>

                </div>

                <div>

                    <strong>
                        Your Membership Is Active
                    </strong>

                    <p>
                        You're all set! You can use your gym membership
                        and access the available gym facilities.
                    </p>

                </div>

            </div>
        }


        <!-- ====================================================== -->
        <!-- REJECTED MEMBERSHIP -->
        <!-- ====================================================== -->
        @if (Model.Status == "Rejected")
        {
            <div class="notice-card notice-rejected">

                <div class="notice-icon">

                    <i class="fa-solid fa-circle-xmark"></i>

                </div>

                <div>

                    <strong>
                        Membership Application Rejected
                    </strong>

                    <p>
                        Your membership application was not approved.
                        Please contact gym administration for assistance.
                    </p>

                </div>

            </div>
        }

    }

</div>


@section Styles {

    <link rel="stylesheet"
          href="~/css/membership.css"
          asp-append-version="true" />

}