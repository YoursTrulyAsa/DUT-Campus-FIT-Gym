@model DUT_Campus_FIT_Gym.Models.Membership?

@{
    ViewData["Title"] = "My Membership";

    int daysRemaining = 0;
    bool isActive = false;

    if (Model != null)
    {
        daysRemaining = Math.Max(
            0,
            (Model.EndDate.Date - DateTime.Today).Days
        );

        isActive =
            Model.Status == "Active" &&
            Model.EndDate.Date >= DateTime.Today;
    }
    string statusClass = Model?.Status switch
    {
        "Active" => "status-active",
        "WaitingForPayment" => "status-payment",
        "Pending" => "status-pending",
        "Rejected" => "status-rejected",
        _ => "status-inactive"
    };
}

    var pendingApplication = ViewBag.PendingApplication;
}

<div class="membership-page">

    <!-- PAGE HEADER -->
    <div class="membership-header">

        <div>
            <span class="membership-label">
                MEMBERSHIP
            </span>

            <h1>
                My Gym Membership
            </h1>

                <p>
                    View your current gym membership details.
                </p>

            </div>

        </div>


        <!-- ========================================== -->
        <!-- SUCCESS MESSAGE -->
        <!-- ========================================== -->
        @if (TempData["MembershipSuccess"] != null)
        {
            <div class="alert alert-success">
                @TempData["MembershipSuccess"]
            </div>
        }


        <!-- ========================================== -->
        <!-- ERROR MESSAGE -->
        <!-- ========================================== -->
        @if (TempData["MembershipError"] != null)
        {
            <div class="alert alert-warning">
                @TempData["MembershipError"]
            </div>
        }


        <!-- ========================================== -->
        <!-- PENDING APPLICATION -->
        <!-- ========================================== -->
        @if (pendingApplication != null)
        {
            <div class="membership-card">

                <div class="membership-status-panel active">

                    <div class="status-icon">
                        <i class="bi bi-hourglass-split"></i>
                    </div>

                    <div>

                        <span>
                            MEMBERSHIP APPLICATION
                        </span>

                        <strong>
                            Application Pending
                        </strong>

                        <p>
                            Your membership application has been
                            submitted successfully and is waiting
                            for admin approval.
                        </p>

                    </div>

                </div>


                <div class="membership-details-grid">

                    <!-- APPLICATION DATE -->

                    <div class="membership-detail">

                        <div class="detail-icon">
                            <i class="bi bi-calendar-check"></i>
                        </div>

                        <div>

                            <span>
                                APPLICATION DATE
                            </span>

                            <strong>
                                @pendingApplication.ApplicationDate.ToString("dd MMM yyyy")
                            </strong>

                        </div>

                    </div>


                    <!-- MEMBERSHIP PERIOD -->

                    <div class="membership-detail">

                        <div class="detail-icon">
                            <i class="bi bi-card-checklist"></i>
                        </div>

                        <div>

                            <span>
                                MEMBERSHIP PERIOD
                            </span>

                            <strong>
                                @pendingApplication.MembershipType
                            </strong>

                        </div>

                    </div>


                    <!-- STATUS -->

                    <div class="membership-detail">

                        <div class="detail-icon">
                            <i class="bi bi-info-circle"></i>
                        </div>

                        <div>

                            <span>
                                STATUS
                            </span>

                            <strong>
                                Pending
                            </strong>

                        </div>

                    </div>

                </div>

            </div>
        }
        else if (Model == null)
        {
            <!-- ========================================== -->
            <!-- NO MEMBERSHIP -->
            <!-- ========================================== -->

            <div class="membership-card">

                <div class="membership-status-panel expired">

                    <div class="status-icon">
                        <i class="bi bi-exclamation-lg"></i>
                    </div>

                    <div>

                        <span>
                            MEMBERSHIP STATUS
                        </span>

                        <strong>
                            No Membership
                        </strong>

                        <p>
                            You do not currently have a gym membership.
                            Apply for a membership to access the
                            DUT Campus FIT Gym.
                        </p>

                    </div>

                </div>


                <div class="membership-actions">

                    <a asp-action="Create"
                       class="btn btn-primary">

                        <i class="bi bi-plus-circle"></i>

                        Apply for Membership

                    </a>

                </div>

            </div>
        }
        else
        {
            <!-- ========================================== -->
            <!-- EXISTING MEMBERSHIP -->
            <!-- ========================================== -->

            <div class="membership-header">

    </div>
                <div></div>

                <div class="membership-status-badge
                    @(isActive ? "active" : "expired")">

                    <span></span>

                    @(isActive ? "ACTIVE" : "EXPIRED")
    @if (Model == null)
    {
        <!-- NO MEMBERSHIP -->
        <div class="membership-empty">

            <div class="empty-icon">
                <i class="fa-solid fa-id-card"></i>
            </div>

            <h2>
                No Membership Yet
            </h2>

            <p>
                You don't currently have a gym membership.
                Apply for a membership to get access to the DUT Campus FIT Gym.
            </p>

            <a asp-controller="Member"
               asp-action="Create"
               class="membership-btn">

                <i class="fa-solid fa-plus"></i>

                <span>
                    Apply for Membership
                </span>
                <!-- ========================================== -->
                <!-- CARD HEADER -->
                <!-- ========================================== -->

            </a>

                    <div>
        </div>
    }
    else
    {
        <!-- MEMBERSHIP HERO CARD -->
        <div class="membership-card">

            <div class="membership-card-top">

                <div>

                        <span class="card-small-label">
                            MEMBERSHIP PLAN
                        </span>
                    <span class="card-small-label">
                        DUT CAMPUS FIT GYM
                    </span>

                        <h2>
                            @Model.MembershipType
                        </h2>

                    <p>
                        Gym Membership
                    </p>

                </div>


                <div class="membership-logo-icon">
                    <i class="fa-solid fa-dumbbell"></i>
                </div>

                </div>


            <!-- STATUS -->
            <div class="membership-status-row">

                <span class="membership-status @statusClass">

                    <span class="status-dot"></span>

                    @Model.Status

                </span>

            </div>


            <!-- PRICE -->
            <div class="membership-price">

                <span>
                    Membership Fee
                </span>

                <strong>
                    R @Model.Price.ToString("0.00")
                </strong>

            </div>

        </div>


        <!-- MEMBERSHIP INFORMATION -->
        <div class="membership-info-grid">

            <!-- START DATE -->
            <div class="membership-info-card">

                <div class="info-icon">
                    <i class="fa-regular fa-calendar-plus"></i>
                </div>

                <div>
                    <span>
                        Start Date
                    </span>

                    <strong>
                        @(Model.StartDate.HasValue
                                            ? Model.StartDate.Value.ToString("dd MMM yyyy")
                                            : "Not yet active")
                                                           </strong>
                                                       </div>

            </div>


            <!-- END DATE -->
            <div class="membership-info-card">

                <div class="info-icon">
                    <i class="fa-regular fa-calendar-xmark"></i>
                </div>

                <div>
                    <span>
                        End Date
                    </span>

                    <strong>
                        @(Model.EndDate.HasValue
                                            ? Model.EndDate.Value.ToString("dd MMM yyyy")
                                            : "Not yet active")
                </strong>
            </div>

            </div>


            <!-- DAYS REMAINING -->
        @if (Model.Status == "Active" && Model.EndDate.HasValue)
            {
                var daysRemaining =
                Math.Max(0, (Model.EndDate.Value.Date - DateTime.Today).Days);

                <div class="membership-info-card">

                    <div class="info-icon">
                        <i class="fa-solid fa-hourglass-half"></i>
                    </div>

                    <div>
                        <span>
                            Days Remaining
                        </span>

                        <strong>
                            @daysRemaining days
                        </strong>
                    </div>

                </div>
            }


            <!-- MEMBERSHIP TYPE -->
            <div class="membership-info-card">

                <div class="info-icon">
                    <i class="fa-solid fa-layer-group"></i>
                </div>

                <div>
                    <span>
                        Membership Type
                    </span>

                    <strong>
                        @Model.MembershipType
                    </strong>
                </div>

            </div>

        </div>


        <!-- PAYMENT SECTION -->
        @if (Model.Status == "WaitingForPayment")
        {
            <div class="payment-card">

                <div class="payment-icon">
                    <i class="fa-solid fa-credit-card"></i>
                </div>

                <div class="payment-content">

                    <span class="payment-label">
                        PAYMENT REQUIRED
                    </span>

                    <h3>
                        Complete Your Membership Payment
                    </h3>

                    <p>
                        Your membership application has been approved.
                        Complete your payment to activate your membership.
                    </p>

                    </div>

                <a asp-controller="Banking"
                   asp-action="Index"
                   asp-route-membershipId="@Model.MembershipId"
                   class="payment-btn">

                    <i class="fa-solid fa-credit-card"></i>

                    Pay Now

                    <i class="fa-solid fa-arrow-right"></i>

                </a>

            </div>
        }


        <!-- PENDING -->
        @if (Model.Status == "Pending")
        {
            <div class="notice-card notice-pending">

                <div class="notice-icon">
                    <i class="fa-solid fa-clock"></i>
                </div>

                <div>
                    <strong>
                        Membership Under Review
                    </strong>

                    <p>
                        Your membership application has been submitted
                        and is currently waiting for administrator approval.
                    </p>
                </div>

            </div>
        }


        <!-- ACTIVE -->
        @if (Model.Status == "Active")
        {
            <div class="notice-card notice-active">

                <div class="notice-icon">
                    <i class="fa-solid fa-circle-check"></i>
                </div>

                <div>
                    <strong>
                        Your Membership Is Active
                    </strong>

                    <p>
                        You're all set! You can use your gym membership
                        and access the available gym facilities.
                    </p>
                </div>

            </div>
        }


        <!-- REJECTED -->
        @if (Model.Status == "Rejected")
        {
            <div class="notice-card notice-rejected">

                <div class="notice-icon">
                    <i class="fa-solid fa-circle-xmark"></i>
                </div>

                <div>
                    <strong>
                        Membership Application Rejected
                    </strong>

                    <p>
                        Your membership application was not approved.
                        Please contact gym administration for assistance.
                    </p>
                </div>

            </div>
        }

    }

</div>


@section Styles {

    <link rel="stylesheet"
          href="~/css/membership.css"
          asp-append-version="true" />

}