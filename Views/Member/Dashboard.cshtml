@{
    ViewData["Title"] = "Member Dashboard";
}

<div class="member-dashboard">

    <main class="dashboard-content">

        <div class="dashboard-topbar">

            <div>
                <h1>Welcome Back 👋</h1>
                <p>Here's what's happening with your gym membership.</p>
            </div>

            <div class="user-badge">
                <i class="fa-solid fa-user"></i>
                <span>Student</span>
            </div>

        </div>

        <div class="dashboard-stats">

            <div class="stat-card">

                <div class="stat-icon">
                    <i class="fa-solid fa-id-card"></i>
                </div>

                <div>
                    <span>Membership</span>

                    <h3>
                        @(Model.Membership != null ? Model.Membership.Status : "None")
                    </h3>
                </div>

            </div>

            <div class="stat-card">

                <div class="stat-icon">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>

                <div>
                    <span>Attendance</span>

                    <h3>
                        @Model.AttendanceCount Visits
                    </h3>
                </div>

            </div>

            <div class="stat-card">

                <div class="stat-icon">
                    <i class="fa-solid fa-dumbbell"></i>
                </div>

                <div>
                    <span>Reservations</span>
                    <h3>3 Active</h3>
                </div>

            </div>

            <div class="stat-card">

                <div class="stat-icon">
                    <i class="fa-solid fa-credit-card"></i>
                </div>

                <div>
                    <span>Payment</span>
                    <h3>Paid</h3>
                </div>

            </div>

        </div>

        <div class="dashboard-grid">

            <section class="dashboard-card workout-card">

                <div class="card-heading">

                    <div>
                        <span class="card-label">MY WORKOUT</span>
                        <h2>Today's Workout</h2>
                    </div>

                    <i class="fa-solid fa-person-running"></i>

                </div>

                <p class="workout-name">
                    Chest & Triceps
                </p>

                <p class="card-description">
                    Your scheduled workout for today.
                </p>

                <a asp-controller="Member"
                   asp-action="WorkoutPlan"
                   class="btn btn-primary">
                    View Workout
                </a>

            </section>

            <section class="dashboard-card">

                <div class="card-heading">

                    <div>
                        <span class="card-label">MEMBERSHIP</span>
                        <h2>Active Membership</h2>
                    </div>

                    <i class="fa-solid fa-id-card"></i>

                </div>

                @if (Model.Membership != null)
                {
                    <div class="membership-status">

                        <span class="status-dot"></span>

                        @Model.Membership.Status

                    </div>

                    <p class="card-description">
                        Your gym membership is currently
                        @Model.Membership.Status.ToLower().
                    </p>
                }
                else
                {
                    <div class="membership-status">

                        <span class="status-dot"></span>

                        No Membership

                    </div>

                    <p class="card-description">
                        You currently do not have a membership.
                    </p>
                }

                <a asp-controller="Member"
                   asp-action="Membership"
                   class="dashboard-btn">
                    View Membership
                </a>

                <a asp-controller="Member"
                   asp-action="ApplyMembership"
                   class="dashboard-btn">
                    Apply for Membership
                </a>

            </section> 

            <section class="dashboard-card quick-actions-card">

                <div class="card-heading">

                    <div>
                        <span class="card-label">QUICK ACTIONS</span>
                        <h2>What would you like to do?</h2>
                    </div>

                </div>

                <div class="quick-actions">

                    <a asp-controller="Member"
                       asp-action="Reservations">

                        <i class="fa-solid fa-calendar-plus"></i>

                        Reserved Equipment

                    </a>

                    <a asp-controller="Member"
                       asp-action="Attendance">

                        <i class="fa-solid fa-clock"></i>

                        View Attendance

                    </a>

                    <a asp-controller="Member"
                       asp-action="Payments">

                        <i class="fa-solid fa-money-bill"></i>

                        View Payments

                    </a>

                    <a asp-controller="Member"
                       asp-action="Support">

                        <i class="fa-solid fa-headset"></i>

                        Get Support

                    </a>

                </div>

            </section>

        </div>

    </main>

</div>

@section Styles {
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
}