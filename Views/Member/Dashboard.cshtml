@{
    ViewData["Title"] = "Member Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="member-dashboard">

    <div class="dashboard-content">

        <!-- TOP BAR -->
        <div class="dashboard-topbar">

            <div class="dashboard-welcome">

                <span class="dashboard-label">
                    MEMBER DASHBOARD
                </span>

                <h1>
                    Welcome Back, @Model.Member.Name 👋
                </h1>

                <p>
                    Here's what's happening with your gym membership.
                </p>

            </div>

            <div class="user-badge">

                <div class="user-badge-icon">
                    <i class="fa-solid fa-user"></i>
                </div>

                <div>
                    <strong>
                        @Model.Member.Name @Model.Member.Surname
                    </strong>

                    <span>
                        Student
                    </span>
                </div>

            </div>

        </div>


        <!-- DASHBOARD STATS -->
        <div class="dashboard-stats">

            <!-- MEMBERSHIP -->
            <a asp-controller="Member"
               asp-action="Membership"
               class="stat-card stat-card-link">

                <div class="stat-icon">
                    <i class="fa-solid fa-id-card"></i>
                </div>

                <div class="stat-content">

                    <span>
                        Membership
                    </span>

                    <h3>
                        @(Model.Membership != null
                                                ? Model.Membership.Status
                                                : "None")
                    </h3>

                </div>

                <i class="fa-solid fa-chevron-right stat-arrow"></i>

            </a>


            <!-- ATTENDANCE -->
            <a asp-controller="Member"
               asp-action="Attendance"
               class="stat-card stat-card-link">

                <div class="stat-icon">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>

                <div class="stat-content">

                    <span>
                        Attendance
                    </span>

                    <h3>
                        @Model.AttendanceCount
                        @(Model.AttendanceCount == 1 ? "Visit" : "Visits")
                    </h3>

                </div>

                <i class="fa-solid fa-chevron-right stat-arrow"></i>

            </a>


            <!-- RESERVATIONS -->
            <a asp-controller="Member"
               asp-action="Reservations"
               class="stat-card stat-card-link">

                <div class="stat-icon">
                    <i class="fa-solid fa-dumbbell"></i>
                </div>

                <div class="stat-content">

                    <span>
                        Reservations
                    </span>

                    <h3>
                        @Model.ReservationCount Active
                    </h3>

                </div>

                <i class="fa-solid fa-chevron-right stat-arrow"></i>

            </a>


            <!-- ANNOUNCEMENTS -->
            <a asp-controller="Member"
               asp-action="Announcements"
               class="stat-card stat-card-link">

                <div class="stat-icon">
                    <i class="fa-solid fa-bullhorn"></i>
                </div>

                <div class="stat-content">

                    <span>
                        Announcements
                    </span>

                    <h3>
                        Latest Updates
                    </h3>

                </div>

                <i class="fa-solid fa-chevron-right stat-arrow"></i>

            </a>

        </div>


        <!-- MAIN DASHBOARD GRID -->
        <div class="dashboard-grid">


            <!-- WORKOUT -->
            <section class="dashboard-card workout-card">

                <div class="card-heading">

                    <div>

                        <span class="card-label">
                            WORKOUT PLAN
                        </span>

                        <h2>
                            My Workout
                        </h2>

                    </div>

                    <div class="card-icon">
                        <i class="fa-solid fa-person-running"></i>
                    </div>

                </div>


                @if (Model.Workouts != null &&
                                Model.Workouts.Count > 0)
                {
                    var latestWorkout = Model.Workouts[0];

                    <div class="workout-preview">

                        <p class="workout-name">
                            @latestWorkout.WorkoutName
                        </p>

                        <div class="workout-details">

                            <div>
                                <span>Exercise</span>
                                <strong>
                                    @latestWorkout.ExerciseName
                                </strong>
                            </div>

                            <div>
                                <span>Day</span>
                                <strong>
                                    @latestWorkout.WorkoutDay
                                </strong>
                            </div>

                            <div>
                                <span>Sets</span>
                                <strong>
                                    @latestWorkout.Sets
                                </strong>
                            </div>

                            <div>
                                <span>Reps</span>
                                <strong>
                                    @latestWorkout.Repetitions
                                </strong>
                            </div>

                        </div>

                    </div>
                }
                else
                {
                    <div class="empty-state">

                        <div class="empty-state-icon">
                            <i class="fa-solid fa-person-running"></i>
                        </div>

                        <p>
                            No workout plan yet.
                        </p>

                        <span>
                            Your personalized workout plan will appear
                            here once it has been created.
                        </span>

                    </div>
                }


                <a asp-controller="Workout"
                   asp-action="MyWorkout"
                   class="dashboard-btn">

                    <span>View Workout</span>

                    <i class="fa-solid fa-arrow-right"></i>

                </a>

            </section>


            <!-- FITNESS PROFILE -->
            <section class="dashboard-card">

                <div class="card-heading">

                    <div>

                        <span class="card-label">
                            WORKOUT PROFILE
                        </span>

                        <h2>
                            Fitness Profile
                        </h2>

                    </div>

                    <div class="card-icon">
                        <i class="fa-solid fa-clipboard-user"></i>
                    </div>

                </div>


                @if (Model.WorkoutProfile != null)
                {
                    <div class="fitness-profile">

                        <div class="fitness-item">

                            <span>
                                Age
                            </span>

                            <strong>
                                @Model.WorkoutProfile.Age
                            </strong>

                        </div>

                        <div class="fitness-item">

                            <span>
                                Weight
                            </span>

                            <strong>
                                @Model.WorkoutProfile.Weight kg
                            </strong>

                        </div>

                        <div class="fitness-item">

                            <span>
                                Height
                            </span>

                            <strong>
                                @Model.WorkoutProfile.Height cm
                            </strong>

                        </div>

                        <div class="fitness-item">

                            <span>
                                Goal
                            </span>

                            <strong>
                                @Model.WorkoutProfile.Goal
                            </strong>

                        </div>

                    </div>
                }
                else
                {
                    <div class="empty-state">

                        <div class="empty-state-icon">
                            <i class="fa-solid fa-clipboard-user"></i>
                        </div>

                        <p>
                            No fitness profile yet.
                        </p>

                        <span>
                            Create your fitness profile to help
                            personalize your gym experience.
                        </span>

                    </div>
                }


                <a asp-controller="WorkoutProfile"
                   asp-action="Index"
                   class="dashboard-btn">

                    <span>
                        @(Model.WorkoutProfile != null
                                                ? "View Profile"
                                                : "Create Profile")
                    </span>

                    <i class="fa-solid fa-arrow-right"></i>

                </a>

            </section>


            <!-- MEMBERSHIP -->
            <section class="dashboard-card membership-dashboard-card">

                <div class="card-heading">

                    <div>

                        <span class="card-label">
                            MEMBERSHIP
                        </span>

                        <h2>
                            My Membership
                        </h2>

                    </div>

                    <div class="card-icon">
                        <i class="fa-solid fa-id-card"></i>
                    </div>

                </div>


                @if (Model.Membership != null)
                {
                    var membershipStatus =
                    Model.Membership.Status?.ToString() ?? "Unknown";

                    var statusClass =
                    membershipStatus == "Active"
                    ? "active"
                    : membershipStatus == "Pending"
                    ? "pending"
                    : membershipStatus == "WaitingForPayment"
                    ? "waiting"
                    : membershipStatus == "Rejected"
                    ? "rejected"
                    : "inactive";

                    <div class="membership-status @statusClass">

                        <span class="status-dot"></span>

                        <span>
                            @membershipStatus
                        </span>

                    </div>

                    <p class="card-description">

                        @if (membershipStatus == "Active")
                        {
                            <text>
                                Your gym membership is active.
                                You can access the gym and use your
                                membership benefits.
                            </text>
                        }
                        else if (membershipStatus == "WaitingForPayment")
                        {
                            <text>
                                Your membership has been approved.
                                Complete your payment to activate it.
                            </text>
                        }
                        else if (membershipStatus == "Pending")
                        {
                            <text>
                                Your membership application is waiting
                                for admin approval.
                            </text>
                        }
                        else if (membershipStatus == "Rejected")
                        {
                            <text>
                                Your membership application was rejected.
                                Please contact gym administration for
                                more information.
                            </text>
                        }
                        else
                        {
                            <text>
                                Your membership is currently
                                @membershipStatus.ToLower().
                            </text>
                        }

                    </p>
                }
                else
                {
                    <div class="membership-status inactive">

                        <span class="status-dot"></span>

                        <span>
                            No Membership
                        </span>

                    </div>

                    <p class="card-description">
                        You currently do not have a gym membership.
                    </p>
                }


                <a asp-controller="Member"
                   asp-action="Membership"
                   class="dashboard-btn">

                    <span>
                        View Membership
                    </span>

                    <i class="fa-solid fa-arrow-right"></i>

                </a>

            </section>


            <!-- QUICK ACTIONS -->
            <section class="dashboard-card quick-actions-card">

                <div class="card-heading">

                    <div>

                        <span class="card-label">
                            QUICK ACCESS
                        </span>

                        <h2>
                            Gym Access
                        </h2>

                        <p class="quick-actions-description">
                            Access the features you use most.
                        </p>

                    </div>

                    <div class="card-icon">
                        <i class="fa-solid fa-bolt"></i>
                    </div>

                </div>


                <div class="quick-actions">

                    <!-- CHECK IN -->
                    <a asp-controller="Member"
                       asp-action="CheckIn"
                       class="quick-action">

                        <div class="quick-action-icon">
                            <i class="fa-solid fa-qrcode"></i>
                        </div>

                        <div>
                            <strong>
                                Check-In
                            </strong>

                            <span>
                                Enter the gym
                            </span>
                        </div>

                        <i class="fa-solid fa-arrow-right action-arrow"></i>

                    </a>


                    <!-- GYM CARD -->
                    <a asp-controller="Member"
                       asp-action="GymCard"
                       class="quick-action">

                        <div class="quick-action-icon">
                            <i class="fa-solid fa-id-card"></i>
                        </div>

                        <div>
                            <strong>
                                Gym Card
                            </strong>

                            <span>
                                View your digital card
                            </span>
                        </div>

                        <i class="fa-solid fa-arrow-right action-arrow"></i>

                    </a>


                    <!-- EQUIPMENT -->
                    <a asp-controller="Member"
                       asp-action="Equipment"
                       class="quick-action">

                        <div class="quick-action-icon">
                            <i class="fa-solid fa-dumbbell"></i>
                        </div>

                        <div>
                            <strong>
                                Equipment
                            </strong>

                            <span>
                                Check gym equipment
                            </span>
                        </div>

                        <i class="fa-solid fa-arrow-right action-arrow"></i>

                    </a>


                    <!-- TRAINER -->
                    <a asp-controller="Member"
                       asp-action="RequestTrainer"
                       class="quick-action">

                        <div class="quick-action-icon">
                            <i class="fa-solid fa-user-plus"></i>
                        </div>

                        <div>
                            <strong>
                                Request Trainer
                            </strong>

                            <span>
                                Get fitness assistance
                            </span>
                        </div>

                        <i class="fa-solid fa-arrow-right action-arrow"></i>

                    </a>

                </div>

            </section>

        </div>

    </div>

</div>


@section Styles {

    <link rel="stylesheet"
          href="~/css/member-dashboard.css"
          asp-append-version="true" />

}


