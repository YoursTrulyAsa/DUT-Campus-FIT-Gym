@{
    ViewData["Title"] = "Member Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="member-dashboard">

    <div class="dashboard-content">

        <!-- TOP BAR -->
        <div class="dashboard-topbar">

            <div>

                <h1>
                    Welcome Back, @Model.Member.Name 👋
                </h1>

                <p>
                    Here's what's happening with your gym membership.
                </p>

            </div>

            <div class="user-badge">

                <i class="fa-solid fa-user"></i>

                <span>Student</span>

            </div>

        </div>


        <!-- DASHBOARD STATS -->
        <div class="dashboard-stats">

            <!-- MEMBERSHIP -->
            <div class="stat-card">

                <div class="stat-icon">
                    <i class="fa-solid fa-id-card"></i>
                </div>

                <div>

                    <span>Membership</span>

                    <h3>
                        @(Model.Membership != null
                                                ? Model.Membership.Status
                                                : "None")
                    </h3>

                </div>

            </div>


            <!-- ATTENDANCE -->
            <div class="stat-card">

                <div class="stat-icon">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>

                <div>

                    <span>Attendance</span>

                    <h3>
                        @Model.AttendanceCount Visits
                    </h3>

                </div>

            </div>


            <!-- RESERVATIONS -->
            <div class="stat-card">

                <div class="stat-icon">
                    <i class="fa-solid fa-dumbbell"></i>
                </div>

                <div>

                    <span>Reservations</span>

                    <h3>
                        @Model.ReservationCount Active
                    </h3>

                </div>

            </div>


            <!-- ANNOUNCEMENTS -->
            <a asp-controller="Member"
               asp-action="Announcements"
               class="stat-card dashboard-stat-link">

                <div class="stat-icon">
                    <i class="fa-solid fa-bullhorn"></i>
                </div>

                <div>

                    <span>Announcements</span>

                    <h3>
                        Latest Updates
                    </h3>

                </div>

            </a>

        </div>


        <!-- DASHBOARD GRID -->
        <div class="dashboard-grid">


            <!-- WORKOUT -->
            <section class="dashboard-card workout-card">

                <div class="card-heading">

                    <div>

                        <span class="card-label">
                            WORKOUT PLAN
                        </span>

                        <h2>
                            My Workout
                        </h2>

                    </div>

                    <i class="fa-solid fa-person-running"></i>

                </div>

                <p class="workout-name">
                    No workout plan yet
                </p>

                <p class="card-description">
                    Your personalized workout plan will appear here
                    once it has been created.
                </p>

                <a asp-controller="Member"
                   asp-action="WorkoutPlan"
                   class="dashboard-btn">

                    View Workout

                </a>

            </section>


            <!-- MEMBERSHIP -->
            <section class="dashboard-card">

                <div class="card-heading">

                    <div>

                        <span class="card-label">
                            MEMBERSHIP
                        </span>

                        <h2>
                            Active Membership
                        </h2>

                    </div>

                    <i class="fa-solid fa-id-card"></i>

                </div>


                @if (Model.Membership != null)
                {
                    <div class="membership-status">

                        <span class="status-dot"></span>

                        @Model.Membership.Status

                    </div>

                    <p class="card-description">

                        Your gym membership is currently
                        @Model.Membership.Status.ToLower().

                    </p>
                }
                else
                {
                    <div class="membership-status">

                        <span class="status-dot"></span>

                        No Membership

                    </div>

                    <p class="card-description">

                        You currently do not have a membership.

                    </p>
                }


                <a asp-controller="Member"
                   asp-action="Membership"
                   class="dashboard-btn">

                    View Membership

                </a>

            </section>


            <!-- QUICK ACTIONS -->
            <section class="dashboard-card quick-actions-card">

                <div class="card-heading">

                    <div>

                        <span class="card-label">
                            QUICK ACTIONS
                        </span>

                        <h2>
                            What would you like to do?
                        </h2>

                    </div>

                </div>


                <div class="quick-actions">

                    <!-- CHECK-IN -->
                    <a asp-controller="Member"
                       asp-action="CheckIn">

                        <i class="fa-solid fa-qrcode"></i>

                        Check-In

                    </a>


                    <!-- VIRTUAL GYM CARD -->
                    <a asp-controller="Member"
                       asp-action="GymCard">

                        <i class="fa-solid fa-id-card"></i>

                        Virtual Gym Card

                    </a>


                    <!-- RESERVATIONS -->
                    <a asp-controller="Member"
                       asp-action="Reservations">

                        <i class="fa-solid fa-calendar-plus"></i>

                        Reserved Equipment

                    </a>


                    <!-- ATTENDANCE -->
                    <a asp-controller="Member"
                       asp-action="Attendance">

                        <i class="fa-solid fa-clock"></i>

                        View Attendance

                    </a>

                </div>

            </section>

        </div>

    </div>

</div>