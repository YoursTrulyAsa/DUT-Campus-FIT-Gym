@model IEnumerable<DUT_Campus_FIT_Gym.Models.Announcement>

@{
    ViewData["Title"] = "Announcements";
}

<h2>Announcements</h2>

<a asp-action="CreateAnnouncement" class="btn btn-primary mb-3">Create New Announcement</a>

@if (!Model.Any())
{
    <p>No announcements found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Title</th>
                <th>Message</th>
                <th>Date Posted</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var announcement in Model)
            {
                <tr>
                    <td>@announcement.Title</td>
                    <td>@announcement.Message</td>
                    <td>@announcement.DatePosted.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <a asp-action="DetailsAnnouncement" asp-route-id="@announcement.AnnouncementID" class="btn btn-info btn-sm">View</a>
                        <a asp-action="EditAnnouncement" asp-route-id="@announcement.AnnouncementID" class="btn btn-warning btn-sm">Edit</a>
                        <form asp-action="DeleteAnnouncement" asp-route-id="@announcement.AnnouncementID" method="post" style="display:inline">
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
