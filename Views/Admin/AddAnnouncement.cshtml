@model DUT_Campus_FIT_Gym.Models.Announcement

@{
    ViewData["Title"] = "Add Announcement";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-page">

    <div class="admin-page-header">
        <div>
            <span class="admin-page-label">DUT CAMPUS FIT GYM</span>
            <h1>Add Announcement</h1>
            <p>Create an announcement that will be visible to gym members.</p>
        </div>
    </div>

    <div class="admin-form-card">

        <form asp-controller="Admin"
              asp-action="AddAnnouncement"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="form-group">
                <label asp-for="Title">Announcement Title</label>

                <input asp-for="Title"
                       class="form-control"
                       placeholder="e.g. Gym Hours Update" />

                <span asp-validation-for="Title"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group">
                <label asp-for="Category">Category</label>

                <select asp-for="Category"
                        class="form-control">

                    <option value="">Select category</option>
                    <option value="General">General</option>
                    <option value="Gym Update">Gym Update</option>
                    <option value="Maintenance">Maintenance</option>
                    <option value="Event">Event</option>
                    <option value="Important">Important</option>

                </select>

                <span asp-validation-for="Category"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group">
                <label asp-for="Message">Message</label>

                <textarea asp-for="Message"
                          class="form-control announcement-message"
                          rows="7"
                          placeholder="Write your announcement here..."></textarea>

                <span asp-validation-for="Message"
                      class="text-danger">
                </span>
            </div>

            <div class="form-actions">

                <button type="submit"
                        class="btn btn-primary">
                    <i class="fa-solid fa-paper-plane"></i>
                    Publish Announcement
                </button>

                <a asp-controller="Admin"
                   asp-action="Announcements"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin-add-announcement.css"
          asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}