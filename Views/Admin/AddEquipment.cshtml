@model DUT_Campus_FIT_Gym.Models.Equipment

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add Equipment";
}

<div class="admin-equipment-page">
  
    <div class="admin-page-header">

        <div>

            <span class="admin-label">
                EQUIPMENT MANAGEMENT
            </span>

            <h1>
                Add Equipment
            </h1>

            <p>
                Add new equipment to the DUT Campus FIT Gym.
            </p>

        </div>

        <div class="admin-page-header-icon">
            <i class="fa-solid fa-dumbbell"></i>
        </div>

    </div>


    <div class="admin-form-card">

        <div class="admin-form-heading">

            <div class="admin-form-icon">
                <i class="fa-solid fa-plus"></i>
            </div>

            <div>

                <h2>
                    Equipment Details
                </h2>

                <p>
                    Enter the details of the equipment you want to add.
                </p>

            </div>

        </div>


        <form asp-controller="Admin"
              asp-action="AddEquipment"
              method="post">

            @Html.AntiForgeryToken()


            <div asp-validation-summary="ModelOnly"
                 class="admin-validation">
            </div>


            <div class="admin-form-grid">


                <div class="admin-form-group">

                    <label asp-for="EquipmentName">
                        Equipment Name
                    </label>

                    <div class="admin-input-wrapper">

                        <i class="fa-solid fa-dumbbell"></i>

                        <input asp-for="EquipmentName"
                               placeholder="e.g. Treadmill" />

                    </div>

                    <span asp-validation-for="EquipmentName"
                          class="admin-field-error">
                    </span>

                </div>

                <div class="admin-form-group">

                    <label asp-for="Category">
                        Category
                    </label>

                    <div class="admin-input-wrapper">

                        <i class="fa-solid fa-layer-group"></i>

                        <input asp-for="Category"
                               placeholder="e.g. Cardio" />

                    </div>

                    <span asp-validation-for="Category"
                          class="admin-field-error">
                    </span>

                </div>

                <div class="admin-form-group admin-form-full">

                    <label asp-for="Location">
                        Location
                    </label>

                    <div class="admin-input-wrapper">

                        <i class="fa-solid fa-location-dot"></i>

                        <input asp-for="Location"
                               placeholder="e.g. Gym Floor" />

                    </div>

                    <span asp-validation-for="Location"
                          class="admin-field-error">
                    </span>

                </div>

            </div>

            <div class="admin-form-actions">

                <a asp-controller="Admin"
                   asp-action="Equipment"
                   class="admin-cancel-btn">

                    <i class="fa-solid fa-arrow-left"></i>

                    Cancel

                </a>


                <button type="submit"
                        class="admin-submit-btn">

                    <i class="fa-solid fa-plus"></i>

                    Add Equipment

                </button>

            </div>

        </form>

    </div>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin-equipment.css"
          asp-append-version="true" />

}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

}
