@model DUT_Campus_FIT_Gym.ViewModels.AttendanceReportViewModel

@{
    ViewData["Title"] = "Attendance Report";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet"
      href="~/css/admin-management.css"
      asp-append-version="true" />

<div class="admin-management-page">

    <div class="admin-management-header">

        <div>
            <span class="admin-management-eyebrow">
                <i class="fa-solid fa-chart-column"></i>
                ATTENDANCE REPORT
            </span>

            <h1>Attendance Report</h1>

            <p>
                Monitor gym visits, check-ins and member attendance activity.
            </p>
        </div>

        <div class="admin-management-header-icon">
            <i class="fa-solid fa-calendar-check"></i>
        </div>

    </div>

    <div class="admin-management-stats">

        <div class="admin-management-stat">

            <div class="admin-management-stat-icon attendance-icon">
                <i class="fa-solid fa-users"></i>
            </div>

            <div>
                <span>Total Visits</span>
                <strong>@Model.TotalVisits</strong>
                <small>Recorded gym visits</small>
            </div>

        </div>

        <div class="admin-management-stat">

            <div class="admin-management-stat-icon month-icon">
                <i class="fa-solid fa-calendar-days"></i>
            </div>

            <div>
                <span>This Month</span>
                <strong>@Model.CurrentMonthVisits</strong>
                <small>Visits this month</small>
            </div>

        </div>

        <div class="admin-management-stat">

            <div class="admin-management-stat-icon today-icon">
                <i class="fa-solid fa-door-open"></i>
            </div>

            <div>
                <span>Today's Visits</span>
                <strong>@Model.TodayVisits</strong>
                <small>Visits recorded today</small>
            </div>

        </div>

    </div>

    <div class="admin-management-card admin-table-card">

        <div class="admin-management-card-header">

            <div>
                <span class="admin-section-label">
                    ATTENDANCE HISTORY
                </span>

                <h2>Attendance Records</h2>

                <p>
                    Detailed check-in and check-out activity for gym members.
                </p>
            </div>

            <span class="admin-record-count">
                @Model.TotalVisits
            </span>

        </div>

        @if (!Model.Attendances.Any())
        {
            <div class="admin-empty-state">

                <div class="admin-empty-icon">
                    <i class="fa-solid fa-calendar-xmark"></i>
                </div>

                <h3>No Attendance Records</h3>

                <p>
                    Member attendance records will appear here after check-ins are recorded.
                </p>

            </div>
        }
        else
        {
            <div class="admin-table-wrapper">

                <table class="admin-management-table">

                    <thead>

                        <tr>
                            <th>Member</th>
                            <th>Student/Staff No.</th>
                            <th>Check In</th>
                            <th>Check Out</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var attendance in Model.Attendances)
                        {
                            <tr>

                                <td>
                                    <div class="admin-member-name">
                                        <strong>
                                            @attendance.Member?.Name
                                            @attendance.Member?.Surname
                                        </strong>
                                    </div>
                                </td>

                                <td>
                                    @attendance.Member?.StudentNumber
                                </td>

                                <td>
                                    <span class="admin-date-badge check-in">
                                        <i class="fa-solid fa-right-to-bracket"></i>
                                        @attendance.CheckInTime.ToString("dd MMM yyyy, HH:mm")
                                    </span>
                                </td>

                                <td>

                                    @if (attendance.CheckOutTime.HasValue)
                                    {
                                        <span class="admin-date-badge check-out">
                                            <i class="fa-solid fa-right-from-bracket"></i>
                                            @attendance.CheckOutTime.Value.ToString("dd MMM yyyy, HH:mm")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="admin-status-badge active">
                                            Still checked in
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>