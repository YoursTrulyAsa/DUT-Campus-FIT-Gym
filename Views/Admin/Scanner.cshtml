@{
    ViewData["Title"] = "Gym Entrance Scanner";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<div class="scanner-page">

    <div class="scanner-header">

        <span class="scanner-label">
            DUT CAMPUS FIT GYM
        </span>

        <h1>
            Gym Entrance Scanner
        </h1>

        <p>
            Scan a member's Virtual Gym Card barcode
            to verify membership and record attendance.
        </p>

    </div>


    @if (TempData["CheckInSuccess"] != null)
    {
        <div class="scanner-result success-result">

            <div class="result-icon">
                ✓
            </div>

            <div class="result-content">

                <span class="result-label">
                    ACCESS GRANTED
                </span>

                <h2>
                    @TempData["ScannedMemberName"]
                </h2>

                <p>
                    Welcome to DUT Campus FIT Gym.
                    Your attendance has been recorded.
                </p>

            </div>

        </div>


        <div class="scanned-member-card">

            <div class="scanned-member-header">

                <div>
                    <span class="card-label">
                        VERIFIED MEMBER
                    </span>

                    <h3>
                        Member Information
                    </h3>
                </div>

                <div class="verified-badge">
                    ✓ VERIFIED
                </div>

            </div>


            <div class="member-details-grid">

                <div class="member-detail">

                    <span class="detail-label">
                        MEMBER NAME
                    </span>

                    <strong>
                        @TempData["ScannedMemberName"]
                    </strong>

                </div>


                <div class="member-detail">

                    <span class="detail-label">
                        STUDENT / STAFF NUMBER
                    </span>

                    <strong>
                        @TempData["ScannedStudentNumber"]
                    </strong>

                </div>


                <div class="member-detail">

                    <span class="detail-label">
                        MEMBERSHIP TYPE
                    </span>

                    <strong>
                        @TempData["ScannedMembershipType"]
                    </strong>

                </div>


                <div class="member-detail">

                    <span class="detail-label">
                        MEMBERSHIP STATUS
                    </span>

                    <strong class="status-active">
                        @TempData["ScannedMembershipStatus"]
                    </strong>

                </div>


                <div class="member-detail">

                    <span class="detail-label">
                        EXPIRY DATE
                    </span>

                    <strong>
                        @TempData["ScannedExpiryDate"]
                    </strong>

                </div>


                <div class="member-detail">

                    <span class="detail-label">
                        CHECK-IN TIME
                    </span>

                    <strong>
                        @TempData["ScannedCheckInTime"]
                    </strong>

                </div>

            </div>

        </div>
    }


    <!-- =====================================================
         ERROR MESSAGE
         ===================================================== -->
    @if (TempData["CheckInError"] != null)
    {
        <div class="scanner-result error-result">

            <div class="result-icon">
                !
            </div>

            <div class="result-content">

                <span class="result-label">
                    ACCESS DENIED
                </span>

                <h2>
                    Check-In Unavailable
                </h2>

                <p>
                    @TempData["CheckInError"]
                </p>

            </div>

        </div>
    }


    <div class="scanner-card">

        <div class="scanner-icon">
            ▣
        </div>

        <h2>
            Scan Member Code
        </h2>

        <p>
            Ask the member to display their Virtual Gym Card
            and position the barcode inside the scanning area.
        </p>


       

        <form id="scannerTokenForm">

            @Html.AntiForgeryToken()

        </form>



        <button type="button"
                id="startScanner"
                class="scanner-button">

            Start Scanner

        </button>


        <div id="qr-reader"></div>


        <div id="scannerStatus"
             class="scanner-status">
        </div>

    </div>



    <div class="scanner-instructions">

        <div class="instruction-title">
            How staff check-in works
        </div>

        <div class="instruction-grid">

            <div class="instruction-item">

                <span class="instruction-number">
                    1
                </span>

                <div>
                    <strong>
                        Start Scanner
                    </strong>

                    <p>
                        Open the camera scanner.
                    </p>
                </div>

            </div>


            <div class="instruction-item">

                <span class="instruction-number">
                    2
                </span>

                <div>
                    <strong>
                        Scan Virtual Card
                    </strong>

                    <p>
                        Scan the member's Code 128 barcode.
                    </p>
                </div>

            </div>


            <div class="instruction-item">

                <span class="instruction-number">
                    3
                </span>

                <div>
                    <strong>
                        Verify Membership
                    </strong>

                    <p>
                        The system checks membership status
                        and expiry.
                    </p>
                </div>

            </div>


            <div class="instruction-item">

                <span class="instruction-number">
                    4
                </span>

                <div>
                    <strong>
                        Grant Access
                    </strong>

                    <p>
                        Attendance is recorded automatically.
                    </p>
                </div>

            </div>

        </div>

    </div>

</div>


<script src="https://unpkg.com/html5-qrcode"
        type="text/javascript">
</script>


<script>

    const startScanner =
        document.getElementById("startScanner");

    const reader =
        document.getElementById("qr-reader");

    const status =
        document.getElementById("scannerStatus");


    let qrScanner = null;


    startScanner.addEventListener(
        "click",
        startQrScanner
    );

    function startQrScanner() {

        reader.style.display = "block";

        startScanner.disabled = true;

        startScanner.textContent =
            "Scanner Starting...";

        status.textContent =
            "Opening camera...";


        qrScanner =
            new Html5Qrcode("qr-reader");


        const config = {

            fps: 10,

            qrbox: {
                width: 500,
                height: 180
            },

            formatsToSupport: [

                Html5QrcodeSupportedFormats.CODE_128,

                Html5QrcodeSupportedFormats.QR_CODE

            ]

        };

        qrScanner.start(

            {
                facingMode: "environment"
            },

            config,


            function (decodedText) {

                status.textContent =
                    "Barcode detected. Verifying member...";


                qrScanner.stop()

                    .then(function () {

                        verifyMember(decodedText);

                    })

                    .catch(function () {

                        verifyMember(decodedText);

                    });

            },


            function () {

                // Ignore normal scanning failures.

            }

        )

        .catch(function (error) {

            console.error(error);

            status.textContent =
                "Unable to access the camera.";

            startScanner.disabled = false;

            startScanner.textContent =
                "Try Again";

        });

    }


    function verifyMember(barcodeData) {

        const form =
            document.createElement("form");


        form.method =
            "POST";


        form.action =
            "@Url.Action("VerifyBarcodeCheckIn", "Admin")";

        const token =
            document.querySelector(
                'input[name="__RequestVerificationToken"]'
            );


        if (token) {

            const tokenInput =
                document.createElement("input");


            tokenInput.type =
                "hidden";


            tokenInput.name =
                "__RequestVerificationToken";


            tokenInput.value =
                token.value;


            form.appendChild(
                tokenInput
            );

        }


        const barcodeInput =
            document.createElement("input");


        barcodeInput.type =
            "hidden";


        barcodeInput.name =
            "barcodeData";


        barcodeInput.value =
            barcodeData;


        form.appendChild(
            barcodeInput
        );


        document.body.appendChild(form);

        form.submit();

    }

</script>


@section Styles {

    <link rel="stylesheet"
          href="~/css/scanner.css"
          asp-append-version="true" />

}