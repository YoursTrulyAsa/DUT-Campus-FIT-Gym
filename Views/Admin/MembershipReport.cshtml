@model DUT_Campus_FIT_Gym.ViewModels.MembershipReportViewModel

@{
    ViewData["Title"] = "Membership Report";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet"
      href="~/css/admin-management.css"
      asp-append-version="true" />

<div class="admin-management-page">

    <div class="admin-management-header">

        <div>
            <span class="admin-management-eyebrow">
                <i class="fa-solid fa-id-card"></i>
                MEMBERSHIP REPORT
            </span>

            <h1>Membership Report</h1>

            <p>
                Monitor gym memberships, activity and payment status.
            </p>
        </div>

        <div class="admin-management-header-icon">
            <i class="fa-solid fa-chart-pie"></i>
        </div>

    </div>

    <div class="admin-management-stats">

        <div class="admin-management-stat">

            <div class="admin-management-stat-icon membership-icon">
                <i class="fa-solid fa-id-card"></i>
            </div>

            <div>
                <span>Total Memberships</span>
                <strong>@Model.TotalMemberships</strong>
                <small>All membership records</small>
            </div>

        </div>

        <div class="admin-management-stat">

            <div class="admin-management-stat-icon active-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <div>
                <span>Active</span>
                <strong>@Model.ActiveMemberships</strong>
                <small>Currently active</small>
            </div>

        </div>

        <div class="admin-management-stat">

            <div class="admin-management-stat-icon expired-icon">
                <i class="fa-solid fa-clock-rotate-left"></i>
            </div>

            <div>
                <span>Expired</span>
                <strong>@Model.ExpiredMemberships</strong>
                <small>Expired memberships</small>
            </div>

        </div>

        <div class="admin-management-stat">

            <div class="admin-management-stat-icon waiting-icon">
                <i class="fa-solid fa-hourglass-half"></i>
            </div>

            <div>
                <span>Waiting for Payment</span>
                <strong>@Model.WaitingForPayment</strong>
                <small>Awaiting payment</small>
            </div>

        </div>

    </div>

    <div class="admin-management-card admin-table-card">

        <div class="admin-management-card-header">

            <div>
                <span class="admin-section-label">
                    MEMBERSHIP HISTORY
                </span>

                <h2>Membership Records</h2>

                <p>
                    Detailed membership information for registered gym members.
                </p>
            </div>

            <span class="admin-record-count">
                @Model.TotalMemberships
            </span>

        </div>

        @if (!Model.Memberships.Any())
        {
            <div class="admin-empty-state">

                <div class="admin-empty-icon">
                    <i class="fa-solid fa-id-card"></i>
                </div>

                <h3>No Membership Records</h3>

                <p>
                    Membership records will appear here once memberships are created.
                </p>

            </div>
        }
        else
        {
            <div class="admin-table-wrapper">

                <table class="admin-management-table">

                    <thead>

                        <tr>
                            <th>Member</th>
                            <th>Student/Staff No.</th>
                            <th>Membership Type</th>
                            <th>Price</th>
                            <th>Status</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Payment Status</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var membership in Model.Memberships)
                        {
                            <tr>

                                <td>
                                    <div class="admin-member-name">
                                        <strong>
                                            @membership.Member?.Name
                                            @membership.Member?.Surname
                                        </strong>
                                    </div>
                                </td>

                                <td>
                                    @membership.Member?.StudentNumber
                                </td>

                                <td>
                                    <span class="admin-type-badge">
                                        @membership.MembershipType
                                    </span>
                                </td>

                                <td>
                                    <strong class="admin-price">
                                        R @membership.Price.ToString("N2")
                                    </strong>
                                </td>

                                <td>

                                    @if (membership.Status == "Active")
                                    {
                                        <span class="admin-status-badge active">
                                            <i class="fa-solid fa-circle-check"></i>
                                            Active
                                        </span>
                                    }
                                    else if (membership.Status == "WaitingForPayment")
                                    {
                                        <span class="admin-status-badge waiting">
                                            <i class="fa-solid fa-hourglass-half"></i>
                                            Waiting for Payment
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="admin-status-badge">
                                            @membership.Status
                                        </span>
                                    }

                                </td>

                                <td>
                                    @(membership.StartDate.HasValue
                                        ? membership.StartDate.Value.ToString("dd MMM yyyy")
                                        : "N/A")
                                </td>

                                <td>
                                    @(membership.EndDate.HasValue
                                        ? membership.EndDate.Value.ToString("dd MMM yyyy")
                                        : "N/A")
                                </td>

                                <td>

                                    @if (membership.PaymentStatus == "Paid")
                                    {
                                        <span class="admin-status-badge active">
                                            <i class="fa-solid fa-circle-check"></i>
                                            Paid
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="admin-status-badge waiting">
                                            @(membership.PaymentStatus ?? "N/A")
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>