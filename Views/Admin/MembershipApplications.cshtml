@model IEnumerable<DUT_Campus_FIT_Gym.Models.MembershipApplication>

@{
    ViewData["Title"] = "Membership Applications";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1>
                Membership Applications
            </h1>

            <p class="text-muted">
                Review and manage student gym membership applications.
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>

            Back to Dashboard

        </a>

    </div>


    <!-- SUCCESS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">

            @TempData["Success"]

        </div>
    }


    <!-- ERROR -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">

            @TempData["Error"]

        </div>
    }


    @if (!Model.Any())
    {
        <div class="alert alert-info">

            There are currently no membership applications.

        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">

                    <tr>

                        <th>
                            Student
                        </th>

                        <th>
                            Student No
                        </th>

                        <th>
                            Membership
                        </th>

                        <th>
                            Price
                        </th>

                        <th>
                            Payment
                        </th>

                        <th>
                            Application Date
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Document
                        </th>

                        <th>
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var application in Model)
                    {
                        <tr>

                            <!-- STUDENT -->

                            <td>

                                @if (application.Member != null)
                                {
                                    <strong>
                                        @application.Member.FirstName
                                        @application.Member.LastName
                                    </strong>

                                    <br />

                                    <small class="text-muted">
                                        @application.Member.Email
                                    </small>
                                }
                                else
                                {
                                    <span>
                                        Unknown member
                                    </span>
                                }

                            </td>


                            <!-- STUDENT NUMBER -->

                            <td>

                                @application.Member?.StaffStudentNumber

                            </td>


                            <!-- MEMBERSHIP -->

                            <td>

                                @application.MembershipType

                            </td>


                            <!-- PRICE -->

                            <td>

                                R @application.Price.ToString("N2")

                            </td>


                            <!-- PAYMENT -->

                            <td>

                                @application.PaymentMethod

                            </td>


                            <!-- DATE -->

                            <td>

                                @application.ApplicationDate.ToString(
                                    "dd MMM yyyy")

                            </td>


                            <!-- STATUS -->

                            <td>

                                @if (application.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }
                                else if (application.Status == "Approved")
                                {
                                    <span class="badge bg-success">
                                        Approved
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>
                                }

                            </td>


                            <!-- DOCUMENT -->

                            <td>

                                @if (!string.IsNullOrWhiteSpace(
                                    application.VerificationDocument))
                                {
                                    <a href="@application.VerificationDocument"
                                       target="_blank"
                                       class="btn btn-sm btn-outline-primary">

                                        <i class="bi bi-file-earmark"></i>

                                        View

                                    </a>
                                }

                            </td>


                            <!-- ACTION -->

                            <td>

                                @if (application.Status == "Pending")
                                {
                                    <!-- APPROVE -->

                                    <form asp-action="ApproveMembership"
                                          method="post"
                                          class="mb-2">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@application.MembershipApplicationId" />

                                        <button type="submit"
                                                class="btn btn-success btn-sm w-100">

                                            <i class="bi bi-check-circle"></i>

                                            Approve

                                        </button>

                                    </form>


                                    <!-- REJECT -->

                                    <form asp-action="RejectMembership"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@application.MembershipApplicationId" />

                                        <textarea name="adminComment"
                                                  class="form-control form-control-sm mb-2"
                                                  placeholder="Reason for rejection"
                                                  required></textarea>

                                        <button type="submit"
                                                class="btn btn-danger btn-sm w-100">

                                            <i class="bi bi-x-circle"></i>

                                            Reject

                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Reviewed
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>