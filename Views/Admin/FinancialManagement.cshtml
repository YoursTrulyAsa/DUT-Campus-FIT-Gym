@model DUT_Campus_FIT_Gym.ViewModels.FinancialManagementViewModel

@{
    ViewData["Title"] = "Financial Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet"
      href="~/css/admin-management.css"
      asp-append-version="true" />

<div class="admin-management-page">

    <div class="admin-management-header">

        <div>
            <span class="admin-management-eyebrow">
                <i class="fa-solid fa-money-bill-wave"></i>
                FINANCIAL MANAGEMENT
            </span>

            <h1>Financial Management</h1>

            <p>
                Monitor membership payments, revenue and financial activity.
            </p>
        </div>

        <div class="admin-management-header-icon">
            <i class="fa-solid fa-chart-line"></i>
        </div>

    </div>

    <div class="admin-management-stats">

        <div class="admin-management-stat">

            <div class="admin-management-stat-icon revenue-icon">
                <i class="fa-solid fa-money-bill-trend-up"></i>
            </div>

            <div>
                <span>Paid Revenue</span>
                <strong>R @Model.PaidRevenue.ToString("N2")</strong>
                <small>Completed payments</small>
            </div>

        </div>

        <div class="admin-management-stat">

            <div class="admin-management-stat-icon payment-icon">
                <i class="fa-solid fa-receipt"></i>
            </div>

            <div>
                <span>Total Payments</span>
                <strong>@Model.TotalPayments</strong>
                <small>Completed membership payments</small>
            </div>

        </div>

        <div class="admin-management-stat">

            <div class="admin-management-stat-icon collection-icon">
                <i class="fa-solid fa-wallet"></i>
            </div>

            <div>
                <span>Total Collected</span>
                <strong>R @((Model.StudentPaidRevenue + Model.StaffPaidRevenue).ToString("N2"))</strong>
                <small>Student + staff revenue</small>
            </div>

        </div>

    </div>

    <div class="admin-management-card">

        <div class="admin-management-card-header">

            <div>
                <span class="admin-section-label">
                    REVENUE OVERVIEW
                </span>

                <h2>Revenue Breakdown</h2>

                <p>
                    Compare revenue generated from student and staff memberships.
                </p>
            </div>

            <div class="admin-card-icon">
                <i class="fa-solid fa-chart-pie"></i>
            </div>

        </div>

        <div class="admin-breakdown-grid">

            <div class="admin-breakdown-item">

                <div class="admin-breakdown-icon">
                    <i class="fa-solid fa-graduation-cap"></i>
                </div>

                <div>
                    <span>Student Revenue</span>
                    <strong>R @Model.StudentPaidRevenue.ToString("N2")</strong>
                    <small>Paid student memberships</small>
                </div>

            </div>

            <div class="admin-breakdown-item">

                <div class="admin-breakdown-icon">
                    <i class="fa-solid fa-user-tie"></i>
                </div>

                <div>
                    <span>Staff Revenue</span>
                    <strong>R @Model.StaffPaidRevenue.ToString("N2")</strong>
                    <small>Paid staff memberships</small>
                </div>

            </div>

        </div>

    </div>

    <div class="admin-management-card">

        <div class="admin-management-card-header">

            <div>
                <span class="admin-section-label">
                    MEMBERSHIP VALUE
                </span>

                <h2>Active Memberships</h2>

                <p>
                    Current membership activity and value.
                </p>
            </div>

            <div class="admin-card-icon">
                <i class="fa-solid fa-id-card"></i>
            </div>

        </div>

        <div class="admin-mini-stats">

            <div class="admin-mini-stat">
                <span>Active Memberships</span>
                <strong>@Model.ActiveMemberships</strong>
                <small>Currently active</small>
            </div>

            <div class="admin-mini-stat">
                <span>Active Membership Value</span>
                <strong>R @Model.ActiveMembershipValue.ToString("N2")</strong>
                <small>Total active value</small>
            </div>

            <div class="admin-mini-stat">
                <span>Student Memberships</span>
                <strong>@Model.ActiveStudentMemberships</strong>
                <small>Active students</small>
            </div>

            <div class="admin-mini-stat">
                <span>Staff Memberships</span>
                <strong>@Model.ActiveStaffMemberships</strong>
                <small>Active staff</small>
            </div>

        </div>

    </div>

    <div class="admin-management-card admin-table-card">

        <div class="admin-management-card-header">

            <div>
                <span class="admin-section-label">
                    PAYMENT HISTORY
                </span>

                <h2>Completed Payments</h2>

                <p>
                    Membership payments successfully recorded by the system.
                </p>
            </div>

            <span class="admin-record-count">
                @Model.TotalPayments
            </span>

        </div>

        @if (Model.Payments == null || !Model.Payments.Any())
        {
            <div class="admin-empty-state">

                <div class="admin-empty-icon">
                    <i class="fa-solid fa-receipt"></i>
                </div>

                <h3>No Completed Payments</h3>

                <p>
                    Completed membership payments will appear here.
                </p>

            </div>
        }
        else
        {
            <div class="admin-table-wrapper">

                <table class="admin-management-table">

                    <thead>

                        <tr>
                            <th>Member</th>
                            <th>Student/Staff No.</th>
                            <th>Membership</th>
                            <th>Amount</th>
                            <th>Payment Method</th>
                            <th>Reference</th>
                            <th>Payment Date</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var payment in Model.Payments)
                        {
                            <tr>

                                <td>
                                    <div class="admin-member-name">
                                        <strong>
                                            @(payment.Member != null
                                                ? $"{payment.Member.Name} {payment.Member.Surname}"
                                                : "Unknown Member")
                                        </strong>
                                    </div>
                                </td>

                                <td>
                                    @(payment.Member?.StudentNumber ?? "N/A")
                                </td>

                                <td>
                                    <span class="admin-type-badge">
                                        @payment.MembershipType
                                    </span>
                                </td>

                                <td>
                                    <strong class="admin-price">
                                        R @payment.Price.ToString("N2")
                                    </strong>
                                </td>

                                <td>
                                    @(payment.PaymentMethod ?? "N/A")
                                </td>

                                <td>
                                    <span class="admin-reference">
                                        @(payment.PaymentReference ?? "N/A")
                                    </span>
                                </td>

                                <td>
                                    @(payment.PaymentDate.HasValue
                                        ? payment.PaymentDate.Value.ToString("dd MMM yyyy HH:mm")
                                        : "N/A")
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>