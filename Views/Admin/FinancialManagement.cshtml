@model DUT_Campus_FIT_Gym.ViewModels.FinancialManagementViewModel

@{
    ViewData["Title"] = "Financial Management";
}

<div class="container mt-5">

    <!-- Page Header -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>Financial Management</h1>

            <p class="text-muted">
                Monitor membership payments and gym revenue.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-secondary">
            ← Back to Dashboard
        </a>

    </div>


    <!-- ============================================================
         PAID REVENUE SUMMARY
         ============================================================ -->

    <div class="row g-4 mb-4">

        <!-- Paid Revenue -->

        <div class="col-md-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Paid Revenue
                    </h6>

                    <h2>
                        R @Model.PaidRevenue.ToString("N2")
                    </h2>

                    <p class="mb-0">
                        Revenue from completed payments
                    </p>

                </div>

            </div>

        </div>


        <!-- Total Payments -->

        <div class="col-md-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Total Payments
                    </h6>

                    <h2>
                        @Model.TotalPayments
                    </h2>

                    <p class="mb-0">
                        Completed membership payments
                    </p>

                </div>

            </div>

        </div>


        <!-- Student + Staff Paid Revenue -->

        <div class="col-md-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Student + Staff Revenue
                    </h6>

                    <h2>
                        R @((Model.StudentPaidRevenue + Model.StaffPaidRevenue).ToString("N2"))
                    </h2>

                    <p class="mb-0">
                        Total collected revenue
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- ============================================================
         REVENUE BREAKDOWN
         ============================================================ -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">

            <h5 class="mb-0">
                Revenue Breakdown
            </h5>

        </div>

        <div class="card-body">

            <div class="row">

                <!-- Student Revenue -->

                <div class="col-md-6">

                    <h6>
                        Student Revenue
                    </h6>

                    <h3>
                        R @Model.StudentPaidRevenue.ToString("N2")
                    </h3>

                    <p class="text-muted">
                        Paid student memberships
                    </p>

                </div>


                <!-- Staff Revenue -->

                <div class="col-md-6">

                    <h6>
                        Staff Revenue
                    </h6>

                    <h3>
                        R @Model.StaffPaidRevenue.ToString("N2")
                    </h3>

                    <p class="text-muted">
                        Paid staff memberships
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- ============================================================
         ACTIVE MEMBERSHIP SUMMARY
         ============================================================ -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">

            <h5 class="mb-0">
                Active Memberships
            </h5>

        </div>

        <div class="card-body">

            <div class="row g-4">

                <!-- Total Active -->

                <div class="col-md-3">

                    <div class="card h-100">

                        <div class="card-body">

                            <h6 class="text-muted">
                                Active Memberships
                            </h6>

                            <h2>
                                @Model.ActiveMemberships
                            </h2>

                            <p class="mb-0">
                                Currently active memberships
                            </p>

                        </div>

                    </div>

                </div>


                <!-- Active Value -->

                <div class="col-md-3">

                    <div class="card h-100">

                        <div class="card-body">

                            <h6 class="text-muted">
                                Active Membership Value
                            </h6>

                            <h2>
                                R @Model.ActiveMembershipValue.ToString("N2")
                            </h2>

                            <p class="mb-0">
                                Total value of active memberships
                            </p>

                        </div>

                    </div>

                </div>


                <!-- Active Students -->

                <div class="col-md-3">

                    <div class="card h-100">

                        <div class="card-body">

                            <h6 class="text-muted">
                                Student Memberships
                            </h6>

                            <h2>
                                @Model.ActiveStudentMemberships
                            </h2>

                            <p class="mb-0">
                                Active student memberships
                            </p>

                        </div>

                    </div>

                </div>


                <!-- Active Staff -->

                <div class="col-md-3">

                    <div class="card h-100">

                        <div class="card-body">

                            <h6 class="text-muted">
                                Staff Memberships
                            </h6>

                            <h2>
                                @Model.ActiveStaffMemberships
                            </h2>

                            <p class="mb-0">
                                Active staff memberships
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ============================================================
         COMPLETED PAYMENTS
         ============================================================ -->

    <div class="card shadow-sm mb-5">

        <div class="card-header">

            <h5 class="mb-0">
                Completed Payments
            </h5>

        </div>

        <div class="card-body">

            @if (Model.Payments == null || !Model.Payments.Any())
            {
                <div class="alert alert-info mb-0">

                    No completed payments have been recorded yet.

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>

                                <th>
                                    Member
                                </th>

                                <th>
                                    Student/Staff No.
                                </th>

                                <th>
                                    Membership
                                </th>

                                <th>
                                    Amount
                                </th>

                                <th>
                                    Payment Method
                                </th>

                                <th>
                                    Payment Reference
                                </th>

                                <th>
                                    Payment Date
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var payment in Model.Payments)
                            {
                                <tr>

                                    <td>
                                        @(payment.Member != null
                                            ? $"{payment.Member.Name} {payment.Member.Surname}"
                                            : "Unknown Member")
                                    </td>

                                    <td>
                                        @(payment.Member?.StudentNumber ?? "N/A")
                                    </td>

                                    <td>
                                        @payment.MembershipType
                                    </td>

                                    <td>

                                        <strong>
                                            R @payment.Price.ToString("N2")
                                        </strong>

                                    </td>

                                    <td>
                                        @(payment.PaymentMethod ?? "N/A")
                                    </td>

                                    <td>
                                        @(payment.PaymentReference ?? "N/A")
                                    </td>

                                    <td>

                                        @(payment.PaymentDate.HasValue
                                            ? payment.PaymentDate.Value.ToString("dd MMM yyyy HH:mm")
                                            : "N/A")

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>