@model List<DUT_Campus_FIT_Gym.Models.MemberReview>

@{
    ViewData["Title"] = "Member Reviews";
     Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var totalReviews = (int)(ViewBag.TotalReviews ?? 0);
    var averageRating = (double)(ViewBag.AverageRating ?? 0);

    var fiveStar = (int)(ViewBag.FiveStar ?? 0);
    var fourStar = (int)(ViewBag.FourStar ?? 0);
    var threeStar = (int)(ViewBag.ThreeStar ?? 0);
    var twoStar = (int)(ViewBag.TwoStar ?? 0);
    var oneStar = (int)(ViewBag.OneStar ?? 0);

    var ratings = new[]
    {
        new { Stars = 5, Count = fiveStar },
        new { Stars = 4, Count = fourStar },
        new { Stars = 3, Count = threeStar },
        new { Stars = 2, Count = twoStar },
        new { Stars = 1, Count = oneStar }
    };
}

<link rel="stylesheet"
      href="~/css/admin-reviews.css"
      asp-append-version="true" />

<div class="admin-reviews-page">

    <div class="admin-reviews-header">

        <div>
            <span class="admin-reviews-eyebrow">
                <i class="bi bi-chat-square-heart-fill"></i>
                MEMBER FEEDBACK
            </span>

            <h1>Member Reviews</h1>

            <p>
                Monitor member feedback and review the overall gym experience.
            </p>
        </div>

        <div class="admin-reviews-header-icon">
            <i class="bi bi-stars"></i>
        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="admin-review-alert success">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="admin-review-alert error">
            <i class="bi bi-exclamation-circle-fill"></i>
            @TempData["Error"]
        </div>
    }

    <div class="admin-review-stats">

        <div class="admin-review-stat">
            <div class="admin-review-stat-icon">
                <i class="bi bi-chat-square-text-fill"></i>
            </div>

            <div>
                <span>Total Reviews</span>
                <strong>@totalReviews</strong>
            </div>
        </div>

        <div class="admin-review-stat">
            <div class="admin-review-stat-icon">
                <i class="bi bi-star-fill"></i>
            </div>

            <div>
                <span>Average Rating</span>
                <strong>@averageRating.ToString("0.0") / 5</strong>
            </div>
        </div>

        <div class="admin-review-stat">
            <div class="admin-review-stat-icon">
                <i class="bi bi-trophy-fill"></i>
            </div>

            <div>
                <span>5-Star Reviews</span>
                <strong>@fiveStar</strong>
            </div>
        </div>

    </div>

    <div class="admin-review-overview">

        <div class="admin-review-card">

            <div class="admin-review-card-heading">
                <div>
                    <h2>Rating Breakdown</h2>
                    <p>Member satisfaction across all submitted reviews.</p>
                </div>
            </div>

            @foreach (var rating in ratings)
            {
                var percentage = totalReviews > 0
                    ? rating.Count * 100.0 / totalReviews
                    : 0;

                <div class="admin-rating-row">

                    <span class="admin-rating-label">
                        @rating.Stars
                        <i class="bi bi-star-fill"></i>
                    </span>

                    <div class="admin-rating-bar">
                        <div class="admin-rating-fill"
                             style="width: @percentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%">
                        </div>
                    </div>

                    <span class="admin-rating-count">
                        @rating.Count
                    </span>

                </div>
            }

        </div>

        <div class="admin-review-card admin-rating-highlight">

            <div class="highlight-icon">
                <i class="bi bi-heart-fill"></i>
            </div>

            <span>GYM EXPERIENCE</span>

            <strong>
                @if (averageRating >= 4.5)
                {
                    @:Excellent
                }
                else if (averageRating >= 3.5)
                {
                    @:Very Good
                }
                else if (averageRating >= 2.5)
                {
                    @:Good
                }
                else if (averageRating >= 1.5)
                {
                    @:Needs Improvement
                }
                else if (totalReviews > 0)
                {
                    @:Needs Attention
                }
                else
                {
                    @:No Ratings Yet
                }
            </strong>

            <p>
                Based on @totalReviews member review@(totalReviews == 1 ? "" : "s").
            </p>

        </div>

    </div>

    <div class="admin-review-card reviews-management-card">

        <div class="admin-review-card-heading">

            <div>
                <h2>Member Feedback</h2>
                <p>Recent reviews submitted by gym members.</p>
            </div>

            <span class="admin-review-count">
                @totalReviews
            </span>

        </div>

        @if (Model.Any())
        {
            <div class="admin-reviews-list">

                @foreach (var review in Model)
                {
                    <div class="admin-review-item">

                        <div class="admin-review-avatar">

                            @if (!string.IsNullOrWhiteSpace(review.Member?.ProfilePicture))
                            {
                                <img src="@review.Member.ProfilePicture"
                                     alt="Member profile picture" />
                            }
                            else
                            {
                                var first =
                                    !string.IsNullOrWhiteSpace(review.Member?.Name)
                                        ? review.Member.Name.Trim()[0].ToString()
                                        : "";

                                var last =
                                    !string.IsNullOrWhiteSpace(review.Member?.Surname)
                                        ? review.Member.Surname.Trim()[0].ToString()
                                        : "";

                                @((first + last).ToUpper())
                            }

                        </div>

                        <div class="admin-review-content">

                            <div class="admin-review-top">

                                <div>
                                    <h3>
                                        @(review.Member?.Name ?? "Member")
                                        @(review.Member?.Surname ?? "")
                                    </h3>

                                    <span>
                                        @(review.Member?.StudentNumber ?? "N/A")
                                        ·
                                        @review.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                                    </span>
                                </div>

                                <div class="admin-review-rating">

                                    @for (var i = 1; i <= 5; i++)
                                    {
                                        <i class="bi @(i <= review.Rating ? "bi-star-fill" : "bi-star")"></i>
                                    }

                                </div>

                            </div>

                            <p class="admin-review-text">
                                @review.ReviewText
                            </p>

                            @if (review.UpdatedAt.HasValue)
                            {
                                <span class="admin-review-edited">
                                    <i class="bi bi-pencil-fill"></i>
                                    Edited @review.UpdatedAt.Value.ToString("dd MMM yyyy, HH:mm")
                                </span>
                            }

                        </div>

                        <div class="admin-review-actions">

                            <form asp-action="DeleteReview"
                                  method="post"
                                  onsubmit="return confirm('Are you sure you want to delete this review?');">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@review.MemberReviewId" />

                                <button type="submit"
                                        class="admin-review-delete"
                                        title="Delete review">

                                    <i class="bi bi-trash3-fill"></i>

                                </button>

                            </form>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="admin-review-empty">

                <div>
                    <i class="bi bi-chat-square-heart"></i>
                </div>

                <h3>No Member Reviews</h3>

                <p>
                    Member reviews will appear here once members start submitting feedback.
                </p>

            </div>
        }

    </div>

</div>