@model IEnumerable<DUT_Campus_FIT_Gym.ViewModels.AdminReservationViewModel>

@{
    ViewData["Title"] = "View Reservations";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>Equipment Reservations</h1>

            <p class="text-muted">
                View all equipment reservations made by gym members.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>

    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            There are currently no equipment reservations.
        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover">

                        <thead>
                            <tr>
                                <th>Member</th>
                                <th>Student Number</th>
                                <th>Equipment</th>
                                <th>Reservation Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var reservation in Model)
                            {
                                <tr>

                                    <td>
                                        @reservation.MemberName
                                    </td>

                                    <td>
                                        @reservation.StudentNumber
                                    </td>

                                    <td>
                                        @reservation.EquipmentName
                                    </td>

                                    <td>
                                        @reservation.ReservationDate.ToString(
                                            "dd MMM yyyy HH:mm")
                                    </td>

                                    <td>

                                        @if (reservation.Status == "Reserved")
                                        {
                                            <span class="badge bg-success">
                                                Reserved
                                            </span>
                                        }
                                        else if (reservation.Status == "Completed")
                                        {
                                            <span class="badge bg-primary">
                                                Completed
                                            </span>
                                        }
                                        else if (reservation.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @reservation.Status
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>