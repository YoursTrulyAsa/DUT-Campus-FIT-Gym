@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">

    <h1>Admin Dashboard</h1>

    <p>Welcome to the DUT Campus FIT Gym Administration Dashboard.</p>

    <hr />

    <div class="row">
        <!-- Memberships -->
        <div class="col-md-4">
            <div class="card bg-light mb-3">
                <div class="card-header">Memberships</div>
                <div class="card-body">
                    <p class="card-text">Approve or manage membership requests.</p>
                    <!-- Link to Membership list view -->
                    <a asp-action="Membership" class="btn btn-primary">View Memberships</a>
                </div>
            </div>
        </div>

        <!-- Approve Payment -->
        <div class="col-md-4">
            <div class="card bg-light mb-3">
                <div class="card-header">Payments</div>
                <div class="card-body">
                    <p class="card-text">Approve pending payments.</p>
                    <a asp-action="ApprovePayment" class="btn btn-primary">Approve Payments</a>
                </div>
            </div>
        </div>

        <!-- Announcements -->
        <div class="col-md-4">
            <div class="card bg-light mb-3">
                <div class="card-header">Announcements</div>
                <div class="card-body">
                    <p class="card-text">Manage announcements for members.</p>

                    <!-- Create -->
                    <a asp-action="CreateAnnouncement" class="btn btn-warning mb-1">Post Announcement</a>


                    <!-- View (list all announcements) -->
                    <a asp-action="AnnouncementList" class="btn btn-info mb-1">View Announcements</a>

                    <!-- Edit/Delete will be handled inside the Announcements list view -->
                    <!-- Each row in AnnouncementsList.cshtml has Edit and Delete buttons -->
                </div>
            </div>
        </div>

        <!-- Members -->
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Members</h5>
                    <p class="card-text">
                        Manage registered gym members.
                    </p>

                    <a href="#"
                       class="btn btn-primary">
                        Manage Members
                    </a>
                </div>
            </div>
        </div>

        <!-- Equipment -->
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Equipment</h5>
                    <p class="card-text">
                        Manage gym equipment.
                    </p>

                    <a href="#"
                       class="btn btn-primary">
                        Manage Equipment
                    </a>
                </div>
            </div>
        </div>

        <!-- Reservations -->
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Reservations</h5>
                    <p class="card-text">
                        View equipment reservations.
                    </p>

                    <a href="#"
                       class="btn btn-primary">
                        View Reservations
                    </a>
                </div>
            </div>
        </div>

        <!-- Trainers -->
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Trainers</h5>

                    <p class="card-text">
                        Create and manage trainer accounts.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="AddTrainer"
                       class="btn btn-success">
                        Add Trainer
                    </a>
                </div>
            </div>
        </div>

        <!-- Staff -->
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Staff</h5>

                    <p class="card-text">
                        Create and manage staff accounts.
                    </p>

                    <a href="#"
                       class="btn btn-info">
                        Manage Staff
                    </a>
                </div>
            </div>
        </div>
        <!-- Member Requests -->
        <div class="col-md-4">
            <div class="card bg-light mb-3">
                <div class="card-header">Requests</div>
                <div class="card-body">
                    <p class="card-text">View and manage member requests.</p>
                    <a asp-action="ViewRequests" class="btn btn-info">View Requests</a>
                </div>
            </div>
        </div>

    </div>

</div>