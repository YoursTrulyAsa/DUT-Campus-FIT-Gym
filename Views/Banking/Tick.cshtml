@{
    ViewData["Title"] = "Payment Successful!";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-success">
                <div class="card-header bg-success text-white">
                    <h3 class="mb-0">Payment Successful! 🎉</h3>
                </div>
                <div class="card-body text-center">
                    <div class="display-1 text-success">✓</div>
                    <h4 class="mt-3">Your Gym Membership is Now Active!</h4>
                    <p class="text-muted">
                        Membership Type: <strong>@ViewBag.MembershipType</strong><br />
                        Amount Paid: <strong>R @ViewBag.Amount</strong><br />
                        Expires: <strong>@ViewBag.ExpiryDate</strong>
                    </p>
                    <p>A confirmation email has been sent to your registered email address.</p>
                    <a href="@Url.Action("Dashboard", "Member")" class="btn btn-primary mt-3">
                        Go to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>