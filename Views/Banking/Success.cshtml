@model BankDetails
@{
    ViewData["Title"] = "Payment Success";
}

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-success text-white">
            <h3>Payment Confirmation</h3>
        </div>
        <div class="card-body">
            <div class="alert alert-success">
                <h4>Thank you for your payment!</h4>
                <p>Your payment of <strong>R @(ViewBag.Amount?.ToString("0.00") ?? "0.00")</strong> has been received.</p>
                <p>Membership ID: @ViewBag.MembershipId</p>
            </div>
            <a href="@Url.Action("Membership", "Member")" class="btn btn-primary">View Membership</a>
        </div>
    </div>
</div>