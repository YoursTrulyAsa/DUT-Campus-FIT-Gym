@model DUT_Campus_FIT_Gym.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="forgot-page">

    <div class="forgot-left-panel">

        <div class="forgot-branding">

            <img src="~/images/DUT-logo.jpg"
                 alt="DUT Campus FIT Gym Logo"
                 class="forgot-logo" />

            <h1>DUT Campus FIT Gym</h1>

            <p>
                Train. Grow. Achieve.
            </p>

        </div>

    </div>

    <div class="forgot-right-panel">

        <div class="forgot-card">

            <div class="forgot-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>

            <h2>Forgot Password?</h2>

            <p class="forgot-subtitle">
                No worries. Enter your email address below
                and we'll help you reset your password.
            </p>


            <form asp-action="ForgotPassword" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="form-group">

                    <label asp-for="Email">
                        Email Address
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-envelope"></i>

                        <input asp-for="Email"
                               placeholder="Enter your email address" />

                    </div>

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>


                <button type="submit"
                        class="reset-btn">

                    Continue

                    <i class="bi bi-arrow-right"></i>

                </button>

            </form>


            <div class="back-login">

                <a asp-action="Login">

                    <i class="bi bi-arrow-left"></i>

                    Back to Login

                </a>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}


@section Styles {

    <link rel="stylesheet"
          href="~/css/forgot-password.css"
          asp-append-version="true" />

}
