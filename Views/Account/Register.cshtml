@model DUT_Campus_FIT_Gym.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="register-page">

    <div class="register-container">

        <!-- ====================================================== -->
        <!-- LEFT PANEL -->
        <!-- ====================================================== -->

        <div class="left-panel">

            <div class="branding">

                <img src="~/images/DUT-logo.jpg"
                     alt="Durban University of Technology Logo"
                     class="gym-logo" />

                <h1>
                    DUT Campus FIT Gym
                </h1>

                <p>
                    Train. Grow. Achieve.
                </p>

            </div>

        </div>


        <!-- ====================================================== -->
        <!-- RIGHT PANEL -->
        <!-- ====================================================== -->

        <div class="right-panel">

            <div class="register-card">

                <h2>
                    Create Account
                </h2>

                <p>
                    Join the DUT Campus FIT Gym today.
                </p>


                <!-- ================================================= -->
                <!-- REGISTER FORM -->
                <!-- ================================================= -->

                <form asp-controller="Account"
                      asp-action="Register"
                      method="post">

                    @Html.AntiForgeryToken()


                    <!-- VALIDATION SUMMARY -->

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <!-- ================================================= -->
                    <!-- NAME + SURNAME -->
                    <!-- ================================================= -->

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="Name"
                                   class="form-label">
                            </label>

                            <input asp-for="Name"
                                   class="form-control" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-6 mb-3">

                            <label asp-for="Surname"
                                   class="form-label">
                            </label>

                            <input asp-for="Surname"
                                   class="form-control" />

                            <span asp-validation-for="Surname"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- STUDENT NUMBER -->
                    <!-- ================================================= -->

                    <div class="mb-3">

                        <label asp-for="StudentNumber"
                               class="form-label">
                        </label>

                        <input asp-for="StudentNumber"
                               class="form-control" />

                        <span asp-validation-for="StudentNumber"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ================================================= -->
                    <!-- EMAIL -->
                    <!-- ================================================= -->

                    <div class="mb-3">

                        <label asp-for="Email"
                               class="form-label">
                        </label>

                        <input asp-for="Email"
                               class="form-control"
                               type="email" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ================================================= -->
                    <!-- PHONE NUMBER -->
                    <!-- ================================================= -->

                    <div class="mb-3">

                        <label asp-for="PhoneNumber"
                               class="form-label">
                        </label>

                        <input asp-for="PhoneNumber"
                               class="form-control" />

                        <span asp-validation-for="PhoneNumber"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ================================================= -->
                    <!-- PASSWORDS -->
                    <!-- ================================================= -->

                    <div class="row">

                        <!-- PASSWORD -->

                        <div class="col-md-6 mb-3">

                            <label asp-for="Password"
                                   class="form-label">
                            </label>

                            <div class="password-wrapper">

                                <input asp-for="Password"
                                       class="form-control"
                                       id="passwordInput" />

                                <button type="button"
                                        class="password-toggle"
                                        onclick="togglePassword('passwordInput', this)">

                                    Show

                                </button>

                            </div>

                            <span asp-validation-for="Password"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- CONFIRM PASSWORD -->

                        <div class="col-md-6 mb-4">

                            <label asp-for="ConfirmPassword"
                                   class="form-label">
                            </label>

                            <div class="password-wrapper">

                                <input asp-for="ConfirmPassword"
                                       class="form-control"
                                       id="confirmPasswordInput" />

                                <button type="button"
                                        class="password-toggle"
                                        onclick="togglePassword('confirmPasswordInput', this)">

                                    Show

                                </button>

                            </div>

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- CREATE ACCOUNT -->
                    <!-- ================================================= -->

                    <button type="submit"
                            class="btn register-btn w-100">

                        Create Account

                    </button>


                    <!-- ================================================= -->
                    <!-- LOGIN -->
                    <!-- ================================================= -->

                    <div class="text-center mt-4">

                        <span>
                            Already have an account?
                        </span>

                        <a asp-controller="Account"
                           asp-action="Login">

                            Login

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


<!-- ====================================================== -->
<!-- STYLES -->
<!-- ====================================================== -->
@section Styles {

    <link rel="stylesheet"
          href="~/css/register.css"
          asp-append-version="true" />

}


<!-- ====================================================== -->
<!-- SCRIPTS -->
<!-- ====================================================== -->
@section Scripts {

    <script src="~/js/register.js"
            asp-append-version="true">
    </script>

    <partial name="_ValidationScriptsPartial" />

}