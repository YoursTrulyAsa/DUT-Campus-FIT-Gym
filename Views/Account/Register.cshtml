@model DUT_Campus_FIT_Gym.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<link rel="stylesheet" href="~/css/register.css" />

<div class="register-page">

    <div class="register-container">

        <div class="left-panel">

            <div class="branding">

                <img src="~/images/DUT-logo.jpg"
                     alt="Durban University of Technology Logo"
                     class="gym-logo" />

                <h1>DUT Campus FIT Gym</h1>

                <p>Train. Grow. Achieve.</p>

            </div>

        </div>

        <div class="right-panel">

            <div class="register-card">

                <h2>Create Account</h2>

                <p>Join the DUT Campus FIT Gym today.</p>

                <form asp-controller="Account"
                      asp-action="Register"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="FirstName"
                                   class="form-label">
                            </label>

                            <input asp-for="FirstName"
                                   class="form-control" />

                            <span asp-validation-for="FirstName"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="LastName"
                                   class="form-label">
                            </label>

                            <input asp-for="LastName"
                                   class="form-control" />

                            <span asp-validation-for="LastName"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                    <div class="mb-3">

                        <label asp-for="StaffStudentNumber"
                               class="form-label">
                        </label>

                        <input asp-for="StaffStudentNumber"
                               class="form-control" />

                        <span asp-validation-for="StaffStudentNumber"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Email"
                               class="form-label">
                        </label>

                        <input asp-for="Email"
                               class="form-control" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="PhoneNumber"
                               class="form-label">
                        </label>

                        <input asp-for="PhoneNumber"
                               class="form-control" />

                        <span asp-validation-for="PhoneNumber"
                              class="text-danger">
                        </span>

                    </div>

                    

                    <div class="row">

                        <div class="col-md-6 mb-3">

                          <label asp-for="Password" class="form-label"></label>

                          <div class="password-wrapper">

                              <input asp-for="Password"
                                       class="form-control"
                                       id="passwordInput" />

                               <button type="button"
                                           class="password-toggle"
                                            onclick="togglePassword('passwordInput', this)">
                                      Show
                               </button>

                    </div>

                       <span asp-validation-for="Password"
                           class="text-danger">
                          </span>

                    </div>


                        <div class="col-md-6 mb-4">

                            <label asp-for="ConfirmPassword" class="form-label"></label>

                            <div class="password-wrapper">

                                <input asp-for="ConfirmPassword"
                                       class="form-control"
                                       id="confirmPasswordInput" />

                                <button type="button"
                                        class="password-toggle"
                                        onclick="togglePassword('confirmPasswordInput', this)">
                                    Show
                                </button>

                            </div>

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger">
                            </span>

                        </div> 

                    </div>

                    <button type="submit"
                            class="btn register-btn w-100">

                        Create Account

                    </button>


                    <div class="text-center mt-4">

                        Already have an account?

                        <a asp-controller="Account"
                           asp-action="Login">

                            Login

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script src="~/js/register.js"></script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}