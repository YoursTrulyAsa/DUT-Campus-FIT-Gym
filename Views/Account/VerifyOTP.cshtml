@{
    ViewData["Title"] = "Verify OTP";
}

<div class="forgot-page">

    <div class="forgot-left-panel">

        <div class="forgot-branding">

            <img src="~/images/DUT-logo.jpg"
                 alt="DUT Campus FIT Gym Logo"
                 class="forgot-logo" />

            <h1>DUT Campus FIT Gym</h1>

            <p>
                Train. Grow. Achieve.
            </p>

        </div>

    </div>

    <div class="forgot-right-panel">

        <div class="forgot-card">

            <div class="forgot-icon">
                <i class="bi bi-shield-check"></i>
            </div>

            <h2>Verify Your Email</h2>

            <p class="forgot-subtitle">
                We've sent a 6-digit verification code to your email address.
                Enter the code below to continue.
            </p>

            @if (ViewData["OtpError"] != null)
            {
                <div class="text-danger mb-3">
                    @ViewData["OtpError"]
                </div>
            }

            <form asp-action="VerifyOtp"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="form-group">

                    <label>
                        Verification Code
                    </label>

                    <div class="otp-container">

                        <input type="text"
                               class="otp-box"
                               maxlength="1"
                               inputmode="numeric"
                               autocomplete="one-time-code" />

                        <input type="text"
                               class="otp-box"
                               maxlength="1"
                               inputmode="numeric" />

                        <input type="text"
                               class="otp-box"
                               maxlength="1"
                               inputmode="numeric" />

                        <input type="text"
                               class="otp-box"
                               maxlength="1"
                               inputmode="numeric" />

                        <input type="text"
                               class="otp-box"
                               maxlength="1"
                               inputmode="numeric" />

                        <input type="text"
                               class="otp-box"
                               maxlength="1"
                               inputmode="numeric" />

                    </div>

                    <input type="hidden"
                           id="otp"
                           name="otp" />

                </div>

                <button type="submit"
                        class="reset-btn">

                    Verify Code

                    <i class="bi bi-arrow-right"></i>

                </button>

            </form>

            <div class="back-login">

                <a asp-action="ForgotPassword">

                    <i class="bi bi-arrow-left"></i>

                    Request a new code

                </a>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        const otpBoxes =
            document.querySelectorAll(".otp-box");

        const hiddenOtp =
            document.getElementById("otp");

        otpBoxes.forEach((box, index) => {

            box.addEventListener("input", function () {

                this.value =
                    this.value.replace(/\D/g, "");

                if (this.value &&
                    index < otpBoxes.length - 1) {

                    otpBoxes[index + 1].focus();
                }

                updateOtp();
            });

            box.addEventListener("keydown", function (event) {

                if (event.key === "Backspace" &&
                    !this.value &&
                    index > 0) {

                    otpBoxes[index - 1].focus();
                }

                updateOtp();
            });

            box.addEventListener("paste", function (event) {

                event.preventDefault();

                const pasted =
                    event.clipboardData
                        .getData("text")
                        .replace(/\D/g, "")
                        .slice(0, 6);

                pasted.split("").forEach((digit, i) => {

                    if (otpBoxes[i]) {
                        otpBoxes[i].value = digit;
                    }

                });

                updateOtp();

                if (pasted.length > 0) {

                    otpBoxes[
                        Math.min(pasted.length, 6) - 1
                    ].focus();

                }

            });

        });

        function updateOtp() {

            let otp = "";

            otpBoxes.forEach(box => {
                otp += box.value;
            });

            hiddenOtp.value = otp;
        }

    </script>
}

@section Styles {

    <link rel="stylesheet"
          href="~/css/forgot-password.css"
          asp-append-version="true" />

}