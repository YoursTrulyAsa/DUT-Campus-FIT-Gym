@model IEnumerable<DUT_Campus_FIT_Gym.Models.FitnessChallenge>

@{
    ViewData["Title"] = "My Fitness Challenges";

    var challenges =
        Model?.ToList() ??
        new List<DUT_Campus_FIT_Gym.Models.FitnessChallenge>();

    var proofs =
        ViewBag.Proofs as Dictionary<int, DUT_Campus_FIT_Gym.Models.ChallengeProof>
        ?? new Dictionary<int, DUT_Campus_FIT_Gym.Models.ChallengeProof>();
}

<div class="challenge-list-page">

    <div class="challenge-list-header">

        <div>
            <span class="challenge-eyebrow">
                FITNESS
            </span>

            <h1>
                My Fitness Challenges
            </h1>

            <p>
                Complete your accepted challenges, submit proof and earn reward points.
            </p>
        </div>

        <a asp-action="Index"
           class="challenge-create-btn">

            <i class="fa-solid fa-wand-magic-sparkles"></i>

            Create Challenge

        </a>

    </div>

    @if (TempData["ChallengeSuccess"] != null)
    {
        <div class="challenge-alert challenge-alert-success">

            <i class="fa-solid fa-circle-check"></i>

            <span>
                @TempData["ChallengeSuccess"]
            </span>

        </div>
    }

    @if (TempData["ChallengeError"] != null)
    {
        <div class="challenge-alert challenge-alert-error">

            <i class="fa-solid fa-circle-exclamation"></i>

            <span>
                @TempData["ChallengeError"]
            </span>

        </div>
    }

    @if (!challenges.Any())
    {
        <div class="challenge-empty">

            <div class="challenge-empty-icon">
                <i class="fa-solid fa-trophy"></i>
            </div>

            <h2>
                No Challenges Yet
            </h2>

            <p>
                Generate your first AI fitness challenge and start earning reward points.
            </p>

            <a asp-action="Index"
               class="challenge-create-btn">

                <i class="fa-solid fa-plus"></i>

                Create Challenge

            </a>

        </div>
    }
    else
    {
        <div class="challenge-list">

            @foreach (var challenge in challenges)
            {
                var level =
                    challenge.Level?.Trim() ?? "Beginner";

                if (level.Equals(
                    "Advanced",
                    StringComparison.OrdinalIgnoreCase))
                {
                    level = "Pro";
                }

                var levelClass =
                    level.ToLower();

                var rewardPoints =
                    challenge.RewardPoints;

                proofs.TryGetValue(
                    challenge.FitnessChallengeId,
                    out var proof);

                var proofStatus =
                    proof?.Status?.Trim() ?? "";

                var isCompleted =
                    challenge.Participation?.Status?.Equals(
                        "Completed",
                        StringComparison.OrdinalIgnoreCase) == true;

                var isPending =
                    proofStatus.Equals(
                        "PendingReview",
                        StringComparison.OrdinalIgnoreCase);

                var isRejected =
                    proofStatus.Equals(
                        "Rejected",
                        StringComparison.OrdinalIgnoreCase);

                <div class="challenge-card">

                    <div class="challenge-card-top">

                        <div class="challenge-card-title">

                            <div class="challenge-card-icon">
                                <i class="fa-solid fa-trophy"></i>
                            </div>

                            <div>

                                <span class="challenge-card-category">
                                    @challenge.Category
                                </span>

                                <h2>
                                    @challenge.Title
                                </h2>

                            </div>

                        </div>

                        <div class="challenge-reward-badge">

                            <i class="fa-solid fa-star"></i>

                            <div>
                                <span>REWARD</span>
                                <strong>+@rewardPoints</strong>
                            </div>

                        </div>

                    </div>

                    <div class="challenge-level-row">

                        <span class="challenge-level-badge @levelClass">
                            @level
                        </span>

                        <span>
                            @rewardPoints reward points available
                        </span>

                    </div>

                    <div class="challenge-card-content">

                        <p class="challenge-description">
                            @challenge.Description
                        </p>

                        <div class="challenge-target-box">

                            <div class="challenge-target-icon">
                                <i class="fa-solid fa-bullseye"></i>
                            </div>

                            <div>

                                <span>
                                    TARGET
                                </span>

                                <strong>
                                    @challenge.Target
                                </strong>

                            </div>

                        </div>

                    </div>

                    @if (isCompleted)
                    {
                        <div class="challenge-completed">

                            <div class="challenge-completed-icon">
                                <i class="fa-solid fa-circle-check"></i>
                            </div>

                            <div>

                                <strong>
                                    Challenge completed
                                </strong>

                                <span>
                                    Your proof was approved and you earned +@rewardPoints reward points.
                                </span>

                            </div>

                        </div>
                    }
                    else if (isPending)
                    {
                        <div class="challenge-pending">

                            <div class="challenge-pending-icon">
                                <i class="fa-solid fa-hourglass-half"></i>
                            </div>

                            <div>

                                <strong>
                                    Proof pending review
                                </strong>

                                <span>
                                    Your 5-minute video has been submitted and is waiting for a trainer to review it.
                                </span>

                            </div>

                        </div>
                    }
                    else if (isRejected)
                    {
                        <div class="challenge-rejected">

                            <div class="challenge-rejected-icon">
                                <i class="fa-solid fa-rotate-right"></i>
                            </div>

                            <div class="challenge-rejected-content">

                                <strong>
                                    Proof rejected
                                </strong>

                                <span>
                                    Your trainer did not approve the previous submission.
                                </span>

                                @if (proof != null &&
                                     !string.IsNullOrWhiteSpace(proof.TrainerComment))
                                {
                                    <span style="margin-top: 8px;">
                                        <strong>Trainer feedback:</strong>
                                        @proof.TrainerComment
                                    </span>
                                }

                                <a asp-action="SubmitProof"
                                   asp-route-id="@challenge.FitnessChallengeId"
                                   class="challenge-resubmit-btn">

                                    <i class="fa-solid fa-video"></i>

                                    Submit New Proof

                                </a>

                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="challenge-card-footer">

                            <div class="challenge-footer-info">

                                <i class="fa-solid fa-video"></i>

                                <div>

                                    <strong>
                                        Ready to complete this challenge?
                                    </strong>

                                    <span>
                                        Record a 5-minute proof video and submit it for trainer review.
                                    </span>

                                </div>

                            </div>

                            <a asp-action="SubmitProof"
                               asp-route-id="@challenge.FitnessChallengeId"
                               class="challenge-complete-btn">

                                <i class="fa-solid fa-video"></i>

                                Submit Proof

                                <span>
                                    +@rewardPoints
                                </span>

                            </a>

                        </div>
                    }

                </div>
            }
        </div>
    }

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/fitness-challenge.css"
          asp-append-version="true" />

    <style>
        .challenge-alert {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px 18px;
            margin-bottom: 22px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 600;
        }

        .challenge-alert-success {
            background: #ecfdf5;
            color: #047857;
            border: 1px solid #a7f3d0;
        }

        .challenge-alert-error {
            background: #fef2f2;
            color: #b91c1c;
            border: 1px solid #fecaca;
        }

        .challenge-pending {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 18px;
            margin-top: 22px;
            border-radius: 14px;
            background: #fff7ed;
            border: 1px solid #fed7aa;
        }

        .challenge-pending-icon {
            width: 44px;
            height: 44px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            background: #ffedd5;
            color: #ea580c;
        }

        .challenge-pending strong,
        .challenge-rejected strong {
            display: block;
            color: #1e293b;
            margin-bottom: 4px;
        }

        .challenge-pending span,
        .challenge-rejected span {
            display: block;
            color: #64748b;
            font-size: 13px;
            line-height: 1.5;
        }

        .challenge-rejected {
            display: flex;
            align-items: flex-start;
            gap: 15px;
            padding: 18px;
            margin-top: 22px;
            border-radius: 14px;
            background: #fef2f2;
            border: 1px solid #fecaca;
        }

        .challenge-rejected-icon {
            width: 44px;
            height: 44px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            background: #fee2e2;
            color: #dc2626;
        }

        .challenge-rejected-content {
            flex: 1;
        }

        .challenge-resubmit-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-top: 12px;
            padding: 9px 14px;
            border-radius: 9px;
            background: #0b2d52;
            color: #ffffff;
            text-decoration: none;
            font-size: 13px;
            font-weight: 700;
        }

        .challenge-resubmit-btn:hover {
            background: #071a33;
            color: #ffffff;
        }

        @@media (max-width: 650px) {
            .challenge-pending,
            .challenge-rejected {
                align-items: flex-start;
            }
        }
    </style>
}