@{
    ViewData["Title"] = "Fitness Challenges";

    var fitnessLevel =
        ViewBag.FitnessLevel as string ?? "";
}

<div class="fitness-challenge-page">

    <div class="fitness-challenge-header">

        <div>
            <span class="fitness-challenge-eyebrow">
                DUT CAMPUS FIT GYM
            </span>

            <h1>
                Fitness Challenges
            </h1>

            <p>
                Create an AI-generated challenge based on your Fitness Profile.
            </p>
        </div>

        <div class="fitness-challenge-header-icon">
            <i class="fa-solid fa-trophy"></i>
        </div>

    </div>

    @if (ViewBag.Error != null)
    {
        <div class="fitness-challenge-error">
            @ViewBag.Error
        </div>
    }

    <div class="fitness-challenge-form-card">

        <div class="fitness-challenge-form-header">

            <span>
                YOUR FITNESS LEVEL
            </span>

            <h2>
                @fitnessLevel
            </h2>

            <p>
                Your challenge difficulty is automatically matched to the fitness level saved in your Fitness Profile.
            </p>

        </div>

        <form asp-action="Generate"
              method="post">

            @Html.AntiForgeryToken()

            <div class="fitness-challenge-form-grid">

                <div class="fitness-challenge-field">

                    <label>
                        Fitness Level
                    </label>

                    <div class="fitness-profile-level-display">
                        <i class="fa-solid fa-person-running"></i>

                        <span>
                            @fitnessLevel
                        </span>
                    </div>

                </div>

                <div class="fitness-challenge-field">

                    <label for="category">
                        Category
                    </label>

                    <select id="category"
                            name="category"
                            required>

                        <option value="">
                            Select a category
                        </option>

                        <option value="Cardio">
                            Cardio
                        </option>

                        <option value="Strength">
                            Strength
                        </option>

                        <option value="Yoga">
                            Yoga
                        </option>

                    </select>

                </div>

            </div>

            <button type="submit"
                    class="fitness-challenge-button">

                <i class="fa-solid fa-wand-magic-sparkles"></i>

                Generate Challenge

            </button>

        </form>

    </div>

    <div class="fitness-challenge-info-grid">

        <div class="fitness-challenge-info-card">

            <i class="fa-solid fa-user-check"></i>

            <div>

                <h3>
                    Based on your Fitness Profile
                </h3>

                <p>
                    Your fitness level is automatically used to make the challenge appropriate for you.
                </p>

            </div>

        </div>

        <div class="fitness-challenge-info-card">

            <i class="fa-solid fa-star"></i>

            <div>

                <h3>
                    Earn reward points
                </h3>

                <p>
                    Complete an accepted challenge to earn reward points based on your fitness level.
                </p>

            </div>

        </div>

    </div>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/fitness-challenge.css"
          asp-append-version="true" />
}