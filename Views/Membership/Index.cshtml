@model List<DUT_Campus_FIT_Gym.Models.Membership>

@{
    ViewData["Title"] = "Manage Memberships";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Manage Memberships</h1>
            <p class="text-muted">
                Review and manage student membership applications.
            </p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">
                    <h5>No membership applications found.</h5>
                    <p class="text-muted">
                        There are currently no membership applications to review.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>Student</th>
                                <th>Student Number</th>
                                <th>Membership Type</th>
                                <th>Price</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var membership in Model)
                            {
                                <tr>

                                    <td>
                                        @if (membership.Member != null)
                                        {
                                            <strong>
                                                @membership.Member.Name
                                                @membership.Member.Surname
                                            </strong>

                                            <br />

                                            <small class="text-muted">
                                                @membership.Member.Email
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Member unavailable
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @(membership.Member?.StudentNumber ?? "N/A")
                                    </td>

                                    <td>
                                        @(membership.MembershipType ?? "N/A")
                                    </td>

                                    <td>
                                        <strong>
                                            R @membership.Price.ToString("0.00")
                                        </strong>
                                    </td>

                                    <td>
                                        @if (membership.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else if (membership.Status == "WaitingForPayment")
                                        {
                                            <span class="badge bg-info text-dark">
                                                Waiting for Payment
                                            </span>
                                        }
                                        else if (membership.Status == "Active")
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else if (membership.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @membership.Status
                                            </span>
                                        }
                                    </td>

                                    <td>

                                        @if (membership.Status == "Pending")
                                        {
                                            <div class="d-flex gap-2">

                                                <form asp-action="Approve"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@membership.MembershipId" />

                                                    <button type="submit"
                                                            class="btn btn-success btn-sm">
                                                        Approve
                                                    </button>

                                                </form>

                                                <form asp-action="Reject"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@membership.MembershipId" />

                                                    <button type="submit"
                                                            class="btn btn-danger btn-sm">
                                                        Reject
                                                    </button>

                                                </form>

                                            </div>
                                        }
                                        else if (membership.Status == "WaitingForPayment")
                                        {
                                            <span class="text-muted">
                                                Awaiting payment
                                            </span>
                                        }
                                        else if (membership.Status == "Active")
                                        {
                                            <span class="text-success">
                                                Paid
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No action
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

</div>