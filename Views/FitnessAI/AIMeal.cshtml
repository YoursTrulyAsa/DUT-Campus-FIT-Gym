@{
    ViewData["Title"] = "AI Meal Suggestions";

    var fitnessLevel =
        ViewBag.FitnessLevel as string ?? "";

    var fitnessGoal =
        ViewBag.FitnessGoal as string ?? "";
}

<div class="ai-meal-page">

    <div class="ai-meal-header">

        <div>

            <span class="ai-meal-eyebrow">
                FITNESS AI
            </span>

            <h1>
                AI Meal Suggestions
            </h1>

            <p>
                Your meal suggestions are based on your Fitness Profile,
                fitness level, fitness goal and food preferences.
            </p>

        </div>

        <div class="ai-meal-icon">
            <i class="fa-solid fa-utensils"></i>
        </div>

    </div>

    <div class="ai-meal-layout">

        <div class="ai-meal-form-card">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mb-4">
                    @ViewBag.Error
                </div>
            }

            <div class="ai-section-heading">

                <span>
                    01
                </span>

                <div>

                    <h2>
                        Your Fitness Profile
                    </h2>

                    <p>
                        These details are automatically taken from your Fitness Profile.
                    </p>

                </div>

            </div>

            <div class="ai-profile-summary">

                <div class="ai-profile-summary-item">

                    <span>
                        FITNESS LEVEL
                    </span>

                    <strong>
                        @fitnessLevel
                    </strong>

                </div>

                <div class="ai-profile-summary-item">

                    <span>
                        FITNESS GOAL
                    </span>

                    <strong>
                        @fitnessGoal
                    </strong>

                </div>

            </div>

            <div class="ai-section-heading">

                <span>
                    02
                </span>

                <div>

                    <h2>
                        Your food preferences
                    </h2>

                    <p>
                        Tell Fitness AI about the foods you prefer.
                    </p>

                </div>

            </div>

            <form asp-controller="FitnessAI"
                  asp-action="GenerateMealPlan"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="ai-form-group">

                    <label for="dietaryPreference">
                        Dietary Preference
                    </label>

                    <select id="dietaryPreference"
                            name="dietaryPreference">

                        <option value="">
                            No specific preference
                        </option>

                        <option value="Vegetarian">
                            Vegetarian
                        </option>

                        <option value="Vegan">
                            Vegan
                        </option>

                        <option value="Halal">
                            Halal
                        </option>

                        <option value="No pork">
                            No pork
                        </option>

                        <option value="No beef">
                            No beef
                        </option>

                        <option value="No seafood">
                            No seafood
                        </option>

                    </select>

                </div>

                <div class="ai-form-group">

                    <label for="foodPreferences">
                        Food Preferences
                    </label>

                    <textarea id="foodPreferences"
                              name="foodPreferences"
                              rows="4"
                              maxlength="500"
                              placeholder="Optional — e.g. chicken, rice, fruit, vegetables, yoghurt"></textarea>

                    <span class="ai-input-hint">
                        Add foods you enjoy or would like included.
                    </span>

                </div>

                <div class="ai-safety-note">

                    <i class="fa-solid fa-shield-halved"></i>

                    <p>
                        Fitness AI provides general meal ideas and is not a
                        substitute for individual medical or dietary advice.
                    </p>

                </div>

                <button type="submit"
                        class="ai-generate-btn">

                    <i class="fa-solid fa-wand-magic-sparkles"></i>

                    Generate Meal Suggestions

                </button>

            </form>

        </div>

        <div class="ai-meal-info-card">

            <div class="ai-info-icon">
                <i class="fa-solid fa-robot"></i>
            </div>

            <span>
                POWERED BY FITNESS AI
            </span>

            <h2>
                Better choices,
                intelligently suggested.
            </h2>

            <p>
                Fitness AI uses your Fitness Profile and food preferences
                to create practical meal ideas for your routine.
            </p>

            <div class="ai-info-list">

                <div>
                    <i class="fa-solid fa-check"></i>
                    <span>Fitness-level matched meals</span>
                </div>

                <div>
                    <i class="fa-solid fa-check"></i>
                    <span>Goal-based suggestions</span>
                </div>

                <div>
                    <i class="fa-solid fa-check"></i>
                    <span>Breakfast suggestion</span>
                </div>

                <div>
                    <i class="fa-solid fa-check"></i>
                    <span>Lunch, snack and dinner</span>
                </div>

            </div>

        </div>

    </div>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/ai-meal.css"
          asp-append-version="true" />
}