@{
    ViewData["Title"] = "AI Workout Plan";

    string fitnessLevel = ViewBag.FitnessLevel as string ?? "Not set";
    string fitnessGoal = ViewBag.FitnessGoal as string ?? "Not set";
}

<div class="ai-workout-page">

    <div class="ai-workout-header">

        <div>
            <span class="ai-workout-eyebrow">
                FITNESS AI
            </span>

            <h1>
                AI Workout Plan
            </h1>

            <p>
                Fitness AI uses your fitness profile to create a structured
                4-week workout programme based on your goals and availability.
            </p>
        </div>

        <div class="ai-workout-icon">
            <i class="fa-solid fa-dumbbell"></i>
        </div>

    </div>

    <div class="ai-workout-layout">

        <div class="ai-workout-form-card">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mb-4">
                    @ViewBag.Error
                </div>
            }

            <div class="ai-section-heading">

                <span>
                    01
                </span>

                <div>
                    <h2>
                        Your programme
                    </h2>

                    <p>
                        Your level and goal are taken from your Fitness Profile.
                    </p>
                </div>

            </div>

            <div class="ai-form-group">

                <label>
                    Fitness Level
                </label>

                <div class="ai-profile-value">
                    <i class="fa-solid fa-chart-line"></i>
                    <span>@fitnessLevel</span>
                </div>

                <span class="ai-input-hint">
                    Your fitness level is managed from your Fitness Profile.
                </span>

            </div>

            <div class="ai-form-group">

                <label>
                    Fitness Goal
                </label>

                <div class="ai-profile-value">
                    <i class="fa-solid fa-bullseye"></i>
                    <span>@fitnessGoal</span>
                </div>

                <span class="ai-input-hint">
                    Your fitness goal is managed from your Fitness Profile.
                </span>

            </div>

            <div class="ai-section-heading">

                <span>
                    02
                </span>

                <div>
                    <h2>
                        Training preferences
                    </h2>

                    <p>
                        Tell Fitness AI how you want your programme structured.
                    </p>
                </div>

            </div>

            <form asp-controller="FitnessAI"
                  asp-action="GenerateWorkout"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="ai-form-group">

                    <label for="preferredExercises">
                        Preferred Exercises
                    </label>

                    <textarea id="preferredExercises"
                              name="preferredExercises"
                              rows="4"
                              maxlength="500"
                              placeholder="Optional — e.g. squats, push-ups, walking"></textarea>

                    <span class="ai-input-hint">
                        Leave this blank if you want Fitness AI to choose suitable exercises from the gym exercise library.
                    </span>

                </div>

                <div class="ai-form-group">

                    <label for="daysAvailable">
                        Days Available
                    </label>

                    <select id="daysAvailable"
                            name="daysAvailable"
                            required>

                        <option value="">
                            Select days per week
                        </option>

                        <option value="2">
                            2 days
                        </option>

                        <option value="3">
                            3 days
                        </option>

                        <option value="4">
                            4 days
                        </option>

                        <option value="5">
                            5 days
                        </option>

                    </select>

                    <span class="ai-input-hint">
                        Your programme will use this number of training days each week.
                    </span>

                </div>

                <div class="ai-safety-note">

                    <i class="fa-solid fa-shield-halved"></i>

                    <p>
                        Fitness AI provides general fitness suggestions.
                        Use appropriate technique, train at a suitable intensity
                        and speak with a qualified trainer if you need individual guidance.
                    </p>

                </div>

                <button type="submit"
                        class="ai-generate-btn">

                    <i class="fa-solid fa-wand-magic-sparkles"></i>

                    Generate 4-Week Programme

                </button>

            </form>

        </div>

        <div class="ai-workout-info-card">

            <div class="ai-info-icon">
                <i class="fa-solid fa-robot"></i>
            </div>

            <span>
                POWERED BY FITNESS AI
            </span>

            <h2>
                Your plan,
                intelligently generated.
            </h2>

            <p>
                Fitness AI will use your Fitness Profile, exercise preferences
                and available training days to create a structured 4-week
                programme that you can review before saving.
            </p>

            <div class="ai-info-list">

                <div>
                    <i class="fa-solid fa-check"></i>
                    <span>Profile-based training level</span>
                </div>

                <div>
                    <i class="fa-solid fa-check"></i>
                    <span>Goal-based programme</span>
                </div>

                <div>
                    <i class="fa-solid fa-check"></i>
                    <span>4-week progression</span>
                </div>

                <div>
                    <i class="fa-solid fa-check"></i>
                    <span>Review before saving</span>
                </div>

            </div>

        </div>

    </div>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/ai-workout.css"
          asp-append-version="true" />
}