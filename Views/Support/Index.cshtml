@{
    ViewData["Title"] = "Ask Us";
}

<div class="support-page">

    <div class="support-container">

        <div class="support-header">

            <div class="support-icon">
                <i class="fa-solid fa-comments"></i>
            </div>

            <div>
                <h1>Ask Us</h1>

                <p>
                    Need help with the DUT Campus FIT Gym system?
                    Ask a question and our support assistant will help.
                </p>
            </div>

        </div>


        <div class="support-card">

            <form asp-controller="Support"
                  asp-action="Index"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">

                    <label for="question"
                           class="form-label">
                        Your Question
                    </label>

                    <textarea id="question"
                              name="question"
                              class="form-control"
                              rows="5"
                              placeholder="Example: How do I apply for gym membership?"
                              required>@ViewBag.Question</textarea>

                </div>


                <button type="submit"
                        class="btn btn-primary support-button">

                    <i class="fa-solid fa-paper-plane"></i>

                    Ask Us

                </button>

            </form>


            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-4">

                    <i class="fa-solid fa-circle-exclamation"></i>

                    @ViewBag.Error

                </div>
            }


            @if (ViewBag.Answer != null)
            {
                <div class="answer-card mt-4">

                    <div class="answer-header">

                        <i class="fa-solid fa-robot"></i>

                        <strong>
                            AskUs Assistant
                        </strong>

                    </div>

                    <div class="answer-content">

                        @ViewBag.Answer

                    </div>

                </div>
            }

        </div>


        <div class="support-notice">

            <i class="fa-solid fa-shield-halved"></i>

            <span>
                Do not enter passwords, banking details,
                card numbers, PINs or other sensitive information.
            </span>

        </div>

    </div>
   
</div>

@section Styles {

    <style>

        .support-page {
            min-height: 100vh;
            padding: 40px;
        }

        .support-container {
            max-width: 900px;
            margin: 0 auto;
        }

        .support-header {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 30px;
        }

        .support-icon {
            width: 60px;
            height: 60px;
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #0d6efd;
            color: white;
            font-size: 25px;
        }

        .support-header h1 {
            margin: 0;
            font-weight: 700;
        }

        .support-header p {
            margin: 5px 0 0;
            color: #6c757d;
        }

        .support-card {
            background: white;
            border-radius: 18px;
            padding: 30px;
            box-shadow: 0 5px 25px rgba(0, 0, 0, 0.08);
        }

        .support-button {
            padding: 10px 25px;
            border-radius: 10px;
        }

        .answer-card {
            border-radius: 15px;
            padding: 20px;
            background: #f8f9fa;
            border: 1px solid #dee2e6;
        }

        .answer-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 15px;
            font-size: 17px;
        }

        .answer-content {
            line-height: 1.7;
            white-space: pre-line;
        }

        .support-notice {
            margin-top: 20px;
            padding: 15px;
            border-radius: 12px;
            background: #fff3cd;
            color: #664d03;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        @@media (max-width: 768px) {

            .support-page {
                padding: 20px;
            }

            .support-header {
                align-items: flex-start;
            }

            .support-card {
                padding: 20px;
            }
        }

    </style>
}

