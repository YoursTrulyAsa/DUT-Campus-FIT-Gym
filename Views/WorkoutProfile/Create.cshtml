@model DUT_Campus_FIT_Gym.Models.WorkoutProfile

@{
    ViewData["Title"] = "Create Fitness Profile";
}

<div class="fitness-profile-form-page">

    <div class="fitness-profile-form-header">

        <a asp-action="Index"
           class="fitness-profile-back-btn">

            <i class="fa-solid fa-arrow-left"></i>

            Back to Profile

        </a>

        <span class="fitness-profile-eyebrow">
            DUT CAMPUS FIT GYM
        </span>

        <h1>
            Create Your Fitness Profile
        </h1>

        <p>
            Add a few details to help personalize your FIT Gym experience.
        </p>

    </div>

    <div class="fitness-profile-form-card">

        <div class="fitness-profile-form-card-header">

            <div class="fitness-profile-form-icon">
                <i class="fa-solid fa-user-plus"></i>
            </div>

            <div>
                <span class="fitness-profile-card-label">
                    PROFILE INFORMATION
                </span>

                <h2>
                    Your Details
                </h2>

                <p>
                    Enter your current information below.
                </p>
            </div>

        </div>

        <form asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="fitness-profile-validation">
            </div>

            <div class="fitness-profile-form-grid">

                <div class="fitness-profile-field">

                    <label asp-for="Age">
                        Age
                    </label>

                    <div class="fitness-profile-input-wrapper">

                        <i class="fa-solid fa-cake-candles"></i>

                        <input asp-for="Age"
                               type="number"
                               min="13"
                               max="100"
                               placeholder="Enter your age" />

                    </div>

                    <span asp-validation-for="Age"
                          class="fitness-profile-field-error">
                    </span>

                </div>

                <div class="fitness-profile-field">

                    <label asp-for="Weight">
                        Weight
                    </label>

                    <div class="fitness-profile-input-wrapper">

                        <i class="fa-solid fa-weight-scale"></i>

                        <input asp-for="Weight"
                               type="number"
                               step="0.1"
                               min="1"
                               max="500"
                               placeholder="Enter your weight" />

                        <span>
                            kg
                        </span>

                    </div>

                    <span asp-validation-for="Weight"
                          class="fitness-profile-field-error">
                    </span>

                </div>

                <div class="fitness-profile-field">

                    <label asp-for="Height">
                        Height
                    </label>

                    <div class="fitness-profile-input-wrapper">

                        <i class="fa-solid fa-ruler-vertical"></i>

                        <input asp-for="Height"
                               type="number"
                               step="0.1"
                               min="1"
                               max="300"
                               placeholder="Enter your height" />

                        <span>
                            cm
                        </span>

                    </div>

                    <span asp-validation-for="Height"
                          class="fitness-profile-field-error">
                    </span>

                </div>

                <div class="fitness-profile-field">

                    <label asp-for="FitnessLevel">
                        Fitness Level
                    </label>

                    <div class="fitness-profile-input-wrapper">

                        <i class="fa-solid fa-signal"></i>

                        <select asp-for="FitnessLevel">

                            <option value="Beginner">
                                Beginner
                            </option>

                            <option value="Intermediate">
                                Intermediate
                            </option>

                            <option value="Pro">
                                Pro
                            </option>

                        </select>

                    </div>

                    <span asp-validation-for="FitnessLevel"
                          class="fitness-profile-field-error">
                    </span>

                </div>

                <div class="fitness-profile-field">

                    <label asp-for="Goal">
                        Fitness Goal
                    </label>

                    <div class="fitness-profile-input-wrapper">

                        <i class="fa-solid fa-bullseye"></i>

                        <select asp-for="Goal">

                            <option value="General fitness">
                                General fitness
                            </option>

                            <option value="Strength">
                                Strength
                            </option>

                            <option value="Endurance">
                                Endurance
                            </option>

                            <option value="Mobility and flexibility">
                                Mobility and flexibility
                            </option>

                        </select>

                    </div>

                    <span asp-validation-for="Goal"
                          class="fitness-profile-field-error">
                    </span>

                </div>

            </div>

            <div class="fitness-profile-form-note">

                <i class="fa-solid fa-circle-info"></i>

                <p>
                    Your fitness level and goal will be used to create
                    a personalised multi-week workout programme.
                </p>

            </div>

            <div class="fitness-profile-form-actions">

                <a asp-action="Index"
                   class="fitness-profile-cancel-btn">
                    Cancel
                </a>

                <button type="submit"
                        class="fitness-profile-save-btn">

                    <i class="fa-solid fa-check"></i>

                    Save Profile

                </button>

            </div>

        </form>

    </div>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/workout-profile.css"
          asp-append-version="true" />
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}