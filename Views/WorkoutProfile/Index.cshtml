@model DUT_Campus_FIT_Gym.Models.WorkoutProfile

@{
    ViewData["Title"] = "Fitness Profile";
    var weightHistory = ViewBag.WeightHistory as List<DUT_Campus_FIT_Gym.Models.WeightHistory>
        ?? new List<DUT_Campus_FIT_Gym.Models.WeightHistory>();
}

<div class="fitness-profile-page">

    <div class="fitness-profile-header">

        <div>
            <span class="fitness-profile-eyebrow">
                DUT CAMPUS FIT GYM
            </span>

            <h1>
                Fitness Profile
            </h1>

            <p>
                Manage the information used to personalize your fitness experience.
            </p>
        </div>

        <div class="fitness-profile-header-icon">
            <i class="fa-solid fa-user"></i>
        </div>

    </div>

    @if (Model == null)
    {
        <div class="fitness-profile-empty">

            <div class="fitness-profile-empty-icon">
                <i class="fa-solid fa-user-plus"></i>
            </div>

            <div>
                <span class="fitness-profile-card-label">
                    GET STARTED
                </span>

                <h2>
                    Create your fitness profile
                </h2>

                <p>
                    Add a few basic details so FIT Gym can personalize
                    your workout programme.
                </p>

                <a asp-action="Create"
                   class="fitness-profile-primary-btn">

                    <i class="fa-solid fa-plus"></i>

                    Create Profile

                </a>
            </div>

        </div>
    }
    else
    {
        <div class="fitness-profile-grid">

            <div class="fitness-profile-main-card">

                <div class="fitness-profile-card-header">

                    <div>
                        <span class="fitness-profile-card-label">
                            YOUR PROFILE
                        </span>

                        <h2>
                            Fitness Information
                        </h2>
                    </div>

                    <a asp-action="Edit"
                       class="fitness-profile-edit-btn">

                        <i class="fa-solid fa-pen"></i>

                        Edit

                    </a>

                </div>

                <div class="fitness-profile-stat-grid">

                    <div class="fitness-profile-stat">

                        <div class="fitness-profile-stat-icon">
                            <i class="fa-solid fa-signal"></i>
                        </div>

                        <div>
                            <span>
                                FITNESS LEVEL
                            </span>

                            <strong>
                                @Model.FitnessLevel
                            </strong>
                        </div>

                    </div>

                    <div class="fitness-profile-stat">

                        <div class="fitness-profile-stat-icon">
                            <i class="fa-solid fa-bullseye"></i>
                        </div>

                        <div>
                            <span>
                                FITNESS GOAL
                            </span>

                            <strong class="fitness-profile-goal">
                                @Model.Goal
                            </strong>
                        </div>

                    </div>

                    <div class="fitness-profile-stat">

                        <div class="fitness-profile-stat-icon">
                            <i class="fa-solid fa-cake-candles"></i>
                        </div>

                        <div>
                            <span>
                                AGE
                            </span>

                            <strong>
                                @Model.Age
                            </strong>

                            <small>
                                years
                            </small>
                        </div>

                    </div>

                    <div class="fitness-profile-stat">

                        <div class="fitness-profile-stat-icon">
                            <i class="fa-solid fa-ruler-vertical"></i>
                        </div>

                        <div>
                            <span>
                                HEIGHT
                            </span>

                            <strong>
                                @Model.Height.ToString("0.0")
                            </strong>

                            <small>
                                cm
                            </small>
                        </div>

                    </div>

                </div>

                <div class="fitness-profile-weight-row">

                    <div class="fitness-profile-stat-icon">
                        <i class="fa-solid fa-weight-scale"></i>
                    </div>

                    <div>
                        <span>
                            CURRENT WEIGHT
                        </span>

                        <strong>
                            @Model.Weight.ToString("0.0") kg
                        </strong>
                    </div>

                </div>

            </div>

            <div class="fitness-profile-side-card">

                <div class="fitness-profile-side-icon">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                </div>

                <span class="fitness-profile-card-label">
                    FITNESS AI
                </span>

                <h2>
                    Your Programme
                </h2>

                <p>
                    Your selected fitness level and goal will be used
                    to create your personalised multi-week workout programme.
                </p>

                <div class="fitness-profile-ai-summary">

                    <span>
                        CURRENT LEVEL
                    </span>

                    <strong>
                        @Model.FitnessLevel
                    </strong>

                    <span>
                        CURRENT GOAL
                    </span>

                    <strong>
                        @Model.Goal
                    </strong>

                </div>

                <a asp-controller="FitnessAI"
                   asp-action="AIWorkout"
                   class="fitness-profile-ai-btn">

                    <i class="fa-solid fa-dumbbell"></i>

                    Create AI Programme

                </a>

            </div>

        </div>

        <div class="fitness-profile-history-card">

            <div class="fitness-profile-card-header">

                <div>
                    <span class="fitness-profile-card-label">
                        WEIGHT PROGRESS
                    </span>

                    <h2>
                        Weight History
                    </h2>
                </div>

                <div class="fitness-profile-history-icon">
                    <i class="fa-solid fa-chart-line"></i>
                </div>

            </div>

            @if (weightHistory.Any())
            {
                <div class="fitness-profile-history-summary">

                    <div>
                        <span>
                            STARTING WEIGHT
                        </span>

                        <strong>
                            @weightHistory.Last().Weight.ToString("0.0") kg
                        </strong>
                    </div>

                    <div>
                        <span>
                            CURRENT WEIGHT
                        </span>

                        <strong>
                            @Model.Weight.ToString("0.0") kg
                        </strong>
                    </div>

                    <div>
                        <span>
                            RECORDS
                        </span>

                        <strong>
                            @weightHistory.Count
                        </strong>
                    </div>

                </div>

                <div class="fitness-profile-history-list">

                    @foreach (var entry in weightHistory)
                    {
                        <div class="fitness-profile-history-item">

                            <div class="fitness-profile-history-item-icon">
                                <i class="fa-solid fa-weight-scale"></i>
                            </div>

                            <div class="fitness-profile-history-item-info">

                                <strong>
                                    @entry.Weight.ToString("0.0") kg
                                </strong>

                                <span>
                                    @entry.RecordedAt.ToString("dd MMM yyyy")
                                </span>

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="fitness-profile-history-empty">

                    <i class="fa-solid fa-chart-line"></i>

                    <p>
                        No weight history has been recorded yet.
                    </p>

                </div>
            }

        </div>
    }

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/workout-profile.css"
          asp-append-version="true" />
}