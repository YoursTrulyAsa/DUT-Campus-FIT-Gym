@model DUT_Campus_FIT_Gym.Models.WorkoutProfile

@{
    ViewData["Title"] = "My Workout Profile";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>My Workout Profile</h2>
            <p class="text-muted">
                Your personal information used for your workout planning.
            </p>
        </div>

        @if (Model != null)
        {
            <a asp-controller="WorkoutProfile"
               asp-action="Edit"
               class="btn btn-primary">
                Edit Profile
            </a>
        }
    </div>

    @if (Model == null)
    {
        <div class="alert alert-info">
            <h5>No Workout Profile Found</h5>
            <p>You have not created your workout profile yet.</p>

            <a asp-controller="WorkoutProfile"
               asp-action="Create"
               class="btn btn-primary">
                Create Workout Profile
            </a>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">

                <h4 class="card-title mb-4">My Profile</h4>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <strong>Age</strong>
                        <p>@Model.Age years</p>
                    </div>

                    <div class="col-md-6 mb-3">
                        <strong>Weight</strong>
                        <p>@Model.Weight kg</p>
                    </div>

                    <div class="col-md-6 mb-3">
                        <strong>Height</strong>
                        <p>@Model.Height cm</p>
                    </div>

                    <div class="col-md-6 mb-3">
                        <strong>Fitness Goal</strong>
                        <p>@Model.Goal</p>
                    </div>

                </div>

            </div>
        </div>
    }

</div>
