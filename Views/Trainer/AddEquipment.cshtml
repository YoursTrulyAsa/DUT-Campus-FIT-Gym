@model DUT_Campus_FIT_Gym.Models.Equipment

@{
    ViewData["Title"] = "Add Equipment";
}

<div class="trainer-page">

    <div class="trainer-page-header">

        <span class="trainer-page-label">
            DUT CAMPUS FIT GYM
        </span>

        <h1>
            Add Equipment
        </h1>

        <p>
            Add new equipment to the gym inventory.
        </p>

    </div>

    <div class="trainer-form-card">

        <div class="trainer-section-title">

            <h3>
                Equipment Details
            </h3>

        </div>

        <form asp-controller="Trainer"
              asp-action="AddEquipment"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="trainer-alert trainer-alert-danger">
            </div>

            <div class="trainer-form-group">

                <label asp-for="EquipmentName">
                    Equipment Name
                </label>

                <input asp-for="EquipmentName"
                       class="trainer-form-control"
                       placeholder="e.g. Treadmill" />

                <span asp-validation-for="EquipmentName"
                      class="text-danger">
                </span>

            </div>

            <div class="trainer-form-group">

                <label asp-for="Category">
                    Category
                </label>

                <input asp-for="Category"
                       class="trainer-form-control"
                       placeholder="e.g. Cardio, Strength, Free Weights" />

                <span asp-validation-for="Category"
                      class="text-danger">
                </span>

            </div>

            <div class="trainer-form-group">

                <label asp-for="Location">
                    Location
                </label>

                <input asp-for="Location"
                       class="trainer-form-control"
                       placeholder="e.g. Main Gym Floor" />

                <span asp-validation-for="Location"
                      class="text-danger">
                </span>

            </div>

            <div class="trainer-form-group">

                <label class="d-flex align-items-center gap-2">

                    <input asp-for="IsAvailable"
                           type="checkbox"
                           style="width:18px;height:18px;" />

                    Equipment is available

                </label>

            </div>

            <div class="trainer-actions">

                <button type="submit"
                        class="trainer-btn trainer-btn-success">

                    <i class="fa-solid fa-plus"></i>
                    Add Equipment

                </button>

                <a asp-controller="Trainer"
                   asp-action="Equipment"
                   class="trainer-btn trainer-btn-secondary">

                    <i class="fa-solid fa-arrow-left"></i>
                    Cancel

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/trainer.css"
          asp-append-version="true" />
}