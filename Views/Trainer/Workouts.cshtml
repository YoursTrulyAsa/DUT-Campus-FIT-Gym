@model IEnumerable<DUT_Campus_FIT_Gym.Models.WorkoutPlan>

@{
    ViewData["Title"] = "Manage Workouts";
}

<div class="trainer-page">

    <div class="trainer-page-header">

        <div>
            <span class="trainer-page-label">
                DUT CAMPUS FIT GYM
            </span>

            <h1>
                Manage Workouts
            </h1>

            <p>
                View and manage workout plans assigned to gym members.
            </p>
        </div>

        <div class="trainer-header-actions">

            <a asp-controller="Trainer"
               asp-action="CreateWorkout"
               class="trainer-primary-btn">

                <i class="fa-solid fa-plus"></i>
                Assign Workout

            </a>

            <a asp-controller="Trainer"
               asp-action="Index"
               class="trainer-back-btn">

                <i class="fa-solid fa-arrow-left"></i>
                Dashboard

            </a>

        </div>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="trainer-alert trainer-alert-success">

            <i class="fa-solid fa-circle-check"></i>

            <span>
                @TempData["Success"]
            </span>

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="trainer-alert trainer-alert-error">

            <i class="fa-solid fa-circle-exclamation"></i>

            <span>
                @TempData["Error"]
            </span>

        </div>
    }


    <div class="workouts-summary">

        <div class="workouts-summary-icon">
            <i class="fa-solid fa-dumbbell"></i>
        </div>

        <div>
            <span>
                TOTAL WORKOUT PLANS
            </span>

            <strong>
                @(Model?.Count() ?? 0)
            </strong>
        </div>

    </div>


    <div class="workouts-card">

        <div class="workouts-card-header">

            <div>

                <span class="trainer-section-label">
                    TRAINING PROGRAMS
                </span>

                <h2>
                    Assigned Workouts
                </h2>

            </div>

            <div class="workout-header-icon">
                <i class="fa-solid fa-clipboard-list"></i>
            </div>

        </div>


        <div class="workouts-card-body">

            @if (Model == null || !Model.Any())
            {
                <div class="trainer-empty-state">

                    <div class="empty-icon">
                        <i class="fa-solid fa-dumbbell"></i>
                    </div>

                    <h3>
                        No Workout Plans
                    </h3>

                    <p>
                        No workout plans have been assigned yet.
                    </p>

                    <a asp-controller="Trainer"
                       asp-action="CreateWorkout"
                       class="trainer-primary-btn">

                        <i class="fa-solid fa-plus"></i>
                        Assign First Workout

                    </a>

                </div>
            }
            else
            {
                <div class="workout-list">

                    @foreach (var workout in Model)
                    {
                        <div class="workout-card-item">

                            <div class="workout-item-top">

                                <div class="workout-item-icon">
                                    <i class="fa-solid fa-person-running"></i>
                                </div>

                                <div class="workout-item-title">

                                    <span class="trainer-section-label">
                                        WORKOUT PLAN
                                    </span>

                                    <h3>
                                        @workout.WorkoutName
                                    </h3>

                                </div>

                                <div class="workout-day-badge">

                                    <i class="fa-regular fa-calendar"></i>

                                    @workout.WorkoutDay

                                </div>

                            </div>


                            <div class="workout-item-details">

                                <div class="workout-member">

                                    <span>
                                        <i class="fa-solid fa-user"></i>
                                        MEMBER
                                    </span>

                                    @if (workout.Member != null)
                                    {
                                        <strong>
                                            @workout.Member.Name
                                            @workout.Member.Surname
                                        </strong>

                                        <small>
                                            @workout.Member.StudentNumber
                                        </small>
                                    }
                                    else
                                    {
                                        <strong>
                                            Member unavailable
                                        </strong>
                                    }

                                </div>


                                <div class="workout-detail">

                                    <span>
                                        <i class="fa-solid fa-dumbbell"></i>
                                        EXERCISE
                                    </span>

                                    <strong>
                                        @workout.ExerciseName
                                    </strong>

                                </div>


                                <div class="workout-stat">

                                    <span>
                                        SETS
                                    </span>

                                    <strong>
                                        @workout.Sets
                                    </strong>

                                </div>


                                <div class="workout-stat">

                                    <span>
                                        REPS
                                    </span>

                                    <strong>
                                        @workout.Repetitions
                                    </strong>

                                </div>


                                <div class="workout-stat">

                                    <span>
                                        REST
                                    </span>

                                    <strong>
                                        @workout.RestTime sec
                                    </strong>

                                </div>

                            </div>


                            @if (!string.IsNullOrWhiteSpace(workout.Description))
                            {
                                <div class="workout-description">

                                    <span>
                                        INSTRUCTIONS
                                    </span>

                                    <p>
                                        @workout.Description
                                    </p>

                                </div>
                            }

                        </div>
                    }

                </div>
            }

        </div>

    </div>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/trainer.css"
          asp-append-version="true" />
}
