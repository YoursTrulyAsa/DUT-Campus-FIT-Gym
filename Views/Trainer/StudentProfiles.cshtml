@model IEnumerable<DUT_Campus_FIT_Gym.Models.Member>

@{
    ViewData["Title"] = "Student Workout Profiles";
}

<div class="container mt-5">

    <h1 class="mb-4">Student Workout Profiles</h1>

    <p class="text-muted">
        View student workout information and assigned workout plans.
    </p>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No students are currently registered.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Student Number</th>
                        <th>Email</th>
                        <th>Workout Profile</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var student in Model)
                    {
                        var profile = student.WorkoutProfiles.FirstOrDefault();

                        <tr>

                            <td>
                                @student.Name @student.Surname
                            </td>

                            <td>
                                @student.StudentNumber
                            </td>

                            <td>
                                @student.Email
                            </td>

                            <td>
                                @if (profile != null)
                                {
                                    <span class="badge bg-success">
                                        Profile Available
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        No Profile
                                    </span>
                                }
                            </td>

                            <td>

                                <a asp-controller="Trainer"
                                   asp-action="ViewProfile"
                                   asp-route-id="@student.MemberId"
                                   class="btn btn-primary btn-sm">
                                    View Profile
                                </a>

                                <a asp-controller="Trainer"
                                   asp-action="CreateWorkout"
                                   asp-route-memberId="@student.MemberId"
                                   class="btn btn-success btn-sm">
                                    Assign Workout
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>
