@{
    ViewData["Title"] = "Trainer Dashboard";

    var pendingRequests = ViewBag.PendingRequests ?? 0;
    var activeRequest = ViewBag.ActiveRequest as DUT_Campus_FIT_Gym.Models.TrainerRequest;
    var currentBooking = ViewBag.CurrentBooking as DUT_Campus_FIT_Gym.Models.TrainerBooking;
    var student = activeRequest?.Student;
    var profile = ViewBag.StudentProfile;

    var sessionStatus = "Awaiting Booking";

    if (currentBooking != null)
    {
        if (DateTime.Now < currentBooking.StartTime)
        {
            sessionStatus = "Upcoming Session";
        }
        else if (DateTime.Now >= currentBooking.StartTime &&
                 DateTime.Now < currentBooking.EndTime)
        {
            sessionStatus = "Session In Progress";
        }
        else
        {
            sessionStatus = "Session Ended";
        }
}
}

<div class="trainer-dashboard">

    <div class="trainer-dashboard-header">

        <div>
            <span class="trainer-dashboard-label">
                DUT CAMPUS FIT GYM
            </span>

            <h1>
                Trainer Dashboard
            </h1>

            <p>
                Manage your students, workouts and gym equipment.
            </p>
        </div>

        <div class="trainer-dashboard-status">
            <span class="trainer-status-dot"></span>
            Trainer Portal
        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="trainer-alert trainer-alert-success">
            <i class="fa-solid fa-circle-check"></i>
            <span>@TempData["Success"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="trainer-alert trainer-alert-danger">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    <div class="trainer-stat-grid">

        <div class="trainer-stat-card">

            <div class="trainer-stat-icon equipment-icon">
                <i class="fa-solid fa-dumbbell"></i>
            </div>

            <div>
                <span class="trainer-stat-label">
                    EQUIPMENT
                </span>

                <h3>
                    Manage Equipment
                </h3>

                <p>
                    Gym equipment
                </p>
            </div>

        </div>

        <div class="trainer-stat-card">

            <div class="trainer-stat-icon workout-icon">
                <i class="fa-solid fa-clipboard-list"></i>
            </div>

            <div>
                <span class="trainer-stat-label">
                    WORKOUTS
                </span>

                <h3>
                    Workout Plans
                </h3>

                <p>
                    Student training plans
                </p>
            </div>

        </div>

        <div class="trainer-stat-card">

            <div class="trainer-stat-icon request-icon">
                <i class="fa-solid fa-user-clock"></i>
            </div>

            <div>
                <span class="trainer-stat-label">
                    REQUESTS
                </span>

                <h3>
                    @pendingRequests
                </h3>

                <p>
                    Pending trainer requests
                </p>
            </div>

        </div>

    </div>

    <div class="trainer-section-title">

        <div>
            <span>TRAINER TOOLS</span>
            <h2>Quick Actions</h2>
        </div>

    </div>

    <div class="trainer-tools-grid">

        <a asp-controller="Trainer"
           asp-action="Equipment"
           class="trainer-tool-card">

            <div class="trainer-tool-icon">
                <i class="fa-solid fa-dumbbell"></i>
            </div>

            <div class="trainer-tool-content">

                <h3>
                    Manage Equipment
                </h3>

                <p>
                    View, add and manage equipment available to gym members.
                </p>

            </div>

            <i class="fa-solid fa-arrow-right trainer-tool-arrow"></i>

        </a>

        <a asp-controller="Trainer"
           asp-action="Workouts"
           class="trainer-tool-card">

            <div class="trainer-tool-icon workout-tool-icon">
                <i class="fa-solid fa-clipboard-list"></i>
            </div>

            <div class="trainer-tool-content">

                <h3>
                    Manage Workouts
                </h3>

                <p>
                    Create and manage workout plans assigned to students.
                </p>

            </div>

            <i class="fa-solid fa-arrow-right trainer-tool-arrow"></i>

        </a>

        <a asp-controller="Trainer"
           asp-action="Requests"
           class="trainer-tool-card">

            <div class="trainer-tool-icon request-tool-icon">
                <i class="fa-solid fa-user-clock"></i>
            </div>

            <div class="trainer-tool-content">

                <h3>
                    Trainer Requests
                </h3>

                <p>
                    Review and respond to student training requests.
                </p>

                @if (pendingRequests > 0)
                {
                    <span class="trainer-pending-badge">
                        @pendingRequests pending request@(pendingRequests == 1 ? "" : "s")
                    </span>
                }

            </div>

            <i class="fa-solid fa-arrow-right trainer-tool-arrow"></i>

        </a>

        <a asp-controller="Trainer"
           asp-action="UpcomingSessions"
           class="trainer-tool-card">

            <div class="trainer-tool-icon">
                <i class="fa-solid fa-calendar-check"></i>
            </div>

            <div class="trainer-tool-content">

                <h3>
                    Upcoming Sessions
                </h3>

                <p>
                    View your scheduled training sessions with members.
                </p>

            </div>

            <i class="fa-solid fa-arrow-right trainer-tool-arrow"></i>

        </a>

        <a asp-controller="Trainer"
           asp-action="Exercises"
           class="trainer-tool-card">

            <div class="trainer-tool-icon">
                <i class="fa-solid fa-dumbbell"></i>
            </div>

            <div class="trainer-tool-content">

                <h3>
                    Exercise Library
                </h3>

                <p>
                    Manage exercises available for workout plans.
                </p>

            </div>

            <i class="fa-solid fa-arrow-right trainer-tool-arrow"></i>

        </a>

        <a asp-controller="Trainer"
           asp-action="Profile"
           class="trainer-tool-card">

            <div class="trainer-tool-icon profile-tool-icon">
                <i class="fa-solid fa-user-tie"></i>
            </div>

            <div class="trainer-tool-content">

                <h3>
                    My Trainer Profile
                </h3>

                <p>
                    Manage your trainer information and specialization.
                </p>

            </div>

            <i class="fa-solid fa-arrow-right trainer-tool-arrow"></i>

        </a>

        @if (student != null)
        {
            <a asp-controller="Trainer"
               asp-action="ViewProfile"
               asp-route-id="@student.MemberId"
               class="trainer-tool-card">

                <div class="trainer-tool-icon profile-tool-icon">
                    <i class="fa-solid fa-user"></i>
                </div>

                <div class="trainer-tool-content">

                    <h3>
                        Student Profile
                    </h3>

                    <p>
                        View the profile and training information of your assigned student.
                    </p>

                </div>

                <i class="fa-solid fa-arrow-right trainer-tool-arrow"></i>

            </a>
        }

    </div>

    <div class="trainer-section-title">

        <div>
            <span>STUDENT MANAGEMENT</span>
            <h2>Assigned Student</h2>
        </div>

    </div>

    @if (activeRequest != null && student != null)
    {
        <div class="active-student-section">

            <div class="active-student-header">

                <div>

                    <span class="active-student-label">
                        ASSIGNED TRAINER REQUEST
                    </span>

                    <h2>
                        Student Overview
                    </h2>

                </div>

                <div class="active-status">

                    @if (currentBooking == null)
                    {
                        <span class="active-dot"></span>
                        <span>Awaiting Booking</span>
                    }
                    else if (DateTime.Now < currentBooking.StartTime)
                    {
                        <span class="active-dot"></span>
                        <span>Upcoming Session</span>
                    }
                    else if (DateTime.Now >= currentBooking.StartTime &&
                             DateTime.Now < currentBooking.EndTime)
                    {
                        <span class="active-dot"></span>
                        <span>Session In Progress</span>
                    }
                    else
                    {
                        <span class="active-dot"></span>
                        <span>Session Ended</span>
                    }

                </div>

            </div>

            <div class="active-student-body">

                <div>

                    <div class="student-profile-main">

                        <div class="student-avatar">
                            <i class="fa-solid fa-user"></i>
                        </div>

                        <div>

                            <span class="student-small-label">
                                STUDENT
                            </span>

                            <h3>
                                @student.Name @student.Surname
                            </h3>

                            <p>
                                @student.Email
                            </p>

                        </div>

                    </div>

                    <div class="student-details">

                        <div class="student-detail">

                            <span>
                                STUDENT NUMBER
                            </span>

                            <strong>
                                @student.StudentNumber
                            </strong>

                        </div>

                        <div class="student-detail">

                            <span>
                                STATUS
                            </span>

                            <strong>
                                Trainer Assigned
                            </strong>

                        </div>

                    </div>

                </div>

                <div>

                    <div class="profile-section-heading">

                        <span>
                            TRAINING REQUEST
                        </span>

                        <h3>
                            Student's Request
                        </h3>

                    </div>

                    <div class="trainer-request-box">

                        <i class="fa-solid fa-quote-left"></i>

                        <p>
                            @activeRequest.RequestMessage
                        </p>

                    </div>

                </div>

            </div>

            <div class="active-student-divider"></div>

            <div class="profile-section">

                <div class="profile-section-heading">

                    <span>
                        TRAINING SESSION
                    </span>

                    <h3>
                        Session Details
                    </h3>

                </div>

                @if (currentBooking != null)
                {
                    <div class="fitness-grid">

                        <div class="fitness-item">

                            <span>
                                DATE
                            </span>

                            <strong>
                                @currentBooking.StartTime.ToString("dd MMM yyyy")
                            </strong>

                        </div>

                        <div class="fitness-item">

                            <span>
                                START TIME
                            </span>

                            <strong>
                                @currentBooking.StartTime.ToString("HH:mm")
                            </strong>

                        </div>

                        <div class="fitness-item">

                            <span>
                                END TIME
                            </span>

                            <strong>
                                @currentBooking.EndTime.ToString("HH:mm")
                            </strong>

                        </div>

                        <div class="fitness-item">

                            <span>
                                STATUS
                            </span>

                            <strong>
                                @sessionStatus
                            </strong>

                        </div>

                    </div>
                }
                else
                {
                    <div class="trainer-empty-profile">

                        <i class="fa-solid fa-calendar-clock"></i>

                        <div>

                            <strong>
                                No training session booked
                            </strong>

                            <p>
                                The student has been assigned to you but has not booked a training session yet.
                            </p>

                        </div>

                    </div>
                }

                <div class="active-student-actions">

                    <a asp-controller="Trainer"
                       asp-action="ViewProfile"
                       asp-route-id="@student.MemberId"
                       class="trainer-primary-button">

                        <i class="fa-solid fa-user"></i>

                        View Full Profile

                    </a>

                    <a asp-controller="Trainer"
                       asp-action="Requests"
                       class="trainer-secondary-button">

                        <i class="fa-solid fa-list"></i>

                        Manage Request

                    </a>

                    <a asp-controller="Trainer"
                       asp-action="UpcomingSessions"
                       class="trainer-secondary-button">

                        <i class="fa-solid fa-calendar-check"></i>

                        View Sessions

                    </a>

                </div>

            </div>

            <div class="active-student-divider"></div>

            <div class="profile-section">

                <div class="profile-section-heading">

                    <span>
                        FITNESS PROFILE
                    </span>

                    <h3>
                        Student Workout Profile
                    </h3>

                </div>

                @if (profile != null)
                {
                    <div class="fitness-grid">

                        <div class="fitness-item">

                            <span>
                                AGE
                            </span>

                            <strong>
                                @profile.Age
                            </strong>

                            <small>
                                years
                            </small>

                        </div>

                        <div class="fitness-item">

                            <span>
                                WEIGHT
                            </span>

                            <strong>
                                @profile.Weight
                            </strong>

                            <small>
                                kg
                            </small>

                        </div>

                        <div class="fitness-item">

                            <span>
                                HEIGHT
                            </span>

                            <strong>
                                @profile.Height
                            </strong>

                            <small>
                                cm
                            </small>

                        </div>

                        <div class="fitness-item">

                            <span>
                                FITNESS GOAL
                            </span>

                            <strong>
                                @profile.Goal
                            </strong>

                        </div>

                    </div>

                    <div class="active-student-actions">

                        <a asp-controller="Trainer"
                           asp-action="ViewProfile"
                           asp-route-id="@student.MemberId"
                           class="trainer-primary-button">

                            <i class="fa-solid fa-user"></i>

                            View Full Profile

                        </a>

                        <a asp-controller="Trainer"
                           asp-action="Requests"
                           class="trainer-secondary-button">

                            <i class="fa-solid fa-list"></i>

                            Manage Request

                        </a>

                    </div>

                }
                else
                {
                    <div class="trainer-empty-profile">

                        <i class="fa-solid fa-circle-info"></i>

                        <div>

                            <strong>
                                No workout profile available
                            </strong>

                            <p>
                                This student has not created a workout profile yet.
                            </p>

                        </div>

                    </div>

                    <div class="active-student-actions">

                        <a asp-controller="Trainer"
                           asp-action="Requests"
                           class="trainer-secondary-button">

                            <i class="fa-solid fa-list"></i>

                            Manage Request

                        </a>

                    </div>
                }

            </div>

        </div>
    }
    else
    {
        <div class="no-active-student">

            <div class="no-active-icon">
                <i class="fa-solid fa-user-clock"></i>
            </div>

            <div>

                <span>
                    NO ASSIGNED STUDENT
                </span>

                <h3>
                    No assigned student
                </h3>

                <p>
                    Student training requests will appear here when assigned.
                </p>

            </div>

            <a asp-controller="Trainer"
               asp-action="Requests"
               class="trainer-primary-button">

                <i class="fa-solid fa-list"></i>

                View Requests

            </a>

        </div>
    }

</div>

@section Styles {

    <link rel="stylesheet"
          href="~/css/trainer-dashboard.css"
          asp-append-version="true" />

}
