@{
    ViewData["Title"] = "Trainer Dashboard";
}

<div class="container mt-5">

    <!-- ====================================================== -->
    <!-- HEADER -->
    <!-- ====================================================== -->

    <div class="mb-4">

        <span class="text-muted">
            DUT CAMPUS FIT GYM
        </span>

        <h1 class="mb-2">
            Trainer Dashboard
        </h1>

        <p class="lead">
            Welcome to the Trainer Dashboard.
        </p>

    </div>


    <!-- ====================================================== -->
    <!-- SUCCESS MESSAGE -->
    <!-- ====================================================== -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }


    <!-- ====================================================== -->
    <!-- ERROR MESSAGE -->
    <!-- ====================================================== -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <!-- ====================================================== -->
    <!-- DASHBOARD OPTIONS -->
    <!-- ====================================================== -->

    <div class="row mt-4">


        <!-- ================================================== -->
        <!-- EQUIPMENT -->
        <!-- ================================================== -->

        <div class="col-md-4 mb-4">

            <div class="card shadow h-100">

                <div class="card-body">

                    <h4 class="card-title">
                        Manage Equipment
                    </h4>

                    <p class="card-text">
                        View, add and manage gym equipment.
                    </p>

                    <a asp-controller="Trainer"
                       asp-action="Equipment"
                       class="btn btn-primary">

                        Manage Equipment

                    </a>

                </div>

            </div>

        </div>


        <!-- ================================================== -->
        <!-- WORKOUTS -->
        <!-- ================================================== -->

        <div class="col-md-4 mb-4">

            <div class="card shadow h-100">

                <div class="card-body">

                    <h4 class="card-title">
                        Manage Workouts
                    </h4>

                    <p class="card-text">
                        View and manage workout plans assigned
                        to members.
                    </p>

                    <a asp-controller="Trainer"
                       asp-action="Workouts"
                       class="btn btn-warning">

                        Manage Workouts

                    </a>

                </div>

            </div>

        </div>


        <!-- ================================================== -->
        <!-- TRAINER REQUESTS -->
        <!-- ================================================== -->

        <div class="col-md-4 mb-4">

            <div class="card shadow h-100">

                <div class="card-body">

                    <h4 class="card-title">
                        Trainer Requests
                    </h4>

                    <p class="card-text">
                        View and respond to requests from students.
                    </p>


                    @if (ViewBag.PendingRequests != null &&
                                        ViewBag.PendingRequests > 0)
                    {
                        <span class="badge bg-danger mb-2">

                            @ViewBag.PendingRequests
                            pending request(s)

                        </span>
                    }

                    <br />


                    <a asp-controller="Trainer"
                       asp-action="Requests"
                       class="btn btn-info">

                        View Requests

                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- ====================================================== -->
    <!-- CURRENT ACTIVE STUDENT -->
    <!-- ====================================================== -->
    @if (ViewBag.ActiveRequest != null)
    {
        var student = ViewBag.ActiveRequest.Student;
        var profile = ViewBag.StudentProfile;
        var workoutPlans = ViewBag.StudentWorkoutPlans;


        <div class="card shadow mt-4 border-warning">


            <!-- ================================================== -->
            <!-- CARD HEADER -->
            <!-- ================================================== -->

            <div class="card-header bg-warning">

                <h4 class="mb-0">
                    Current Active Student
                </h4>

            </div>


            <!-- ================================================== -->
            <!-- CARD BODY -->
            <!-- ================================================== -->

            <div class="card-body">


                <!-- STUDENT NAME -->

                <p>

                    <strong>
                        Student:
                    </strong>

                    @student.Name @student.Surname

                </p>


                <!-- STUDENT NUMBER -->

                <p>

                    <strong>
                        Student Number:
                    </strong>

                    @student.StudentNumber

                </p>


                <!-- EMAIL -->

                <p>

                    <strong>
                        Email:
                    </strong>

                    @student.Email

                </p>


                <!-- REQUEST -->

                <p>

                    <strong>
                        Request:
                    </strong>

                    @ViewBag.ActiveRequest.RequestMessage

                </p>


                <!-- STATUS -->

                <p>

                    <strong>
                        Status:
                    </strong>

                    <span class="badge bg-success">
                        Active
                    </span>

                </p>


                <hr />


                <!-- ================================================== -->
                <!-- STUDENT WORKOUT PROFILE -->
                <!-- ================================================== -->

                <h5>
                    Student Workout Profile
                </h5>


                @if (profile != null)
                {
                    <div class="row">


                        <!-- AGE -->

                        <div class="col-md-3">

                            <strong>
                                Age
                            </strong>

                            <p>
                                @profile.Age
                            </p>

                        </div>


                        <!-- WEIGHT -->

                        <div class="col-md-3">

                            <strong>
                                Weight
                            </strong>

                            <p>
                                @profile.Weight kg
                            </p>

                        </div>


                        <!-- HEIGHT -->

                        <div class="col-md-3">

                            <strong>
                                Height
                            </strong>

                            <p>
                                @profile.Height cm
                            </p>

                        </div>


                        <!-- GOAL -->

                        <div class="col-md-3">

                            <strong>
                                Goal
                            </strong>

                            <p>
                                @profile.Goal
                            </p>

                        </div>

                    </div>


                    <!-- FULL PROFILE -->

                    <a asp-controller="Trainer"
                       asp-action="ViewProfile"
                       asp-route-id="@student.MemberId"
                       class="btn btn-primary me-2">

                        View Full Profile

                    </a>

                }
                else
                {

                    <div class="alert alert-info">

                        This student has not created a workout
                        profile yet.

                    </div>

                }


                <hr />


                <!-- MANAGE REQUEST -->

                <a asp-controller="Trainer"
                   asp-action="Requests"
                   class="btn btn-secondary">

                    Manage Current Request

                </a>

            </div>

        </div>

    }

</div>