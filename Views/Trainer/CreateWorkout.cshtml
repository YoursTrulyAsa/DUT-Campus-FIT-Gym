@model DUT_Campus_FIT_Gym.Models.WorkoutPlan

@{
    ViewData["Title"] = "Assign Workout";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow">

                <div class="card-header">
                    <h3 class="mb-0">
                        Assign Workout Plan
                    </h3>
                </div>

                <div class="card-body">

                    <form asp-controller="Trainer"
                          asp-action="CreateWorkout"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <!-- ========================================= -->
                        <!-- MEMBER -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label asp-for="MemberId"
                                   class="form-label">
                                Select Member
                            </label>

                            <select asp-for="MemberId"
                                    class="form-select">

                                <option value="">
                                    -- Select Member --
                                </option>

                                @if (ViewBag.Members != null)
                                {
                                    foreach (var member in ViewBag.Members)
                                    {
                                        <option value="@member.MemberId">

                                            @member.Name
                                            @member.Surname
                                            -
                                            @member.Email

                                        </option>
                                    }
                                }

                            </select>

                            <span asp-validation-for="MemberId"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- WORKOUT NAME -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label asp-for="WorkoutName"
                                   class="form-label">
                                Workout Name
                            </label>

                            <input asp-for="WorkoutName"
                                   class="form-control"
                                   placeholder="Example: Beginner Strength Plan" />

                            <span asp-validation-for="WorkoutName"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- EXERCISE -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label asp-for="ExerciseName"
                                   class="form-label">
                                Exercise Name
                            </label>

                            <input asp-for="ExerciseName"
                                   class="form-control"
                                   placeholder="Example: Squats" />

                            <span asp-validation-for="ExerciseName"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- WORKOUT DAY -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label asp-for="WorkoutDay"
                                   class="form-label">
                                Workout Day
                            </label>

                            <select asp-for="WorkoutDay"
                                    class="form-select">

                                <option value="">
                                    -- Select Day --
                                </option>

                                <option value="Monday">
                                    Monday
                                </option>

                                <option value="Tuesday">
                                    Tuesday
                                </option>

                                <option value="Wednesday">
                                    Wednesday
                                </option>

                                <option value="Thursday">
                                    Thursday
                                </option>

                                <option value="Friday">
                                    Friday
                                </option>

                                <option value="Saturday">
                                    Saturday
                                </option>

                                <option value="Sunday">
                                    Sunday
                                </option>

                            </select>

                            <span asp-validation-for="WorkoutDay"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- SETS -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label asp-for="Sets"
                                   class="form-label">
                                Sets
                            </label>

                            <input asp-for="Sets"
                                   type="number"
                                   class="form-control"
                                   min="1"
                                   max="100"
                                   placeholder="Example: 3" />

                            <span asp-validation-for="Sets"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- REPETITIONS -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label asp-for="Repetitions"
                                   class="form-label">
                                Repetitions
                            </label>

                            <input asp-for="Repetitions"
                                   type="number"
                                   class="form-control"
                                   min="1"
                                   max="500"
                                   placeholder="Example: 12" />

                            <span asp-validation-for="Repetitions"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- REST TIME -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label asp-for="RestTime"
                                   class="form-label">
                                Rest Time (seconds)
                            </label>

                            <input asp-for="RestTime"
                                   type="number"
                                   class="form-control"
                                   min="1"
                                   max="3600"
                                   placeholder="Example: 60" />

                            <span asp-validation-for="RestTime"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Enter the rest period in seconds.
                                Example: 60 = 1 minute.
                            </div>

                        </div>


                        <!-- ========================================= -->
                        <!-- DESCRIPTION -->
                        <!-- ========================================= -->

                        <div class="mb-3">

                            <label asp-for="Description"
                                   class="form-label">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Workout instructions..."></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ========================================= -->
                        <!-- BUTTONS -->
                        <!-- ========================================= -->

                        <div class="mt-4">

                            <button type="submit"
                                    class="btn btn-success">

                                <i class="fa-solid fa-plus"></i>
                                Assign Workout

                            </button>

                            <a asp-controller="Trainer"
                               asp-action="Workouts"
                               class="btn btn-secondary">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
