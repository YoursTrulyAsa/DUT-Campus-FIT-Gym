@model IEnumerable<DUT_Campus_FIT_Gym.Models.Exercise>

@{
    ViewData["Title"] = "Exercise Library";
}

<div class="trainer-page">

    <div class="trainer-page-header">

        <div>

            <span class="trainer-page-label">
                DUT CAMPUS FIT GYM
            </span>

            <h1>
                Exercise Library
            </h1>

            <p>
                Manage the exercises available when creating workout plans.
            </p>

        </div>

        <div class="trainer-header-actions">

            <a asp-controller="Trainer"
               asp-action="AddExercise"
               class="trainer-primary-btn">

                <i class="fa-solid fa-plus"></i>
                Add Exercise

            </a>

            <a asp-controller="Trainer"
               asp-action="Index"
               class="trainer-back-btn">

                <i class="fa-solid fa-arrow-left"></i>
                Dashboard

            </a>

        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="trainer-alert trainer-alert-success">

            <i class="fa-solid fa-circle-check"></i>

            <span>
                @TempData["Success"]
            </span>

        </div>
    }

    <div class="workouts-summary">

        <div class="workouts-summary-icon">

            <i class="fa-solid fa-dumbbell"></i>

        </div>

        <div>

            <span>
                TOTAL EXERCISES
            </span>

            <strong>
                @(Model?.Count() ?? 0)
            </strong>

        </div>

    </div>

    <div class="workouts-card">

        <div class="workouts-card-header">

            <div>

                <span class="trainer-section-label">
                    EXERCISE LIBRARY
                </span>

                <h2>
                    Available Exercises
                </h2>

            </div>

            <div class="workout-header-icon">

                <i class="fa-solid fa-list"></i>

            </div>

        </div>

        <div class="workouts-card-body">

            @if (Model == null || !Model.Any())
            {
                <div class="trainer-empty-state">

                    <div class="empty-icon">

                        <i class="fa-solid fa-dumbbell"></i>

                    </div>

                    <h3>
                        No Exercises
                    </h3>

                    <p>
                        No exercises have been added to the library yet.
                    </p>

                    <a asp-controller="Trainer"
                       asp-action="AddExercise"
                       class="trainer-primary-btn">

                        <i class="fa-solid fa-plus"></i>
                        Add First Exercise

                    </a>

                </div>
            }
            else
            {
                <div class="workout-list">

                    @foreach (var exercise in Model)
                    {
                        <div class="workout-card-item">

                            <div class="workout-item-top">

                                <div class="workout-item-icon">

                                    <i class="fa-solid fa-person-running"></i>

                                </div>

                                <div class="workout-item-title">

                                    <span class="trainer-section-label">
                                        @exercise.Category
                                    </span>

                                    <h3>
                                        @exercise.ExerciseName
                                    </h3>

                                </div>

                                <div class="workout-day-badge">

                                    @exercise.Difficulty

                                </div>

                            </div>

                            <div class="workout-item-details">

                                <div class="workout-member">

                                    <span>
                                        <i class="fa-solid fa-bullseye"></i>
                                        MUSCLE GROUP
                                    </span>

                                    <strong>
                                        @exercise.MuscleGroup
                                    </strong>

                                </div>

                                @if (!string.IsNullOrWhiteSpace(exercise.Description))
                                {
                                    <div class="workout-detail">

                                        <span>
                                            <i class="fa-solid fa-circle-info"></i>
                                            DESCRIPTION
                                        </span>

                                        <strong>
                                            @exercise.Description
                                        </strong>

                                    </div>
                                }

                            </div>

                            @if (!string.IsNullOrWhiteSpace(exercise.Instructions))
                            {
                                <div class="workout-description">

                                    <span>
                                        INSTRUCTIONS
                                    </span>

                                    <p>
                                        @exercise.Instructions
                                    </p>

                                </div>
                            }

                        </div>
                    }

                </div>
            }

        </div>

    </div>

</div>

@section Styles {

    <link rel="stylesheet"
          href="~/css/trainer.css"
          asp-append-version="true" />

}